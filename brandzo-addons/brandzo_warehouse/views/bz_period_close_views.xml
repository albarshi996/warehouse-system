<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- نموذج إغلاق الفترة المالية -->
    <record id="view_bz_period_close_form" model="ir.ui.view">
        <field name="name">bz.period.close.form</field>
        <field name="model">bz.period.close</field>
        <field name="arch" type="xml">
            <form string="إغلاق فترة مالية">
                <header>
                    <button name="action_close" type="object"
                            string="إغلاق الفترة المالية" class="btn-primary"
                            invisible="state != 'open'"
                            confirm="سيُقفل ترحيل القيود بتاريخٍ داخل هذه الفترة. متابعة الإغلاق؟"
                            groups="brandzo_warehouse.group_bz_finance_manager"/>
                    <button name="action_reopen" type="object"
                            string="إعادة فتح الفترة"
                            invisible="state != 'closed'"
                            confirm="ستُرفع حماية القفل عن هذه الفترة ويُستعاد القفل السابق. متابعة؟"
                            groups="brandzo_warehouse.group_bz_finance_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="مُغلقة"
                            bg_color="text-bg-success"
                            invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="نطاق الفترة">
                            <field name="date_from" readonly="state == 'closed'"/>
                            <field name="date_to" readonly="state == 'closed'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="blocker_count"/>
                            <field name="is_ready" invisible="1"/>
                        </group>
                        <group string="سجل الإغلاق" invisible="state != 'closed'">
                            <field name="closed_by_id"/>
                            <field name="closed_on"/>
                            <field name="lock_date_applied"/>
                        </group>
                    </group>
                    <group string="قائمة تحقّق الإغلاق">
                        <field name="checklist_html" nolabel="1"/>
                    </group>
                    <group string="ملاحظات">
                        <field name="note" nolabel="1"
                               placeholder="ملاحظات لجنة الإغلاق..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- قائمة أقفال الفترات -->
    <record id="view_bz_period_close_list" model="ir.ui.view">
        <field name="name">bz.period.close.list</field>
        <field name="model">bz.period.close</field>
        <field name="arch" type="xml">
            <list string="أقفال الفترات المالية"
                  decoration-success="state == 'closed'"
                  decoration-warning="state == 'open'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="blocker_count"/>
                <field name="closed_by_id"/>
                <field name="closed_on"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'open'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="action_bz_period_close" model="ir.actions.act_window">
        <field name="name">الإغلاق المالي الشهري</field>
        <field name="res_model">bz.period.close</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ إغلاق فترة مالية</p>
            <p>تُشتقّ قائمة تحقّق من مستندات الفترة الفعلية، ولا تُغلق الفترة
               وبنودها ناقصة. بعد الإغلاق يُمنع ترحيل أي قيد بتاريخ داخلها.</p>
        </field>
    </record>
</odoo>
