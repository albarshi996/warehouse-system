---
import ExecutiveReviewShell from './ExecutiveReviewShell.astro';
import { STATUS_BOARD, KPI_CARDS, ACHIEVEMENTS, OPEN_FILES, CHALLENGES, DECISIONS, AFTER_MEETING } from '../../data/executive-review/board.js';
import { UNIFIED_CHAIN, NO_DOC_NO_MOVE, HOLDING_ROLE, POLICIES, SUPPLIERS, EFFICIENCY, CYCLE_TEMPLATE } from '../../data/executive-review/model.js';
import { SITE_155, SITE_133 } from '../../data/executive-review/sites.js';
import { CATALOG, CATALOG_NOTE } from '../../data/executive-review/catalog.js';
import { SALES_CYCLE, SECTORS, SECTOR_QUESTIONS } from '../../data/executive-review/sectors.js';
import { GOVERNANCE_PRINCIPLE, OFFICE_RULES, OFFICES, EXCLUDED_OFFICES, GOVERNANCE_MATRIX_COLUMNS, GOVERNANCE_MATRIX } from '../../data/executive-review/governance.js';
import { DIGITAL_CAPABILITIES } from '../../data/executive-review/digitalCapabilities.js';

const { view = 'overview' } = Astro.props;
const titles = {
  overview: 'المنظور التنفيذي لسلاسل الإمداد', status: 'الحالة الحالية والإنجازات', model: 'النموذج التشغيلي الموحد',
  sites: 'المواقع والمخازن', catalog: 'كتالوج الاحتياجات', sectors: 'القطاعات ودورة المبيعات',
  governance: 'الحوكمة والمكاتب المساندة', digital: 'القدرات التشغيلية الرقمية الدائمة', decisions: 'القرارات والمتابعة بعد الاجتماع',
};
const title = titles[view] ?? titles.overview;
// `amber` هي حالة البيانات الفعلية في board.js — تُبقى `yellow` احتياطًا.
const stateLabel = { green: 'مستقر', amber: 'يحتاج متابعة', yellow: 'يحتاج متابعة', red: 'يتطلب تدخلًا', 'on-track': 'تقدم مستمر', 'at-risk': 'معرض للخطر', blocked: 'متوقف' };

// روابط وصور تسبقها `base` — البوابة تُنشر تحت `/warehouse-system`.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
const img155 = (src) => `${base}/executive-review/155/${src}`;
---

<ExecutiveReviewShell {title} active={view}>
  {view === 'overview' && <>
    <section class="hero-grid">
      <article class="hero-copy"><p class="eyebrow">قرار الإدارة العامة</p><h2>سلاسل الإمداد منظومة تخطيط وتحكم وتنفيذ وقياس، وليست مجرد إدارة مخازن.</h2><p>يعرض هذا المسار ما أُنجز، ما يحتاج قرارًا، ومن يملك التنفيذ والمتابعة والإغلاق.</p></article>
      <article class="decision-summary"><span>القرارات المطلوب اعتمادها</span><strong>{DECISIONS.length}</strong><p>قرارًا محددًا بمالك الاعتماد والأثر عند التأجيل.</p><a href={`${base}/dashboard/executive-review/decisions`}>فتح سجل القرارات ←</a></article>
    </section>
    <section class="section"><div class="section-head"><p>لوحة الحالة</p><h2>الصورة الفورية</h2></div><div class="status-grid">{STATUS_BOARD.map((item) => <article class:list={['status-card', item.status]}><i></i><h3>{item.label}</h3><p>{item.note}</p><small>{stateLabel[item.status]}</small></article>)}</div></section>
    <section class="kpi-grid">{KPI_CARDS.map((item) => <article><strong>{item.value}</strong><span>{item.label}</span><small>{item.hint}</small></article>)}</section>
    <section class="section two"><article class="panel"><p class="eyebrow">القاعدة الحاكمة</p><h2>لا مستند = لا حركة</h2><p>كل احتياج يمر بطلب ومراجعة واعتماد وتخطيط وتنفيذ وتوثيق ومطابقة وإغلاق قابل للقياس.</p><a href={`${base}/dashboard/executive-review/model`}>عرض النموذج التشغيلي ←</a></article><article class="panel accent"><p class="eyebrow">المواقع</p><h2>تحوير وتجهيز تشغيلي للمخازن</h2><p>ملف 155 يعرض السعة المتاحة وخطة التحوير والأولويات التنفيذية؛ لا يتضمن طلب ميزانية صيانة.</p><a href={`${base}/dashboard/executive-review/sites`}>عرض المواقع والمخازن ←</a></article></section>
  </>}

  {view === 'status' && <>
    <section class="section"><div class="section-head"><p>الإنجازات</p><h2>ما تم بناؤه وتشغيله</h2></div><div class="card-grid">{ACHIEVEMENTS.map((item) => <article class="detail-card"><h3>{item.title}</h3><p>{item.done}</p><div><b>النتيجة:</b> {item.result}</div><div><b>القيمة:</b> {item.value}</div></article>)}</div></section>
    <section class="section"><div class="section-head"><p>الملفات المفتوحة</p><h2>الحالة والخطوة التالية</h2></div><div class="table-wrap"><table><thead><tr><th>الملف</th><th>الحالة</th><th>الوضع</th><th>الخطوة التالية</th></tr></thead><tbody>{OPEN_FILES.map((item) => <tr><td>{item.name}</td><td><span class:list={['pill', item.state]}>{item.stateLabel}</span></td><td>{item.detail}</td><td>{item.next}</td></tr>)}</tbody></table></div></section>
    <section class="section"><div class="section-head"><p>التحديات</p><h2>المخاطر التي تحتاج تدخلاً</h2></div><div class="card-grid">{CHALLENGES.map((item) => <article class:list={['risk-card', item.kind]}><h3>{item.title}</h3><p>{item.detail}</p><b>المطلوب: {item.need}</b></article>)}</div></section>
  </>}

  {view === 'model' && <>
    <section class="section"><div class="section-head"><p>One Supply Chain Operating Model</p><h2>الدورة الموحدة</h2></div><ol class="chain">{UNIFIED_CHAIN.map((item, index) => <li><span>{index + 1}</span>{item}</li>)}</ol></section>
    <section class="section two"><article class="panel"><p class="eyebrow">دور الشركة القابضة</p><h2 class="statement">{HOLDING_ROLE.statement}</h2><ul>{HOLDING_ROLE.functions.map((item) => <li><b>{item.name}:</b> {item.role}</li>)}</ul><small class="foot">لكل وظيفة: {HOLDING_ROLE.perFunction.join(' · ')}</small></article><article class="panel accent"><p class="eyebrow">ضابط البوابة</p><h2>لا مستند = لا حركة</h2><ul>{NO_DOC_NO_MOVE.map((item) => <li><b>{item.rule}</b><br />{item.how}</li>)}</ul></article></section>
    <section class="section"><div class="section-head"><p>السياسات</p><h2>خمس سياسات تشغيلية</h2></div><div class="card-grid">{POLICIES.map((item) => <article class="detail-card"><h3>{item.name}</h3><p>{item.scope}</p><p><b>الدورة:</b> {item.cycle.join(' ← ')}</p><small>{item.kpi}</small></article>)}</div></section>
    <section class="section two"><article class="panel"><p class="eyebrow">الموردون وعمليات الشراء</p><h2 class="statement">{SUPPLIERS.role}</h2><div class="table-wrap"><table><thead><tr><th>الحلقة</th><th>المسؤول</th><th>المستند/المخرج</th></tr></thead><tbody>{SUPPLIERS.cycle.map((item) => <tr><td><b>{item.step}</b></td><td>{item.who}</td><td>{item.doc}</td></tr>)}</tbody></table></div><small class="foot">{SUPPLIERS.evaluation}</small></article><article class="panel"><p class="eyebrow">روافع الكفاءة</p><h2>تطوير قابل للقياس</h2><ul>{EFFICIENCY.map((item) => <li><b>{item.lever}:</b> {item.how}</li>)}</ul></article></section>
    <section class="section"><div class="section-head"><p>قالب الدورة</p><h2>أي وظيفة تُبنى كدورة مكتملة</h2></div><div class="template-grid">{CYCLE_TEMPLATE.map((item) => <article><b>{item.field}</b><span>{item.hint}</span></article>)}</div></section>
  </>}

  {view === 'sites' && <>
    <section class="section two"><article class="site-card"><p class="eyebrow">{SITE_155.code}</p><h2>{SITE_155.name}</h2><p>{SITE_155.headline}</p><div class="identity">{SITE_155.identity.map((item) => <div><b>{item.k}</b><span>{item.v}</span></div>)}</div></article><article class="site-card"><p class="eyebrow">{SITE_133.code}</p><h2>{SITE_133.name}</h2><p>{SITE_133.headline}</p><div class="identity">{SITE_133.identity.map((item) => <div><b>{item.k}</b><span>{item.v}</span></div>)}</div></article></section>
    <section class="section"><div class="section-head"><p>موقع 155</p><h2>المخطط التنفيذي للتحوير والتجهيز</h2><span class="note">هذا عرض لأولويات التنفيذ والتخصيص، وليس طلب ميزانية صيانة.</span></div><p class="lead">{SITE_155.occupancySummary}</p><div class="occupancy">{SITE_155.occupancy.map((item) => <article><header><b>{item.id}</b><span>{item.area.toLocaleString()} م²</span></header><div class="bar"><i style={`width:${item.used}%`}></i></div><p>{item.used}% مشغول</p><small>{item.holder}</small></article>)}</div></section>
    <section class="section"><div class="section-head"><p>المخططات والصور</p><h2>الموقع كما صممه المهندسون وكما هو اليوم</h2><span class="note">المخططات من ملفات NAS-8155-ARC والصور من الجرد الميداني — للشرح الإداري؛ الأعمال الهندسية محالة للفريق المختص.</span></div><div class="gallery">{SITE_155.images.map((item) => <figure><img src={img155(item.src)} alt={item.caption} loading="lazy" /><figcaption>{item.caption}</figcaption></figure>)}</div></section>
    <section class="section two"><article class="panel"><p class="eyebrow">مبنى التبريد والتجميد</p><h2 class="statement">{SITE_155.cooling.summary}</h2><div class="rooms">{SITE_155.cooling.rooms.map((item) => <div><b>{item.room}</b><span>{item.spec}</span></div>)}</div></article><article class="panel"><p class="eyebrow">أنماط المخازن الجافة</p><h2>ثلاثة أنماط تخزين</h2><div class="rooms">{SITE_155.storeTypes.map((item) => <div><b>{item.type}</b><span>{item.count} · {item.unit}</span></div>)}</div><small class="foot">{SITE_155.reportStatus}</small></article></section>
    <section class="section"><div class="section-head"><p>مراحل التنفيذ</p><h2>الأولويات التشغيلية للمخازن</h2></div><div class="card-grid">{SITE_155.requirements.map((item, index) => <article class="detail-card"><span class="number">{index + 1}</span><h3>{item.family}</h3><p>{item.items}</p></article>)}</div></section>
    <section class="section two"><article class="panel"><p class="eyebrow">التحديات المفتوحة — 155</p><ul>{SITE_155.challenges.map((item) => <li>{item}</li>)}</ul></article><article class="panel accent"><p class="eyebrow">قرارات مطلوبة — 155</p><ul>{SITE_155.decisions.map((item) => <li>{item}</li>)}</ul></article></section>
    <section class="section two"><article class="panel"><p class="eyebrow">الرحبة 133 — الوضع التشغيلي</p><h2>الغرف 1–19 لشركة نوفا (كوزمتيك)</h2><ul>{SITE_133.operations.map((item) => <li>{item}</li>)}</ul></article><article class="panel accent"><p class="eyebrow">الرحبة 133 — الاحتياجات والقرارات</p><ul>{SITE_133.needs.map((item) => <li>{item}</li>)}</ul><h3>قرارات مطلوبة</h3><ul>{SITE_133.decisions.map((item) => <li>{item}</li>)}</ul></article></section>
  </>}

  {view === 'catalog' && <>
    <section class="section"><div class="section-head"><p>الاحتياجات</p><h2>كتالوج الاحتياجات التشغيلي</h2></div><p class="lead">{CATALOG_NOTE}</p>{CATALOG.map((group) => <article class="catalog"><header><h3>{group.section}</h3><p>{group.intro}</p></header><div class="table-wrap"><table><thead><tr><th>الاحتياج</th><th>الأولوية</th><th>الغرض التشغيلي</th><th>الكمية والموقع</th><th>الحالة</th></tr></thead><tbody>{group.items.map((item) => <tr><td><b>{item.need}</b><br /><small>{item.role}</small></td><td><span class:list={['priority', item.priority?.toLowerCase()]}>{item.priority}</span></td><td>{item.purpose}<br /><small>{item.reason}</small></td><td>{item.qty}<br /><small>{item.site}</small></td><td>{item.status}<br /><small>الاعتماد: {item.approval}</small><br /><small>التوفير: {item.supply}</small></td></tr>)}</tbody></table></div></article>)}</section>
  </>}

  {view === 'sectors' && <>
    <section class="section"><div class="section-head"><p>إدارة المبيعات · قطاع التوزيع · تنسيق العمليات</p><h2>{SALES_CYCLE.status}</h2></div><p class="lead">{SALES_CYCLE.goal}</p><ol class="chain">{SALES_CYCLE.chain.map((item) => <li title={item.role}><span>{item.code}</span>{item.name}</li>)}</ol><div class="table-wrap"><table><thead><tr><th>المستند</th><th>دوره في الدورة</th><th>مقابله في أودو</th></tr></thead><tbody>{SALES_CYCLE.chain.map((item) => <tr><td><b>{item.code}</b> · {item.name}</td><td>{item.role}</td><td>{item.odoo}</td></tr>)}</tbody></table></div></section>
    <section class="section"><div class="section-head"><p>العلاقة بين الأطراف</p><h2>من المبيعات حتى أودو — Workflow واحد</h2></div><div class="template-grid">{SALES_CYCLE.parties.map((item) => <article><b>{item.party}</b><span>{item.link}</span></article>)}</div></section>
    <section class="section two"><article class="panel"><p class="eyebrow">مكونات المنظومة الست</p><ul>{SALES_CYCLE.components.map((item) => <li>{item}</li>)}</ul></article><article class="panel accent"><p class="eyebrow">البعد الاستثماري</p><p class="statement">{SALES_CYCLE.investment}</p></article></section>
    <section class="section"><div class="section-head"><p>مراحل التنفيذ</p><h2>أربع مراحل بعد اعتماد الجدولة</h2></div><div class="card-grid four">{SALES_CYCLE.phases.map((item) => <article class="detail-card"><h3>{item.phase}</h3><p>{item.scope}</p><small>{item.out}</small></article>)}</div></section>
    <section class="section"><div class="section-head"><p>القطاعات</p><h2>خمسة قطاعات متصلة بسلاسل الإمداد</h2></div><div class="card-grid">{SECTORS.map((item) => <article class="detail-card"><span class:list={['pill', item.status]}>{item.statusLabel}</span><h3>{item.name}</h3><p>{item.model}</p><ul>{item.facts.map((fact) => <li>{fact}</li>)}</ul>{item.cycle.length > 0 && <ol class="mini-cycle">{item.cycle.map((step) => <li>{step}</li>)}</ol>}{item.kpis && <p><b>المؤشرات:</b> {item.kpis}</p>}<small>{item.pending}</small></article>)}</div></section>
    <section class="section"><div class="section-head"><p>أسئلة القرار</p><h2>قبل بناء أي دورة قطاعية</h2></div><div class="template-grid">{SECTOR_QUESTIONS.map((question, index) => <article><b>{index + 1}</b><span>{question}</span></article>)}</div></section>
  </>}

  {view === 'governance' && <>
    <section class="section"><div class="section-head"><p>المبدأ الحاكم</p><h2>{GOVERNANCE_PRINCIPLE.headline}</h2></div><div class="template-grid">{GOVERNANCE_PRINCIPLE.separations.map((item) => <article><b>{item.k}</b><span>{item.v}</span></article>)}</div></section>
    <section class="section"><div class="section-head"><p>المكاتب المساندة</p><h2>حدود الاختصاص والتوجيه</h2></div><div class="card-grid">{OFFICES.map((office) => <article class="detail-card"><h3>{office.name}</h3><p><b>التبعية:</b> {office.parent}</p><p>{office.scRole}</p><p><b>المهام:</b> {office.tasks.join(' · ')}</p><small>{office.conflictGuard}</small></article>)}</div><p class="exclusions"><b>مستثنى من نموذج المكاتب التشغيلية:</b> {EXCLUDED_OFFICES.join(' · ')}</p></section>
    <section class="section"><div class="section-head"><p>مصفوفة الحوكمة</p><h2>من يطلب، من ينفذ، ومن يغلق</h2></div><div class="table-wrap"><table class="wide"><thead><tr>{GOVERNANCE_MATRIX_COLUMNS.map((column) => <th>{column}</th>)}</tr></thead><tbody>{GOVERNANCE_MATRIX.map((row) => <tr><td>{row.dept}</td><td>{row.parent}</td><td>{row.needFrom}</td><td>{row.requests}</td><td>{row.directs}</td><td>{row.executes}</td><td>{row.approves}</td><td>{row.escalates}</td><td>{row.audits}</td><td>{row.follows}</td><td>{row.closes}</td><td>{row.where}</td></tr>)}</tbody></table></div></section>
    <section class="section"><div class="section-head"><p>القواعد العامة</p><h2>ضوابط العمل داخل المواقع</h2></div><ol class="rules">{OFFICE_RULES.map((rule) => <li>{rule}</li>)}</ol></section>
  </>}

  {view === 'digital' && <>
    <section class="hero-grid"><article class="hero-copy"><p class="eyebrow">اعتماد تشغيلي</p><h2>{DIGITAL_CAPABILITIES.subtitle}</h2><p>{DIGITAL_CAPABILITIES.principle}</p></article><article class="decision-summary"><span>{DIGITAL_CAPABILITIES.classification}</span><strong>$400</strong><p>تكلفة تشغيلية رقمية ثابتة شهريًا للنموذجين.</p><a href="#digital-decision">عرض قرار الاعتماد ←</a></article></section>
    <section class="kpi-grid">{DIGITAL_CAPABILITIES.financials.map((item) => <article><strong>{item.value}</strong><span>{item.label}</span></article>)}</section>
    <section class="section"><div class="section-head"><p>القيمة الإنتاجية</p><h2>أين تعمل القدرات الرقمية</h2></div><div class="card-grid">{DIGITAL_CAPABILITIES.outcomes.map((item) => <article class="detail-card"><h3>{item.title}</h3><p>{item.detail}</p></article>)}</div></section>
    <section class="section two"><article class="panel"><p class="eyebrow">Claude</p><h2>{DIGITAL_CAPABILITIES.models[0].role}</h2><ul>{DIGITAL_CAPABILITIES.models[0].outputs.map((item) => <li>{item}</li>)}</ul></article><article class="panel accent"><p class="eyebrow">Codex</p><h2>{DIGITAL_CAPABILITIES.models[1].role}</h2><ul>{DIGITAL_CAPABILITIES.models[1].outputs.map((item) => <li>{item}</li>)}</ul></article></section>
    <section class="section"><div class="section-head"><p>ضوابط الاعتماد</p><h2>استمرارية دون تجاوز للصلاحيات</h2></div><ol class="rules">{DIGITAL_CAPABILITIES.controls.map((item) => <li>{item}</li>)}</ol></section>
    <section id="digital-decision" class="decision-card"><p>قرار مطلوب</p><h2>{DIGITAL_CAPABILITIES.decision.title}</h2><b>{DIGITAL_CAPABILITIES.decision.ask}</b><div><span><strong>عند الاعتماد:</strong> {DIGITAL_CAPABILITIES.decision.ifYes}</span><span><strong>عند التأجيل:</strong> {DIGITAL_CAPABILITIES.decision.ifNo}</span></div><small>مالك القرار: {DIGITAL_CAPABILITIES.decision.owner}</small></section>
  </>}

  {view === 'decisions' && <>
    <section class="section"><div class="section-head"><p>القرارات المطلوبة من المدير العام</p><h2>{DECISIONS.length} قرارات لحسم المسار</h2></div><div class="decision-grid">{DECISIONS.map((item, index) => <article><span>{index + 1}</span><h3>{item.title}</h3><p><b>المطلوب:</b> {item.ask}</p><p class="yes"><b>عند الاعتماد:</b> {item.ifYes}</p><p class="no"><b>عند التأجيل:</b> {item.ifNo}</p><small>{item.owner}<br />{item.parties}<br />{item.due}</small></article>)}</div></section>
    <section class="section"><div class="section-head"><p>ما بعد الاجتماع</p><h2>التنفيذ والمتابعة والإغلاق</h2></div><div class="table-wrap"><table><thead><tr><th>المالك</th><th>الإجراء</th><th>الجهات</th><th>الموعد</th><th>المتابعة</th><th>مخرج الإغلاق</th></tr></thead><tbody>{AFTER_MEETING.map((item) => <tr><td>{item.owner}</td><td>{item.action}</td><td>{item.party}</td><td>{item.due}</td><td>{item.follow}</td><td>{item.close}</td></tr>)}</tbody></table></div></section>
  </>}
</ExecutiveReviewShell>

<style>
