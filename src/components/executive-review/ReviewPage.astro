---
/**
 * شاشة مفردة من غرفة القرار = الغلاف + أقسام شاشتها.
 * المحتوى كله في `ReviewSections` (يُشارَك مع «العرض الكامل»).
 */
import ExecutiveReviewShell from './ExecutiveReviewShell.astro';
import ReviewSections from './ReviewSections.astro';

const { view = 'overview' } = Astro.props;
const titles = {
  overview: 'المنظور التنفيذي لسلاسل الإمداد', status: 'الحالة الحالية والإنجازات', model: 'النموذج التشغيلي الموحد',
  sites: 'المواقع والمخازن', catalog: 'كتالوج الاحتياجات', sectors: 'القطاعات ودورة المبيعات',
  governance: 'الحوكمة والمكاتب المساندة', digital: 'القدرات التشغيلية الرقمية الدائمة', decisions: 'القرارات والمتابعة بعد الاجتماع',
};
const title = titles[view] ?? titles.overview;
---

<ExecutiveReviewShell {title} active={view}>
  <ReviewSections {view} />
</ExecutiveReviewShell>
