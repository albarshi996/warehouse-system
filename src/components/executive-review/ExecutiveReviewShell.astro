---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import MeetingRecorderDock from './MeetingRecorderDock.jsx';
import { NAV_GROUPS, PINNED_ITEM } from '../../services/auth/navCatalog.js';

/**
 * غلاف «غرفة قرار سلاسل الإمداد» — التبويبات التسعة + شريط أدوات الاجتماع.
 *
 * الهوية = توكِنز البوابة الفاتحة `bz-light` نفسها (ملاحظة المالك 2026-08-07:
 * لا لوحة ألوان خاصة): الأسطح والحبر والتمييز من متغيرات `global.css`.
 * أداتا الاجتماع: «وضع العرض» يحوّل أقسام الشاشة لشرائح ملء الشاشة
 * (زر الرجوع يُغلقه عبر `trackOverlay` — قاعدة الطبقات الدائمة)،
 * و«تسجيل الاجتماع» يعيد استخدام خطاف مساعد الاجتماعات.
 */
const { title, active } = Astro.props;

// روابط داخلية تسبقها `base` — البوابة تُنشر تحت `/warehouse-system`.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const views = [
  ['overview', 'المنظور التنفيذي', `${base}/dashboard/executive-review`],
  ['status', 'الحالة والإنجاز', `${base}/dashboard/executive-review/status`],
  ['model', 'النموذج التشغيلي', `${base}/dashboard/executive-review/model`],
  ['sites', 'المواقع والمخازن', `${base}/dashboard/executive-review/sites`],
  ['catalog', 'كتالوج الاحتياجات', `${base}/dashboard/executive-review/catalog`],
  ['sectors', 'القطاعات والمبيعات', `${base}/dashboard/executive-review/sectors`],
  ['governance', 'الحوكمة والمكاتب', `${base}/dashboard/executive-review/governance`],
  ['digital', 'القدرات الرقمية', `${base}/dashboard/executive-review/digital-capabilities`],
  ['decisions', 'القرارات والمتابعة', `${base}/dashboard/executive-review/decisions`],
];
---

<DashboardLayout title={title} light>
  <main class="review" id="reviewRoot" dir="rtl">
    <header class="review-head">
      <div>
        <p>إدارة سلاسل الإمداد · غرفة قرار الإدارة العامة</p>
        <h1>{title}</h1>
      </div>
      <div class="review-tools">
        <MeetingRecorderDock client:load />
        <button type="button" id="presentBtn" class="present-btn" title="عرض تنفيذي ملء الشاشة — شريحة لكل قسم">
          وضع العرض
        </button>
      </div>
    </header>

    <nav class="review-nav" aria-label="أقسام العرض التنفيذي">
      {views.map(([key, label, href]) => (
        <a class:list={{ active: key === active }} href={href}>{label}</a>
      ))}
    </nav>

    <slot />

    {/* شريط تحكم وضع العرض — يظهر فقط أثناء التقديم */}
    <div class="present-bar" id="presentBar" aria-hidden="true">
      <span class="present-right">
        <button type="button" id="presentExit">إنهاء العرض</button>
        <button type="button" id="portalOpenBtn" class="portal-open-btn" title="افتح أي صفحة من البوابة فوق العرض — دون الخروج منه">فتح من البوابة</button>
      </span>
      <span class="present-title">{title}</span>
      <span class="present-ctl">
        <button type="button" id="presentPrev" title="الشريحة السابقة">السابق</button>
        <b id="presentCounter">1 / 1</b>
        <button type="button" id="presentNext" title="الشريحة التالية">التالي</button>
      </span>
    </div>

    {/* لوحة الانتقال السريع — كل صفحات البوابة من كتالوج القائمة الواحد */}
    <div class="portal-palette" id="portalPalette" aria-hidden="true">
      <div class="pp-box" role="dialog" aria-label="فتح صفحة من البوابة">
        <header>
          <input id="ppSearch" type="search" placeholder="ابحث في صفحات البوابة…" autocomplete="off" />
          <button type="button" id="ppClose">إغلاق</button>
        </header>
        <div class="pp-list" id="ppList">
          <div class="pp-group">
            <p>عام</p>
            <div class="pp-items">
              <button type="button" class="pp-item" data-path={`${base}${PINNED_ITEM.path}`} data-label={PINNED_ITEM.label}>{PINNED_ITEM.label}</button>
            </div>
          </div>
          {NAV_GROUPS.map((group) => (
            <div class="pp-group">
              <p>{group.group}</p>
              <div class="pp-items">
                {group.items.map((item) => (
                  <button type="button" class="pp-item" data-path={`${base}${item.path}`} data-label={item.label}>{item.label}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* طبقة التصفح الحي — الصفحة المختارة تفتح فوق العرض ولا تُغادره */}
    <div class="portal-layer" id="portalLayer" aria-hidden="true">
      <header>
        <button type="button" id="plClose">رجوع للعرض</button>
        <span id="plTitle"></span>
        <a id="plNewTab" href="#" target="_blank" rel="noopener">فتح في تبويب مستقل</a>
      </header>
      <iframe id="portalFrame" title="صفحة من البوابة" src="about:blank"></iframe>
    </div>
  </main>
</DashboardLayout>

<script>
  import { trackOverlay } from '../../services/ui/overlayHistory.js';

  const root = document.getElementById('reviewRoot');
  const bar = document.getElementById('presentBar');
  const counter = document.getElementById('presentCounter');
  /** شرائح العرض = الأقسام المباشرة للشاشة الحالية. */
  const slides = Array.from(root?.querySelectorAll(':scope > section') || []);
  let current = 0;

  function paint() {
    slides.forEach((s, i) => s.classList.toggle('er-current', i === current));
    if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    const shown = slides[current];
    if (shown) shown.scrollTop = 0;
  }

  function enter() {
    if (!slides.length) return;
    current = 0;
    root.classList.add('presenting');
    bar?.setAttribute('aria-hidden', 'false');
    paint();
  }

  function exit() {
    root.classList.remove('presenting');
    bar?.setAttribute('aria-hidden', 'true');
    slides.forEach((s) => s.classList.remove('er-current'));
  }

  function step(delta) {
    current = Math.min(slides.length - 1, Math.max(0, current + delta));
    paint();
  }

  document.getElementById('presentBtn')?.addEventListener('click', enter);
  document.getElementById('presentExit')?.addEventListener('click', exit);
  // بالعربية (RTL) التقدم بصريًّا نحو اليسار: يسار = التالي، يمين = السابق.
  document.getElementById('presentNext')?.addEventListener('click', () => step(1));
  document.getElementById('presentPrev')?.addEventListener('click', () => step(-1));

  /* ─── الوصول لكافة البوابة دون الخروج من العرض ───
     لوحة انتقال (كتالوج القائمة الواحد) ← الصفحة تفتح حية في طبقة iframe
     فوق الشرائح؛ إغلاقها يعيدك لنفس الشريحة والتسجيل الصوتي لا ينقطع. */
  const palette = document.getElementById('portalPalette');
  const ppSearch = document.getElementById('ppSearch');
  const layer = document.getElementById('portalLayer');
  const frame = document.getElementById('portalFrame');
  const plTitle = document.getElementById('plTitle');
  const plNewTab = document.getElementById('plNewTab');

  function openPalette() {
    palette?.classList.add('open');
    palette?.setAttribute('aria-hidden', 'false');
    setTimeout(() => ppSearch?.focus(), 60);
  }
  function closePalette() {
    palette?.classList.remove('open');
    palette?.setAttribute('aria-hidden', 'true');
  }
  function openPortalPage(path, label) {
    if (!frame) return;
    frame.src = path;
    if (plTitle) plTitle.textContent = label;
    if (plNewTab) plNewTab.href = path;
    closePalette();
    layer?.classList.add('open');
    layer?.setAttribute('aria-hidden', 'false');
  }
  function closeLayer() {
    layer?.classList.remove('open');
    layer?.setAttribute('aria-hidden', 'true');
    // تفريغ الإطار يوقف أي صوت/تحديث حي في الصفحة المفتوحة خلفيًّا.
    if (frame) frame.src = 'about:blank';
  }

  document.getElementById('portalOpenBtn')?.addEventListener('click', openPalette);
  document.getElementById('ppClose')?.addEventListener('click', closePalette);
  palette?.addEventListener('click', (ev) => { if (ev.target === palette) closePalette(); });
  document.getElementById('plClose')?.addEventListener('click', closeLayer);

  document.querySelectorAll('.pp-item').forEach((btn) => {
    btn.addEventListener('click', () => openPortalPage(btn.dataset.path, btn.dataset.label));
  });

  // بحث اللوحة: يخفي ما لا يطابق، ويطوي المجموعات الفارغة.
  ppSearch?.addEventListener('input', () => {
    const q = ppSearch.value.trim();
    document.querySelectorAll('#ppList .pp-group').forEach((groupEl) => {
      let visible = 0;
      groupEl.querySelectorAll('.pp-item').forEach((item) => {
        const hit = !q || item.dataset.label.includes(q);
        item.style.display = hit ? '' : 'none';
        if (hit) visible += 1;
      });
      groupEl.style.display = visible ? '' : 'none';
    });
  });

  document.addEventListener('keydown', (ev) => {
    // أولوية الإغلاق من الأعلى للأسفل: طبقة التصفح ← اللوحة ← العرض نفسه.
    if (layer?.classList.contains('open')) {
      if (ev.key === 'Escape') closeLayer();
      return;
    }
    if (palette?.classList.contains('open')) {
      if (ev.key === 'Escape') closePalette();
      return;
    }
    if (!root?.classList.contains('presenting')) return;
    if (ev.key === 'ArrowLeft' || ev.key === 'PageDown' || ev.key === ' ') { ev.preventDefault(); step(1); }
    else if (ev.key === 'ArrowRight' || ev.key === 'PageUp') { ev.preventDefault(); step(-1); }
    else if (ev.key === 'Escape') exit();
  });

  // قاعدة الطبقات الدائمة: أي طبقة تملأ الشاشة يُغلقها زر الرجوع —
  // وتتراكم: رجوعٌ يغلق التصفح، فرجوعٌ يغلق اللوحة، فرجوعٌ يُنهي العرض.
  if (root) trackOverlay(root, { className: 'presenting', name: 'executive-presentation' });
  if (palette) trackOverlay(palette, { className: 'open', name: 'portal-palette' });
  if (layer) trackOverlay(layer, { className: 'open', name: 'portal-browse', close: () => closeLayer() });
</script>

<style is:global>
  /* ═══ غلاف غرفة القرار — توكِنز البوابة الفاتحة حصرًا ═══ */
  .review{max-width:1480px;margin:0 auto;padding:24px clamp(14px,3vw,44px) 64px;color:var(--color-ink)}
  .review-head{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;background:var(--color-surface);border:1px solid var(--color-line);border-radius:var(--radius-card);box-shadow:var(--shadow-card);padding:20px 24px}
  .review-head p{margin:0 0 8px;color:var(--color-accent);font-size:12px;font-weight:800;letter-spacing:.01em}
  .review-head h1{margin:0;font-size:clamp(22px,2.6vw,34px);line-height:1.3;color:var(--color-ink)}
  .review-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .present-btn{border:1px solid var(--color-accent);background:var(--color-accent);color:#fff;border-radius:var(--radius-chip);padding:9px 16px;font-size:12.5px;font-weight:800;cursor:pointer;transition:opacity .15s}
  .present-btn:hover{opacity:.88}
  .review-nav{display:flex;gap:8px;overflow-x:auto;padding:14px 0 6px;scrollbar-width:thin}
  .review-nav a{white-space:nowrap;text-decoration:none;color:var(--color-ink-2);background:var(--color-surface);border:1px solid var(--color-line-strong);border-radius:var(--radius-chip);padding:8px 13px;font-size:12px;font-weight:800;transition:all .15s}
  .review-nav a:hover{border-color:var(--color-accent);color:var(--color-accent)}
  .review-nav a.active{color:#fff;background:var(--color-accent);border-color:var(--color-accent)}

  /* ═══ مسجّل الاجتماع ═══ */
  .er-recorder{display:flex;align-items:center;gap:8px;font-size:12px}
  .er-recorder button{border:1px solid var(--color-line-strong);background:var(--color-surface);color:var(--color-ink);border-radius:var(--radius-chip);padding:8px 13px;font-size:12px;font-weight:800;cursor:pointer}
  .er-recorder button:hover{border-color:var(--color-accent);color:var(--color-accent)}
  .er-rec-btn,.er-rec-live,.er-rec-done{display:inline-flex;align-items:center;gap:8px}
  .er-dot{width:9px;height:9px;border-radius:50%;background:var(--color-danger);display:inline-block}
  .er-dot.on{animation:er-blink 1.1s infinite}
  @keyframes er-blink{50%{opacity:.25}}
  .er-rec-live b{font-variant-numeric:tabular-nums;color:var(--color-ink);font-size:13px}
  .er-stop{border-color:var(--color-danger) !important;color:var(--color-danger) !important}
  .er-rec-done audio{height:32px;max-width:210px}
  .er-again{opacity:.8}
  .er-denied{color:var(--color-danger);font-weight:700}

  /* ═══ وضع العرض التنفيذي — شريحة ملء الشاشة لكل قسم ═══ */
  .review.presenting{position:fixed;inset:0;z-index:60;max-width:none;margin:0;padding:0;background:var(--color-surface-2);overflow:hidden}
  .review.presenting .review-head,.review.presenting .review-nav{display:none}
  .review.presenting > section{display:none}
  .review.presenting > section.er-current{display:block;position:absolute;inset:0 0 58px 0;overflow-y:auto;padding:clamp(20px,4vh,48px) clamp(20px,5vw,90px);margin:0;font-size:1.06rem}
  .review.presenting > section.er-current .section-head h2{font-size:clamp(26px,3.4vw,44px)}
  .present-bar{display:none}
  .review.presenting .present-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;position:absolute;bottom:0;right:0;left:0;height:58px;padding:0 18px;background:var(--color-surface);border-top:1px solid var(--color-line-strong);box-shadow:var(--shadow-card)}
  .present-bar button{border:1px solid var(--color-line-strong);background:var(--color-surface);color:var(--color-ink);border-radius:var(--radius-chip);padding:8px 16px;font-size:12.5px;font-weight:800;cursor:pointer}
  .present-bar button:hover{border-color:var(--color-accent);color:var(--color-accent)}
  #presentExit{border-color:var(--color-danger);color:var(--color-danger)}
  .present-title{font-size:12px;font-weight:800;color:var(--color-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .present-ctl{display:inline-flex;align-items:center;gap:10px}
  .present-ctl b{font-variant-numeric:tabular-nums;color:var(--color-ink);font-size:13px;min-width:52px;text-align:center}

  .present-right{display:inline-flex;align-items:center;gap:8px}
  .portal-open-btn{border-color:var(--color-accent) !important;color:var(--color-accent) !important}

  /* ═══ لوحة الانتقال السريع ═══ */
  .portal-palette{display:none;position:fixed;inset:0;z-index:70;background:rgba(20,20,40,.45);padding:6vh 16px}
  .portal-palette.open{display:flex;justify-content:center;align-items:flex-start}
  .pp-box{width:min(680px,100%);max-height:82vh;display:flex;flex-direction:column;background:var(--color-surface);border-radius:var(--radius-card);box-shadow:var(--shadow-card-hover);overflow:hidden}
  .pp-box header{display:flex;gap:10px;padding:12px;border-bottom:1px solid var(--color-line-strong)}
  .pp-box input{flex:1;border:1px solid var(--color-line-strong);border-radius:10px;padding:9px 12px;font-size:13px;color:var(--color-ink);background:var(--color-surface)}
  .pp-box input:focus{outline:2px solid var(--color-accent);outline-offset:0;border-color:var(--color-accent)}
  .pp-box header button{border:1px solid var(--color-line-strong);background:var(--color-surface);color:var(--color-ink);border-radius:var(--radius-chip);padding:8px 14px;font-size:12px;font-weight:800;cursor:pointer}
  .pp-list{overflow-y:auto;padding:6px 14px 16px}
  .pp-group p{margin:12px 0 6px;font-size:11px;font-weight:900;color:var(--color-accent)}
  .pp-items{display:flex;flex-wrap:wrap;gap:7px}
  .pp-item{border:1px solid var(--color-line-strong);background:var(--color-surface);color:var(--color-ink);border-radius:var(--radius-chip);padding:7px 12px;font-size:12px;font-weight:800;cursor:pointer;transition:all .12s}
  .pp-item:hover{border-color:var(--color-accent);color:var(--color-accent)}

  /* ═══ طبقة التصفح الحي فوق العرض ═══ */
  .portal-layer{display:none;position:fixed;inset:0;z-index:80;background:var(--color-surface);flex-direction:column}
  .portal-layer.open{display:flex}
  .portal-layer header{display:flex;align-items:center;gap:12px;height:50px;padding:0 14px;border-bottom:1px solid var(--color-line-strong);background:var(--color-surface)}
  .portal-layer header button{border:1px solid var(--color-accent);background:var(--color-accent);color:#fff;border-radius:var(--radius-chip);padding:8px 14px;font-size:12px;font-weight:800;cursor:pointer;white-space:nowrap}
  #plTitle{flex:1;font-size:13px;font-weight:800;color:var(--color-ink);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  #plNewTab{font-size:12px;font-weight:800;color:var(--color-accent);text-decoration:none;white-space:nowrap}
  #portalFrame{flex:1;border:0;width:100%;background:var(--color-surface-2)}

  @media(max-width:700px){
    .review{padding:14px 12px 44px}
    .review-head{flex-direction:column;align-items:flex-start;padding:16px}
    .review.presenting > section.er-current{inset:0 0 54px 0;padding:16px 14px}
    .review.presenting .present-bar{height:54px;padding:0 10px}
    .present-title{display:none}
    .portal-palette{padding:3vh 8px}
    #plNewTab{display:none}
  }
</style>
