---
/**
 * مركز الدراسات والمقارنات — المرجع الواحد لكل الدراسات والمقارنات
 * والتقارير الاحترافية في البوابة: الدراسة المقارنة العالمية، مكتبة
 * الدورات المستندية العالمية، والتقارير الحاكمة القائمة — مصنَّفة
 * بحسب دورها في دعم القرار، لا مبعثرة بين الصفحات.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import study from '../../data/comparative-study.json';
import cycles from '../../data/global-doc-cycles.json';
import { executiveSummary } from '../../services/studies/studiesModel.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const summary = executiveSummary(study);

/** فئات المركز — كل بطاقة دراسة تنتمي لفئة واحدة. */
const sections = [
  {
    id: 'knowledge',
    icon: '🌍',
    title: 'المكتبة المعرفية العالمية',
    desc: 'كيف تعمل كبرى شركات العالم — مادة خام موثوقة تُبنى عليها المقارنات.',
    cards: [
      {
        icon: '🌐',
        title: 'الدورات المستندية العالمية',
        desc: `${cycles.meta.companiesCount} نماذج تشغيلية كاملة: الفلسفة والمراحل والمستندات ودور ERP وإسقاط Odoo ومثلث الإدارات والدروس المنقولة.`,
        path: '/dashboard/global-doc-cycles',
      },
    ],
  },
  {
    id: 'comparative',
    icon: '⚖️',
    title: 'الدراسات المقارنة والتحليلية',
    desc: 'حيث تُقاس ممارسات العالم على نظامنا وتتحول إلى قرارات.',
    cards: [
      {
        icon: '📐',
        title: 'الدراسة المقارنة العالمية — الأنظمة العالمية × هيكلنا × دورتنا',
        desc: `الدراسة الرائدة: ${summary.gapsTotal} فجوة محلَّلة · ${summary.kpisTotal} مؤشر أداء · ${summary.risksHigh} مخاطر عالية · ${summary.questionsTotal} سؤالًا للاجتماعات · ${summary.recsTotal} توصية تطوير — بنضج مُقاس ${summary.maturity}/5.`,
        path: '/dashboard/comparative-study',
        flagship: true,
      },
    ],
  },
  {
    id: 'governing',
    icon: '📜',
    title: 'المراجع الحاكمة لنظامنا',
    desc: 'الوثائق التي تحكم دورتنا وهيكلنا — أساس طرف «نحن» في كل مقارنة.',
    cards: [
      {
        icon: '🧭',
        title: 'الهيكل والمسارات',
        desc: 'الدورة المستندية باثنتي عشرة مرحلة والهيكل الوظيفي — الخريطة الحية.',
        path: '/dashboard/workflows',
      },
      {
        icon: '📘',
        title: 'المرجع التشغيلي الرسمي',
        desc: 'المرجع المعتمد للعمليات والبروتوكولات والملاحق.',
        path: '/المرجع-التشغيلي-الرسمي.html',
        external: true,
      },
      {
        icon: '👥',
        title: 'هيكل الوظائف والأدوار',
        desc: 'التقرير المولَّد من مصدر الهيكل الواحد org-structure.json.',
        path: '/تقرير-هيكل-الوظائف-والادوار.html',
        external: true,
      },
    ],
  },
];
---

<DashboardLayout title="مركز الدراسات والمقارنات" light>
  <div class="text-right" dir="rtl">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-ink mb-2">📚 مركز الدراسات والمقارنات</h1>
      <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
        المرجع المهني والأكاديمي الواحد لكل الدراسات والمقارنات والتقارير الاحترافية:
        ما يدخل هنا ليس توثيقًا للمعلومات بل عدّة لاتخاذ القرار — يدعم الاجتماعات
        التحضيرية ويغذّي خارطة الطريق.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-4"></div>
    </div>

    {/* شريط أرقام الدراسة الرائدة */}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-10">
      {[
        { v: cycles.meta.companiesCount, l: 'نماذج عالمية مدروسة' },
        { v: summary.gapsTotal, l: 'فجوة محلَّلة' },
        { v: summary.kpisTotal, l: 'مؤشر أداء مقترح' },
        { v: summary.questionsTotal, l: 'سؤال للاجتماعات' },
        { v: summary.recsTotal, l: 'توصية تطوير' },
        { v: `${summary.maturity}/5`, l: 'متوسط النضج المُقاس' },
      ].map((s) => (
        <div class="bg-chip border border-line rounded-xl p-4 text-center">
          <div class="text-2xl font-extrabold text-accent">{s.v}</div>
          <div class="text-[10px] text-ink-2 mt-1">{s.l}</div>
        </div>
      ))}
    </div>

    {sections.map((sec) => (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-ink mb-1">{sec.icon} {sec.title}</h2>
        <p class="text-xs text-muted mb-4">{sec.desc}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {sec.cards.map((c) => (
            <a
              href={`${base}${c.path}`}
              target={c.external ? '_blank' : undefined}
              class={`group block rounded-2xl p-5 border transition-all hover:-translate-y-1 ${
                c.flagship
                  ? 'lg:col-span-3 bg-surface border-accent/40 hover:border-accent/70 shadow-card hover:shadow-card-hover'
                  : 'bg-surface border-line shadow-card hover:border-accent/40'
              }`}
            >
              <div class="text-3xl mb-3">{c.icon}</div>
              <h3 class={`font-extrabold mb-1.5 leading-snug ${c.flagship ? 'text-accent text-lg' : 'text-ink'}`}>{c.title}</h3>
              <p class="text-xs text-ink-2 leading-relaxed">{c.desc}</p>
              <span class="mt-3 inline-flex items-center gap-1.5 text-[11px] font-bold text-accent/80 group-hover:text-accent transition-colors">
                {c.flagship ? 'افتح الدراسة الرائدة ←' : 'دخول ←'}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {/* دور المركز في الاجتماعات */}
    <section class="rounded-2xl bg-chip border border-line p-6">
      <h2 class="font-bold text-ink mb-3">🤝 كيف يخدم هذا المركز الاجتماعات والقرار؟</h2>
      <ul class="space-y-2 text-xs text-ink-2 leading-relaxed">
        <li class="flex gap-2"><span class="text-accent shrink-0">١.</span><span>قبل كل اجتماع تحضيري: افتح بنك الأسئلة في الدراسة المقارنة واطبع أسئلة الإدارة المعنية — كل سؤال ينتهي بقرار مطلوب.</span></li>
        <li class="flex gap-2"><span class="text-accent shrink-0">٢.</span><span>عند مناقشة أولويات التطوير: خارطة التوصيات مرتبة بالأفق والأثر، وكل توصية مربوطة بفجوة مُدلَّلة — لا اجتهادات مرتجلة.</span></li>
        <li class="flex gap-2"><span class="text-accent shrink-0">٣.</span><span>عند التفاوض مع مورّد أو منصة: راجع نموذج الشركة الأقرب في المكتبة العالمية (نون للمنصات الإقليمية، علي بابا للاستيراد B2B، وول مارت لاتفاقيات الأداء).</span></li>
        <li class="flex gap-2"><span class="text-accent shrink-0">٤.</span><span>لقياس التقدم: بطاقة النضج تعاد مراجعتها بعد كل مرحلة كبرى، والمؤشرات القابلة للقياس اليوم تدخل التقارير الدورية.</span></li>
      </ul>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`${base}/dashboard/meetings`} class="px-5 py-2.5 bg-brand-red text-white rounded-xl font-bold text-sm hover:bg-brand-red-dark transition-all">🤝 الاجتماعات التحضيرية</a>
        <a href={`${base}/dashboard/reports`} class="px-5 py-2.5 bg-chip border border-line text-ink rounded-xl font-bold text-sm hover:bg-surface-2 transition-all">📊 مركز التقارير</a>
      </div>
    </section>
  </div>
</DashboardLayout>
