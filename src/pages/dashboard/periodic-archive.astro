---
/**
 * الأرشيف الدوريّ — التقارير ومحاضر الاجتماعات.
 *
 * المصدر الأوّل المعتمد للتقارير الدورية والمحاضر (بدل تناثرها على سطح المكتب):
 * بذرةٌ ثابتة من `public/archive/` تُفتح حيًّا + رفعٌ حيّ يخزّنه المالك في أيّ
 * وقت. هوية bz-light عبر توكِنز `var(--color-*)`، بلا إيموجي، الأحمر للتحذير وحده.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PeriodicArchive from '../../components/brandzo-erp/archive/PeriodicArchive.jsx';
---

<DashboardLayout title="الأرشيف الدوريّ" showGuide={false} light>

<style is:inline>
  .ar-wrap { direction: rtl; color: var(--color-ink); }

  /* رأس */
  .ar-hero { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 14px; box-shadow: var(--shadow-card); padding: 22px 26px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .ar-hero-main { flex: 1; min-width: 280px; }
  .ar-hero h2 { font-size: 1.4rem; font-weight: 800; color: var(--color-ink); }
  .ar-hero p { color: var(--color-ink-2); font-size: .86rem; margin-top: 6px; max-width: 680px; line-height: 1.85; }
  .ar-primary-line { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 12px; font-size: .84rem; font-weight: 700; color: var(--color-ink); }
  .ar-hero-side { display: flex; flex-direction: column; gap: 12px; align-items: flex-end; }
  .ar-kpis { display: flex; gap: 9px; }
  .ar-kpi { background: var(--color-chip); border: 1px solid var(--color-line); border-radius: 12px; padding: 9px 16px; text-align: center; min-width: 82px; }
  .ar-kpi .n { display: block; font-size: 1.5rem; font-weight: 800; color: var(--color-accent); line-height: 1.1; }
  .ar-kpi .l { font-size: .7rem; color: var(--color-ink-2); margin-top: 2px; }

  .ar-badge { background: var(--color-accent); color: #fff; border-radius: 20px; padding: 3px 12px; font-size: .72rem; font-weight: 800; }
  .ar-badge.sm { padding: 1px 9px; font-size: .64rem; }
  .ar-num { background: var(--color-chip); color: var(--color-accent); border: 1px solid rgba(113,75,103,.2); border-radius: 7px; padding: 2px 9px; font-size: .72rem; font-weight: 800; font-family: 'Cairo',sans-serif; white-space: nowrap; }

  /* تبويبان */
  .ar-tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .ar-tab { display: inline-flex; align-items: center; gap: 8px; background: var(--color-surface); border: 1.5px solid var(--color-line-strong); border-radius: 10px; padding: 9px 18px; font-family: inherit; font-size: .9rem; font-weight: 700; color: var(--color-ink-2); cursor: pointer; transition: all .15s; }
  .ar-tab:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ar-tab.on { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .ar-tab-n { background: rgba(0,0,0,.08); border-radius: 20px; padding: 1px 9px; font-size: .74rem; }
  .ar-tab.on .ar-tab-n { background: rgba(255,255,255,.25); }

  /* البطاقات */
  .ar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px,1fr)); gap: 13px; }
  .ar-card { background: var(--color-surface); border: 1.5px solid var(--color-line-strong); border-radius: 14px; box-shadow: var(--shadow-card); padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; transition: all .18s; }
  .ar-card:hover { border-color: var(--color-accent); transform: translateY(-2px); box-shadow: var(--shadow-card-hover); }
  .ar-card.primary { border-color: var(--color-accent); box-shadow: 0 0 0 1px var(--color-accent), var(--shadow-card); }
  .ar-card-top { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .ar-fmt { margin-inline-start: auto; font-size: .68rem; font-weight: 800; color: var(--color-ink-2); border: 1px solid var(--color-line-strong); border-radius: 6px; padding: 1px 8px; }
  .ar-title { font-size: .98rem; font-weight: 800; color: var(--color-ink); line-height: 1.5; }
  .ar-meta { font-size: .74rem; color: var(--color-ink-2); }
  .ar-note { font-size: .8rem; color: var(--color-ink-2); line-height: 1.7; margin-top: 2px; }
  .ar-card-foot { display: flex; gap: 8px; margin-top: auto; padding-top: 6px; }

  .ar-file-ok { background: rgba(30,124,71,.1); color: #17663a; border: 1px solid rgba(30,124,71,.3); border-radius: 9px; padding: 8px 12px; font-size: .82rem; font-weight: 700; }
  .ar-hint { font-size: .76rem; color: var(--color-ink-2); line-height: 1.7; background: var(--color-surface-2); border-radius: 9px; padding: 8px 12px; }
  .ar-frame { width: 100%; height: 70vh; border: none; border-top: 1px solid var(--color-line-strong); background: #fff; }

  /* ── عناصر مشتركة (أزرار · رقائق · حقول · نوافذ · توست) بهوية bz-light ── */
  .kbtn { padding: 8px 15px; border-radius: 9px; border: 1px solid transparent; cursor: pointer; font-family: inherit; font-size: .83rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; transition: all .18s; white-space: nowrap; text-decoration: none; }
  .kbtn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(20,20,40,.10); }
  .kbtn:disabled { opacity: .45; cursor: not-allowed; }
  .kbtn.sm { padding: 6px 12px; font-size: .78rem; }
  .b-accent { background: var(--color-accent); color: #fff; }
  .b-accent:hover:not(:disabled) { background: #5d3e55; }
  .b-ghost { background: var(--color-surface-2); color: var(--color-ink-2); border-color: var(--color-line-strong); }
  .b-ghost:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent); }

  .chips { display: flex; gap: 7px; flex-wrap: wrap; }
  .chip { border: 1.5px solid var(--color-line-strong); background: var(--color-surface); border-radius: 18px; padding: 5px 13px; font-family: inherit; font-size: .78rem; font-weight: 700; cursor: pointer; color: var(--color-ink-2); transition: all .15s; }
  .chip:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .chip.on { color: #fff; border-color: var(--color-accent); background: var(--color-accent); }

  .fld { display: flex; flex-direction: column; gap: 4px; }
  .fld label { font-size: .74rem; font-weight: 800; color: var(--color-ink-2); }
  .fld input, .fld textarea { border: 1.5px solid var(--color-line-strong); border-radius: 9px; padding: 8px 11px; font-family: inherit; font-size: .88rem; background: var(--color-surface); color: var(--color-ink); width: 100%; }
  .fld input:focus, .fld textarea:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(113,75,103,.12); }
  .fld input.bad { border-color: #b02a37; }
  .fld textarea { resize: vertical; min-height: 56px; }
  .frow { display: grid; gap: 10px; }

  .kempty { text-align: center; padding: 30px 16px; color: var(--color-ink-2); font-size: .9rem; background: var(--color-surface); border: 1px dashed var(--color-line-strong); border-radius: 12px; }

  .dlg { position: fixed; inset: 0; z-index: 400; background: rgba(31,36,48,.42); display: none; align-items: center; justify-content: center; padding: 16px; }
  .dlg.on { display: flex; }
  .dlgbox { background: var(--color-surface); border-radius: 16px; width: min(640px,100%); max-height: 92vh; overflow: auto; box-shadow: 0 26px 70px rgba(0,0,0,.3); }
  .dlgbox.viewer { width: min(1000px,100%); overflow: hidden; display: flex; flex-direction: column; }
  .dlghead { position: sticky; top: 0; background: var(--color-surface); border-bottom: 1px solid var(--color-line-strong); color: var(--color-ink); padding: 13px 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px; z-index: 2; }
  .dlghead h3 { font-size: .98rem; font-weight: 800; }
  .dlgbody { padding: 15px 18px; display: flex; flex-direction: column; gap: 12px; }
  .dlgfoot { padding: 0 18px 16px; display: flex; gap: 8px; }

  .toastw { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 999; display: flex; flex-direction: column; gap: 8px; align-items: center; }
  .toast { background: var(--color-ink); color: #fff; padding: 11px 22px; border-radius: 12px; font-size: .88rem; font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.25); border-right: 4px solid var(--color-accent); max-width: min(600px,92vw); }

  /* ══ دورة حياة الوثيقة ══
     الأحمر **للتحذير وحده**: المنتهية، و«سرّي للغاية» (تنبيهُ تداولٍ لا زينة).
     والكهرمانيّ لما يقترب أجلُه، والأخضر للنشط، ولون الهوية للمعتمَد. */
  .ar-st, .ar-cf, .ar-type, .ar-op { display: inline-flex; align-items: center; border-radius: 20px; padding: 2px 10px; font-size: .7rem; font-weight: 800; white-space: nowrap; }
  .ar-st.st-draft    { background: var(--color-chip); color: var(--color-ink-2); }
  .ar-st.st-active   { background: rgba(30,124,71,.10); color: #17663a; }
  .ar-st.st-approved { background: rgba(113,75,103,.12); color: var(--color-accent); }
  .ar-st.st-expiring { background: rgba(214,158,46,.18); color: #7a5300; }
  .ar-st.st-expired  { background: rgba(176,42,55,.10); color: #b02a37; }
  .ar-cf.cf-internal   { background: rgba(27,79,138,.10); color: #1b4f8a; }
  .ar-cf.cf-secret     { background: rgba(214,158,46,.18); color: #7a5300; }
  .ar-cf.cf-top_secret { background: rgba(176,42,55,.10); color: #b02a37; }
  .ar-type { background: var(--color-surface-2); color: var(--color-ink-2); border: 1px solid var(--color-line); }
  .ar-op   { background: var(--color-chip); color: var(--color-ink-2); }
  .ar-chipline { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }

  .ar-kpi.warn .n   { color: #7a5300; }
  .ar-kpi.danger .n { color: #b02a37; }

  /* ══ الطبقة ١: تدخّل الآن ══ */
  .ar-attn { background: var(--color-surface); border: 1.5px solid rgba(214,158,46,.45); border-radius: 14px; padding: 14px 18px; margin-bottom: 16px; }
  .ar-attn-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
  .ar-attn-title { font-size: .95rem; font-weight: 800; color: var(--color-ink); }
  .ar-attn-sub { font-size: .76rem; color: var(--color-ink-2); }
  .ar-attn-row { display: flex; gap: 9px; flex-wrap: wrap; }
  .ar-attn-item { display: inline-flex; align-items: center; gap: 8px; background: var(--color-surface-2); border: 1px solid var(--color-line-strong); border-radius: 10px; padding: 7px 12px; font-family: inherit; font-size: .82rem; cursor: pointer; color: var(--color-ink); transition: all .15s; text-align: right; }
  .ar-attn-item:hover { border-color: var(--color-accent); transform: translateY(-1px); }
  .ar-attn-name { font-weight: 700; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ar-attn-days { font-size: .74rem; color: var(--color-ink-2); }

  /* ══ الطبقة ٢: البحث والتصفية ══ */
  .ar-filters { display: flex; flex-direction: column; gap: 10px; background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 14px; padding: 14px 18px; margin-bottom: 16px; }
  .ar-search { width: 100%; border: 1.5px solid var(--color-line-strong); border-radius: 10px; padding: 10px 14px; font-family: inherit; font-size: .9rem; background: var(--color-surface); color: var(--color-ink); }
  .ar-search:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(113,75,103,.12); }
  .ar-selects { display: flex; gap: 9px; flex-wrap: wrap; }
  .ar-selects select { border: 1.5px solid var(--color-line-strong); border-radius: 9px; padding: 7px 11px; font-family: inherit; font-size: .82rem; background: var(--color-surface); color: var(--color-ink); }
  .ar-filter-note { display: inline-flex; align-items: center; gap: 10px; font-size: .78rem; color: var(--color-ink-2); margin-inline-start: auto; }
  .ar-clear { background: none; border: none; font-family: inherit; font-size: .78rem; font-weight: 700; color: var(--color-accent); cursor: pointer; text-decoration: underline; }

  /* ══ تفاصيل الوثيقة ══ */
  .ar-panes { display: flex; gap: 6px; padding: 10px 18px 0; border-bottom: 1px solid var(--color-line); }
  .ar-pane { display: inline-flex; align-items: center; gap: 7px; background: none; border: none; border-bottom: 2.5px solid transparent; padding: 8px 12px; font-family: inherit; font-size: .86rem; font-weight: 700; color: var(--color-ink-2); cursor: pointer; }
  .ar-pane:hover { color: var(--color-accent); }
  .ar-pane.on { color: var(--color-accent); border-bottom-color: var(--color-accent); }

  .ar-dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px,1fr)); gap: 9px; }
  .ar-dl > div { background: var(--color-surface-2); border-radius: 9px; padding: 7px 11px; }
  .ar-dl dt { font-size: .7rem; font-weight: 800; color: var(--color-ink-2); }
  .ar-dl dd { font-size: .85rem; font-weight: 600; color: var(--color-ink); margin: 2px 0 0; }

  .ar-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .ar-list li { display: flex; align-items: center; gap: 10px; background: var(--color-surface-2); border: 1px solid var(--color-line); border-radius: 9px; padding: 8px 12px; font-size: .83rem; }
  .ar-list-main { font-weight: 700; color: var(--color-ink); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ar-list-by { font-size: .74rem; color: var(--color-ink-2); white-space: nowrap; }

  .ar-ocr summary { cursor: pointer; font-size: .8rem; font-weight: 700; color: var(--color-accent); }
  .ar-ocr pre { background: var(--color-surface-2); border: 1px solid var(--color-line); border-radius: 9px; padding: 10px 12px; margin-top: 8px; max-height: 260px; overflow: auto; white-space: pre-wrap; font-family: inherit; font-size: .8rem; line-height: 1.8; color: var(--color-ink-2); }

  /* ══ شريط تقدّم الرفع إلى المخزن ══ */
  .ar-prog { display: flex; align-items: center; gap: 10px; }
  .ar-prog-track { flex: 1; height: 8px; border-radius: 4px; background: var(--color-chip); overflow: hidden; }
  .ar-prog-fill { height: 100%; background: var(--color-accent); transition: width .25s; }
  .ar-prog span { font-size: .76rem; font-weight: 800; color: var(--color-accent); min-width: 38px; text-align: left; }

  /* ══ حقول النموذج المشتركة ══ */
  .fld select { border: 1.5px solid var(--color-line-strong); border-radius: 9px; padding: 8px 11px; font-family: inherit; font-size: .88rem; background: var(--color-surface); color: var(--color-ink); width: 100%; }
  .fld select:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(113,75,103,.12); }
  .frow.c2 { grid-template-columns: 1fr 1fr; }
  .frow.c3 { grid-template-columns: 1fr 1fr 1fr; }
  @media (max-width: 620px) { .frow.c2, .frow.c3 { grid-template-columns: 1fr; } }
</style>

<PeriodicArchive client:only="react" />

</DashboardLayout>
