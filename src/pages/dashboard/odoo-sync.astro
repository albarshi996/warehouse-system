---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import OdooSyncBridge from '../../components/brandzo-erp/odoo-sync/OdooSyncBridge.jsx';
---

<DashboardLayout title="جسر المزامنة مع أودو" light>
  <div class="text-right" dir="rtl">
    <h1 class="text-2xl font-bold text-ink mb-1">جسر المزامنة الحيّ مع أودو</h1>
    <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
      <p class="text-sm text-ink-2 max-w-3xl">
        مرآةٌ مبنيّة على الوقائع تشمل الدورة كلّها: <b>كلّ المستندات المحكومة</b>
        وماستر الأصناف <b>ودفتر الحركات المخزنيّة</b> — <b>تُستورد من أودو ولا تُدفع إليه</b>.
        أودو هو مصدر الحقيقة المالي، والبوابة تقرأ منه وتُحدّث مرآتها ولا تكتب فيه.
        الاتّجاه مختومٌ عند حدّ النقل نفسه، فلا يفلت منه مسار.
      </p>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/dashboard/learn-odoo`}
        class="inline-flex items-center gap-1.5 rounded-full border border-line bg-chip px-3 py-1 text-xs text-ink font-bold hover:border-accent hover:text-accent transition-colors shrink-0"
      >
        الجولة التعليميّة — تعلم أودو
      </a>
    </div>
    <OdooSyncBridge client:load />
  </div>
</DashboardLayout>
