---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ShopsAdmin from '../../components/brandzo-erp/shops/ShopsAdmin.jsx';
// ⚠️ لا تُحذف: قواعد الثيم كلُّها تحت `.o_theme` — بلا `odoo.css` تُعرض الشاشة
// نصًّا مرصوصًا بلا تنسيق (يحرسه تدقيقُ القسم ٦).
import '../../styles/tokens.css';
import '../../styles/odoo.css';
---

<DashboardLayout title="إدارة المحلّات" light>
  <div class="text-right" dir="rtl">
    <h1 class="text-2xl font-bold text-ink mb-1">إدارةُ المحلّات</h1>
    <p class="text-sm text-ink-2 mb-5">
      كلُّ محلٍّ شركةٌ مستقلّةٌ معزولةٌ تمامًا — حساباتُه وخزينتُه ومستنداتُه لا تختلط بغيره.
      أنشئ محلّاتِك، ثمّ اختر «المحلَّ الفعّال» الذي تُوسَم به وتُرشَّح عليه كلُّ العمليّات والتقارير.
    </p>
    <ShopsAdmin client:load />
  </div>
</DashboardLayout>
