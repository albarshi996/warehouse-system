---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/ui/Icon.astro';

/*
 * ─── تقرير آلية الربط بأودو والمزامنة الحيّة ─────────────────────────────────
 * تقريرٌ مرجعيّ احترافيّ **مبنيّ على الكود** (لا تخمين): يشرح كيف تتكامل البوابة
 * التفاعليّة مع أودو عبر الـAPI، والمزامنة الدوريّة واللحظيّة، ومزامنة أودو↔فايربيز،
 * والنسخ الاحتياطي، وآليّة الانتقال لقاعدة محليّة، وحوكمة تغيّر النموذج (الإصدار ١٩)
 * وطلب التحديث من المطوّرين، وسيناريوهات العوائق وكفاءة الربط.
 *
 * المصادر المؤكَّدة من الشجرة (كلّها في هذا المستودع):
 *   src/services/odoo/{index,odooConfig,odooClient,mockOdooClient,odooMapper}.js
 *   odoo-proxy/{cloudflare-worker/worker.js, firebase-function/index.js, README.md}
 *   brandzo-addons/brandzo_warehouse/__manifest__.py   (إصدار 19.0.1.2.0 · 12/12 · 52 اختبارًا)
 *   src/config/firebase.js  ·  docs/عقد-التكامل-مع-أودو.md
 *   docs/خطة-التطوير-الشاملة-الكاشير-وأودو-والقاعدة-المحلية.md
 *
 * الهوية: ثيم أودو الفاتح (bz-light) · أيقونات خطّية بلا إيموجي · الأحمر للتحذير فقط
 * (الأخضر = منفَّذ · الكهرمانيّ = مصمَّم/بانتظار خطوة) · أرقام لاتينية · مصدرٌ واحد.
 */

// فهرس المحاور (طبقة «الفهرس الكامل» — تنقّلٌ داخليّ سريع).
const toc = [
  { id: 'verdict', label: 'الحُكم الصادق والجاهزية', icon: 'gauge' },
  { id: 'api', label: '١ · آلية الربط عبر الـAPI', icon: 'puzzle' },
  { id: 'periodic', label: '٢ · المزامنة الدوريّة', icon: 'calendar' },
  { id: 'entities', label: '٣ · ربط الكيانات بأودو', icon: 'layers' },
  { id: 'firebase', label: '٤ · مزامنة أودو ↔ فايربيز', icon: 'arrowLeftRight' },
  { id: 'backup', label: '٥ · النسخ الاحتياطي', icon: 'archive' },
  { id: 'localdb', label: '٦ · الانتقال لقاعدة محليّة', icon: 'package' },
  { id: 'governance', label: '٧ · تغيّر النموذج وطلب التحديث', icon: 'settings' },
  { id: 'obstacles', label: '٨ · سيناريوهات العوائق والكفاءة', icon: 'alertTriangle' },
];

// مؤشّرات الجاهزية (أرقام لاتينية — محسوبة من المصدر).
const kpis = [
  { value: '~70%', label: 'جاهزية بنية التكامل', tone: 'accent' },
  { value: '5', label: 'بدائيّات API قياسيّة', tone: 'accent' },
  { value: '6', label: 'نماذج بقائمة سماح الوسيط', tone: 'accent' },
  { value: '19', label: 'إصدار أودو الحاليّ', tone: 'accent' },
  { value: '12/12', label: 'مرحلة الدورة المستندية', tone: 'accent' },
  { value: '52', label: 'اختبارًا خضراء (الموديول)', tone: 'success' },
];

// الخمس بدائيّات في عميل أودو (src/services/odoo/odooClient.js).
const primitives = [
  { fn: 'authenticate()', odoo: 'common.authenticate', desc: 'التحقّق من الاتصال وإرجاع معرّف المستخدم (uid) — يغذّي زرّ «اختبار الاتصال».' },
  { fn: 'searchRead(model, domain, fields)', odoo: 'search_read', desc: 'قراءة سجلّات مطابقة لنطاق — الأساس لجلب الأصناف/الموردين/الأوامر.' },
  { fn: 'create(model, values)', odoo: 'create', desc: 'إنشاء سجلّ جديد — به تُرسَل مستندات البوابة إلى أودو كمسوّدات.' },
  { fn: 'write(model, ids, values)', odoo: 'write', desc: 'تعديل سجلّات قائمة — لتحديث حقول مطابِقة عند اللزوم.' },
  { fn: 'unlink(model, ids)', odoo: 'unlink', desc: 'حذف سجلّات — محصور بقائمة السماح ونادر الاستعمال.' },
];

// مستند البوابة ← نموذج أودو ← حالة المسوّدة (من عقد التكامل §4/§5-ب).
const docMap = [
  { doc: 'PO — أمر شراء', model: 'purchase.order', state: 'مسوّدة / طلب عرض أسعار' },
  { doc: 'PR — طلب شراء', model: 'purchase.requisition', state: 'مسوّدة' },
  { doc: 'GRN — الاستلام', model: 'stock.picking (وارد)', state: 'مسوّدة (Draft)' },
  { doc: 'DN — إذن تسليم', model: 'stock.picking (صادر)', state: 'مسوّدة (Draft)' },
  { doc: 'SO / POS — بيع', model: 'sale.order / pos.order', state: 'مسوّدة' },
  { doc: 'INV — فاتورة', model: 'account.move', state: 'مسوّدة (Draft)' },
];

// ربط الكيانات (من odooMapper.js + عقد التكامل). الاتجاه: ⇄ ثنائيّ · → سحب فقط.
const entityMap = [
  {
    entity: 'الأصناف — Items_Master',
    model: 'product.product',
    fields: 'default_code⇄sku · name⇄nameAr · x_name_en⇄nameEn · categ_id→category · uom_id→unit · qty_available→balance (محسوب، قراءة فقط) · x_min_stock⇄minStock',
    dir: '⇄ ثنائيّ (عدا الرصيد: سحب)',
    status: 'مُطابِق منفَّذ',
    tone: 'success',
  },
  {
    entity: 'الموردون / العملاء',
    model: 'res.partner',
    fields: 'name · ref · vat · phone · email · علم مورّد/عميل — مرآة قراءة في odoo_mirror، ودفع اختياريّ لشريكٍ جديد',
    dir: '→ سحب (+ دفع اختياريّ)',
    status: 'مصمَّم',
    tone: 'warning',
  },
  {
    entity: 'الحركات المخزنيّة',
    model: 'stock.move',
    fields: 'product_id→sku (يُستخرج الرمز من «[CODE] Name») · product_uom_qty→qty · date→timestamp',
    dir: '→ سحب (اتّجاه واحد للسجلّ)',
    status: 'مُطابِق منفَّذ',
    tone: 'success',
  },
  {
    entity: 'الاستلام/التسليم/النقل',
    model: 'stock.picking (in/out/internal)',
    fields: 'دفع المستندات كمسوّدات + سحب الحالة (draft→done) للمرآة',
    dir: '⇄ دفع مسوّدة + سحب حالة',
    status: 'مصمَّم',
    tone: 'warning',
  },
  {
    entity: 'المشتريات',
    model: 'purchase.order / purchase.requisition',
    fields: 'دفع أمر/طلب الشراء كمسوّدة + سحب حالة الاعتماد والاستلام أوّلًا بأوّل',
    dir: '⇄ دفع + سحب',
    status: 'مصمَّم',
    tone: 'warning',
  },
  {
    entity: 'المبيعات / الفواتير',
    model: 'sale.order · pos.order · account.move',
    fields: 'دفع أمر البيع/الفاتورة كمسوّدة إلى أودو للمرآة المحاسبيّة',
    dir: '→ دفع (مرآة محاسبيّة)',
    status: 'مصمَّم',
    tone: 'warning',
  },
];

// سيناريوهات العوائق (من معالجة الأخطاء في العميل + قيود العقد).
const obstacles = [
  {
    scenario: 'الوسيط غير منشور بعد',
    cause: 'لم يُنشَر Cloudflare Worker ولم يُضبط PUBLIC_ODOO_PROXY_URL',
    fix: 'نشر الوسيط على حساب Cloudflare مجانيّ (خطوة المالك) — بلا تغيير كود',
    level: 'warning',
  },
  {
    scenario: 'أودو على localhost:8069 فقط',
    cause: 'الوسيط السحابيّ لا يرى عنوانًا محلّيًّا — المزامنة اللحظيّة مشروطة',
    fix: 'قرار المالك: استضافة أودو على عنوان عامّ — يفتح المرحلة الفوريّة',
    level: 'danger',
  },
  {
    scenario: 'خطّة Spark بلا Cloud Functions',
    cause: 'لا مشغّل خادميّ دائم للسحب الدوريّ',
    fix: 'Cloudflare Cron Trigger كمشغّل مجانيّ؛ أو ترقية Blaze لاحقًا',
    level: 'warning',
  },
  {
    scenario: 'تعذّر الوصول للوسيط (شبكة)',
    cause: 'انقطاع شبكة/DNS/CORS — بلا استجابة HTTP',
    fix: 'العميل يرمي رسالة واضحة، والبوابة تبقى عاملة كاملةً (صفر تبعيّة تشغيليّة)',
    level: 'success',
  },
  {
    scenario: 'فشل مصادقة أودو',
    cause: 'مفتاح API/مستخدم خاطئ — uid فارغ',
    fix: 'رسالة «فشلت مصادقة أودو» + زرّ «اختبار الاتصال» يكشفها مبكرًا',
    level: 'success',
  },
  {
    scenario: 'استدعاء خارج قائمة السماح',
    cause: 'نموذج/دالّة غير مُدرَجَين في allowlist الوسيط',
    fix: 'الوسيط يردّ 403 Blocked — أي توسعة تُضاف صراحةً بمراجعة',
    level: 'success',
  },
  {
    scenario: 'تعارض بيانات (عُدِّل الجانبان)',
    cause: 'نفس السجلّ تغيّر في البوابة وأودو',
    fix: 'سياسة «الأحدث يكسب + سجلّ تعارض» يُعرض في شاشة «مراقبة المزامنة»',
    level: 'warning',
  },
  {
    scenario: 'انقطاع الإنترنت أثناء العمل',
    cause: 'الموظّف يعمل في موقعٍ ضعيف/بلا شبكة',
    fix: 'كاش Firestore الدائم + طابور كتابة يُدفع تلقائيًّا عند العودة (قيد: أوّل دخول أونلاين)',
    level: 'success',
  },
  {
    scenario: 'تغيّر إصدار أودو أو أسماء الحقول',
    cause: 'ترقية أودو تُغيّر بنية النموذج (سابقة: product_uom→product_uom_id)',
    fix: 'مسار ترقية إلزاميّ: فرع منفصل + جدول توافق + 52 اختبارًا قبل الإنتاج',
    level: 'warning',
  },
];

const toneClass = {
  success: 'text-success bg-success/10 border-success/30',
  warning: 'text-warning bg-warning/10 border-warning/30',
  danger: 'text-danger bg-danger/10 border-danger/30',
  accent: 'text-accent bg-accent/10 border-accent/25',
};
// أصناف ثابتة للنقطة الملوّنة (Tailwind يمسح النصوص الحرفية فقط — لا الديناميكيّة).
const dotClass = {
  success: 'bg-success',
  warning: 'bg-warning',
  danger: 'bg-danger',
};
const REF = 'BFP-SCM-PR-2026-ODOO-01';
---

<DashboardLayout title="تقرير الربط بأودو" showGuide={false} light>
  <div id="oir-root" class="text-right" dir="rtl">

    {/* ─── الترويسة ──────────────────────────────────────────────────────── */}
    <header class="mb-8">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-3">
          <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 text-accent shrink-0">
            <Icon name="arrowLeftRight" size={24} />
          </span>
          <div>
            <h1 class="text-3xl font-bold text-ink leading-tight">تقرير آلية الربط بأودو والمزامنة الحيّة</h1>
            <p class="text-ink-2 text-base mt-1">كفاءة التكامل عبر الـAPI · المزامنة الدوريّة واللحظيّة · سيناريوهات العوائق</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-muted font-mono px-2.5 py-1 rounded-chip bg-chip border border-line">{REF}</span>
          <button id="oir-print" type="button"
            class="inline-flex items-center gap-2 text-xs font-bold text-accent bg-accent/10 border border-accent/25 hover:bg-accent/15 rounded-xl px-3 py-1.5 transition-colors">
            <Icon name="printer" size={15} /> طباعة / PDF
          </button>
        </div>
      </div>
      <p class="text-muted text-sm leading-relaxed mt-4 max-w-3xl">
        هذا التقرير <strong class="text-ink-2">مبنيٌّ على الكود مصدرًا رئيسيًّا</strong> — كل آليّة موصوفة هنا مؤكَّدة من ملفّ ومسار
        في المستودع (طبقة <span class="font-mono text-xs">src/services/odoo</span>، الوسيط <span class="font-mono text-xs">odoo-proxy</span>،
        الموديول <span class="font-mono text-xs">brandzo_warehouse</span>، إعداد فايربيز، وعقد التكامل). يميّز التقرير بأمانة بين
        <span class="text-success font-semibold">ما هو منفَّذ</span> و<span class="text-warning font-semibold">ما هو مصمَّم بانتظار التنفيذ</span>.
      </p>
      <div class="w-20 h-1 bg-accent rounded-chip mt-4"></div>
    </header>

    {/* ─── مفتاح الحالات ─────────────────────────────────────────────────── */}
    <div class="flex flex-wrap items-center gap-3 mb-8 text-xs">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-chip border text-success bg-success/10 border-success/30"><span class="w-2 h-2 rounded-full bg-success"></span> منفَّذ وقائم</span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-chip border text-warning bg-warning/10 border-warning/30"><span class="w-2 h-2 rounded-full bg-warning"></span> مصمَّم — بانتظار خطوة</span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-chip border text-danger bg-danger/10 border-danger/30"><span class="w-2 h-2 rounded-full bg-danger"></span> عائقٌ يشترط قرار المالك</span>
    </div>

    <div class="lg:grid lg:grid-cols-[220px_1fr] lg:gap-8 items-start">

      {/* ─── فهرس جانبيّ لاصق ─────────────────────────────────────────────── */}
      <nav aria-label="فهرس التقرير" class="hidden lg:block sticky top-6 self-start">
        <p class="text-xs font-bold text-muted mb-3 px-2">محتويات التقرير</p>
        <ul class="list-none p-0 m-0 space-y-1">
          {toc.map((s) => (
            <li>
              <a href={`#${s.id}`} data-toc={s.id}
                class="oir-toc-link flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink transition-colors">
                <Icon name={s.icon} size={15} class="text-muted shrink-0" />
                <span class="truncate">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="min-w-0 space-y-12">

        {/* ═══ الحُكم الصادق + مؤشّرات الجاهزية ═══════════════════════════════ */}
        <section id="verdict" class="scroll-mt-6">
          <div class="rounded-2xl border border-accent/25 bg-accent/5 p-6">
            <div class="flex items-center gap-2.5 mb-3">
              <Icon name="gauge" size={20} class="text-accent" />
              <h2 class="text-xl font-bold text-ink">الحُكم الصادق — أين نحن اليوم؟</h2>
            </div>
            <p class="text-ink-2 text-sm leading-loose">
              القرار المعماريّ الحاكم: <strong class="text-ink">فايربيز (Firestore) مصدر الحقيقة التشغيليّ، وأودو مرآة محاسبيّة/رقابيّة</strong>.
              البوابة تعمل كاملةً حتى لو سقط أودو — <strong class="text-ink">صفر تبعيّة تشغيليّة</strong>. التكامل «Integration» لا «Migration»:
              نغذّي أودو من البوابة ونقرأ منه ما يلزم، ولا ننقل قلب العمليّات إليه. عمليًّا: <strong class="text-ink">~70% من بنية التكامل
              مبنيّة ومعزولة</strong> (عميل + وسيط + موديول جاهزون)، والوضع الافتراضيّ <span class="font-mono text-xs">training</span> (محاكٍ)،
              ومنطق المزامنة نفسه <span class="text-warning font-semibold">مصمَّمٌ في عقد التكامل بانتظار التوصيل</span>. هذه الشفافيّة هي جوهر
              الاحترافيّة: لا نَعِد بما ليس موصولًا.
            </p>
          </div>

          <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 list-none p-0 m-0 mt-5">
            {kpis.map((k) => (
              <li class={`rounded-xl border p-3.5 text-center ${toneClass[k.tone]}`}>
                <div class="text-2xl font-bold leading-none">{k.value}</div>
                <div class="text-[11px] text-ink-2 mt-1.5 leading-tight">{k.label}</div>
              </li>
            ))}
          </ul>

          <div class="grid sm:grid-cols-2 gap-4 mt-5">
            <div class="rounded-xl border border-line bg-surface shadow-card p-4">
              <div class="flex items-center gap-2 mb-2 text-success"><Icon name="checkCircle" size={17} /><span class="font-bold text-sm">منفَّذٌ اليوم في الكود</span></div>
              <ul class="text-xs text-ink-2 space-y-1.5 list-none p-0 m-0 leading-relaxed">
                <li>· عميل أودو بخمس بدائيّات (<span class="font-mono">authenticate/searchRead/create/write/unlink</span>).</li>
                <li>· مُبدِّل الوضع (تدريب/إنتاج) بمتغيّر بيئة واحد بلا تغيير كود.</li>
                <li>· مُطابِق الحقول (product.product ⇄ الأصناف · stock.move → السجلّ).</li>
                <li>· محاكي أودو أوفلاين (نفس الواجهة، بلا شبكة) للتدريب.</li>
                <li>· وسيطان مرجعيّان (Cloudflare Worker + Firebase Function) بقائمة سماح.</li>
                <li>· الموديول <span class="font-mono">brandzo_warehouse</span> (إصدار 19، ‏12/12 مرحلة، ‏52 اختبارًا خضراء).</li>
              </ul>
            </div>
            <div class="rounded-xl border border-line bg-surface shadow-card p-4">
              <div class="flex items-center gap-2 mb-2 text-warning"><Icon name="workflows" size={17} /><span class="font-bold text-sm">مصمَّمٌ بانتظار التنفيذ</span></div>
              <ul class="text-xs text-ink-2 space-y-1.5 list-none p-0 m-0 leading-relaxed">
                <li>· توصيل العميل بشاشة مزامنة + اختبار تكامل يحرسه من التعفّن.</li>
                <li>· السحب الدوريّ (polling) للموردين/الأصناف/الأوامر/الأرصدة.</li>
                <li>· طابور الدفع (outbox) لإرسال المستندات كمسوّدات لأودو.</li>
                <li>· المرايا <span class="font-mono">odoo_mirror_*</span> ووثيقة <span class="font-mono">sync_state</span> وقواعد أمانها.</li>
                <li>· اللحظيّ الحقيقيّ (Webhooks) — مشروطٌ باستضافة أودو عامّة.</li>
                <li>· طبقة Repository لتبديل القاعدة (القسم ٦).</li>
              </ul>
            </div>
          </div>
        </section>

        {/* ═══ ١ · آلية الربط عبر الـAPI ═════════════════════════════════════ */}
        <section id="api" class="scroll-mt-6">
          <div class="flex items-center gap-2.5 mb-4">
            <span class="inline-grid place-items-center w-9 h-9 rounded-lg bg-accent/10 border border-accent/25 text-accent"><Icon name="puzzle" size={18} /></span>
            <h2 class="text-2xl font-bold text-ink">١ · آلية الربط عبر الـAPI وإرسال المستندات كمسوّدات</h2>
          </div>
          <p class="text-ink-2 text-sm leading-loose mb-5">
            المتصفّح <strong class="text-ink">لا يحمل سرّ أودو أبدًا</strong> (سرّه سرقةٌ لو شُحن في الحزمة)، ونقطة أودو
            <span class="font-mono text-xs">/jsonrpc</span> لا تُصدر ترويسات CORS. لذا يمرّ كل استدعاء عبر <strong class="text-ink">وسيطٍ خادميّ رقيق</strong>
