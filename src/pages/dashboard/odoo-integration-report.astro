  <script is:inline>
    (function () {
      'use strict';
      var root = document.getElementById('oir-root');
      if (!root) return;

      // طباعة/PDF — طباعة المتصفّح (بلا تبعيّات).
      var printBtn = document.getElementById('oir-print');
      if (printBtn) printBtn.addEventListener('click', function () { window.print(); });

      // تمييز عنصر الفهرس النشط أثناء التمرير (scroll-spy).
      var links = Array.prototype.slice.call(root.querySelectorAll('.oir-toc-link'));
      var byId = {};
      links.forEach(function (a) { byId[a.getAttribute('data-toc')] = a; });
      var sections = links
        .map(function (a) { return document.getElementById(a.getAttribute('data-toc')); })
        .filter(Boolean);

      var activeCls = ['bg-accent/10', 'text-accent', 'font-bold'];
      function setActive(id) {
        links.forEach(function (a) { activeCls.forEach(function (c) { a.classList.remove(c); }); });
        var el = byId[id];
        if (el) activeCls.forEach(function (c) { el.classList.add(c); });
      }

      if ('IntersectionObserver' in window && sections.length) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) setActive(e.target.id); });
        }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
        sections.forEach(function (s) { io.observe(s); });
      }
    })();
  </script>
