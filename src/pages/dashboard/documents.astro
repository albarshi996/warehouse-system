---
/**
 * صندوق المستندات — مستنداتي · بانتظار اعتمادي · الكل (للمدير).
 * المرحلة F1 من خطة تحويل النماذج (ROADMAP §11).
 * قاعدة صفر حذف: مكتبة النماذج الورقية `/dashboard/forms` تبقى كما هي.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/tokens.css';
import '../../styles/odoo.css';
import DocumentsInbox from '../../components/brandzo-erp/documents/DocumentsInbox.jsx';
import OpenDocumentsBox from '../../components/brandzo-erp/documents/OpenDocumentsBox.jsx';
---

<DashboardLayout title="المستندات" showGuide={false} light>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-2">المستندات</h1>
      <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
        المستندات الرسمية <span class="text-brand-gold font-bold">تُحفظ ولا تضيع</span>: لكل مستند
        رقم تسلسلي حقيقي، واسم من أنشأه ومن اعتمده، وسجلّ تدقيق دائم — بدل الورقة التي تُملأ ثم
        تُغلق الصفحة فيضيع كل شيء.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <DocumentsInbox client:load />

    {/*
      صندوق العمل المفتوح (SAP-12) — قسمٌ ثانٍ على الصفحة نفسها لا مسارٌ جديد:
      الموظّف يأتي إلى «المستندات» أصلًا، فيجد ما ينتظر توقيعه **وما لم يكتمل**
      في مكانٍ واحد. ولا يُحذف ولا يُغيَّر رابطٌ قائم (§3-٣ ‹42›).
    */}
    <section class="mt-10 pt-8 border-t border-line">
      <div class="mb-4">
        <h2 class="text-xl font-bold text-ink mb-1">العمل المفتوح</h2>
        <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
          ليس ما ينتظر توقيعك، بل <span class="font-bold text-ink">ما لم يكتمل بعد</span>:
          أمرُ شراءٍ وصل نصفه، وتسليمٌ لم يُؤكَّد، وطلبُ نقلٍ لم يُنفَّذ — معتمَدةٌ
          وموقَّعة ولا تنتظر أحدًا، وعملُها لم يتمّ. والمغلق والملغى يخرجان منها.
        </p>
      </div>
      <OpenDocumentsBox client:load />
    </section>
  </div>
</DashboardLayout>
