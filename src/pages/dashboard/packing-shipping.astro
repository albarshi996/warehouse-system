---
/**
 * التعبئة والشحن ‹LPN-721› — طرودٌ بباركوداتٍ مستقلّة وملصقُ عميل.
 *
 * لماذا وُجدت؟ لأنّ الطلب كان يخرج من المستودع **بلا هويّةٍ ماديّة**: أرقام
 * الطرود تُكتب باليد في مستندٍ ورقيّ، فلا تُمسح ولا تُتتبَّع (ف-١٥ · ف-١٦).
 *
 * الوثيقة الحاكمة: docs/plan/مطابقة-هوية-الباركود.md · المتتبّع: npm run plan:lpn
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/tokens.css';
import '../../styles/odoo.css';
import PackingFlow from '../../components/brandzo-erp/shipping/PackingFlow.jsx';
---

<DashboardLayout title="التعبئة والشحن" showGuide={false} light>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-2">التعبئة والشحن</h1>
      <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
        من طلبٍ محضَّر إلى <span class="text-accent font-bold">طرودٍ مغلقةٍ جاهزةٍ للتحميل</span>:
        يحدّد النظام عدد الطرود فيولّد <span class="font-bold">باركودًا مستقلًّا لكلٍّ منها</span>
        مرتبطًا برقم الشحنة نفسه، ويردّ الصنف الدخيل والكمّيّة الزائدة. وملصقُ العميل
        <span class="font-bold">يُسحب من أمر الصرف المعتمد</span> ولا يُكتب بيد — وفيه
        «١ من ٤» محسوبةً لا مكتوبة.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <PackingFlow client:load />
  </div>
</DashboardLayout>
