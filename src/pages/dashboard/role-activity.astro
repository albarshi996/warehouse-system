---
/**
 * سجلّ حركة الأدوار — رصدٌ حيٌّ فعليّ للحركة في البوابة.
 *
 * الترويسة والتواقيع تُرسَم من الخادم (SSR) فوق بيانات التعريف في
 * `role-activity.json`، أمّا السجلّ نفسه فجزيرةٌ حيّة `RoleActivity` تشترك
 * لحظيًّا في `documents` و`stock_moves` وتبني الأثر عبر `roleActivityModel`.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import meta from '../../data/role-activity.json';
import RoleActivity from '../../components/brandzo-erp/reference/RoleActivity.jsx';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
const m = meta.meta;
---

<DashboardLayout title="سجلّ حركة الأدوار" light>
  <div class="text-right doc-trail" dir="rtl">
    {/* ترويسة */}
    <div class="mb-8 rounded-2xl bg-gradient-to-br from-brand-navy via-[#1a1a3e] to-[#0d0d2b] border border-accent/30 p-6 sm:p-10">
      <p class="text-[11px] text-muted mb-2">{m.refNumber} · الإصدار {m.version} · {m.issued}</p>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-ink leading-snug mb-3">{m.title}</h1>
      <p class="text-sm text-ink-2 leading-relaxed max-w-4xl mb-4">{m.purpose}</p>
      <div class="rounded-xl border border-green-500/30 bg-green-500/5 p-4">
        <p class="text-[11px] font-bold text-green-300 mb-1 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
          رصدٌ حيّ — من قاعدة البيانات مباشرةً
        </p>
        <p class="text-xs text-ink-2 leading-relaxed">{m.note}</p>
        <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          {m.sources.map((s) => (
            <li class="text-[11px] text-muted flex gap-1.5"><span class="text-brand-yellow shrink-0">•</span><span>{s}</span></li>
          ))}
        </ul>
      </div>
      <div class="mt-5 flex flex-wrap gap-3 no-print">
        <a href={`${base}/dashboard/documents`} class="px-4 py-2 bg-chip border border-line text-ink rounded-xl text-xs font-bold hover:bg-surface-2 transition-all">المستندات (المصدر الأول)</a>
        <a href={`${base}/dashboard/stock-ledger`} class="px-4 py-2 bg-chip border border-line text-ink rounded-xl text-xs font-bold hover:bg-surface-2 transition-all">دفتر حركات المخزون (المصدر الثاني)</a>
        <button type="button" id="printTrail" class="px-4 py-2 bg-brand-navy text-white rounded-xl text-xs font-bold hover:opacity-90 transition-all">طباعة السجلّ</button>
      </div>
    </div>

    {/* السجلّ الحيّ (جزيرة React: إحصاء + مصفّيات + خطّ زمنيّ) */}
    <RoleActivity client:load />

    {/* اعتماد السجلّ */}
    <section class="rounded-2xl bg-gradient-to-br from-brand-navy to-[#0d0d2b] border border-line p-6">
      <h2 class="text-sm font-bold text-ink mb-6 text-center">اعتماد السجلّ</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-2xl mx-auto text-center">
        <div>
          <img src={`${base}/identity/signatures/signature-2.png`} alt="توقيع محمد البرشي" class="h-16 mx-auto mb-2 object-contain" />
          <p class="font-bold text-ink text-sm">محمد البرشي</p>
          <p class="text-[11px] text-muted">مدير إدارة السلاسل والإمداد والمخازن</p>
        </div>
        <div>
          <img src={`${base}/identity/signatures/signature-1.png`} alt="توقيع رمزي الباش" class="h-16 mx-auto mb-2 object-contain" />
          <p class="font-bold text-ink text-sm">رمزي الباش</p>
          <p class="text-[11px] text-muted">مدير إدارة الخدمات اللوجستية والخدمية</p>
        </div>
      </div>
    </section>
  </div>

  <style>
    @media print {
      .no-print { display: none !important; }
      .doc-trail { color: #111 !important; }
    }
  </style>

  <script>
    document.getElementById('printTrail')?.addEventListener('click', () => window.print());
  </script>
</DashboardLayout>
