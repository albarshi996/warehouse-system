---
/**
 * «الهوية التشغيلية للمستودعات» — عرض الجلسة المشتركة: السلاسل × التسويق.
 *
 * محورها تقرير التسويق البصريّ (٢٦ قسمًا · ٢٣٣ نموذجًا · ١٢ عائلة تصميم)،
 * ودعواها واحدة: الترميز الذي تطلبه اللوحة **قائمٌ في النظام** بستّة مقاطع —
 * فاللوحة وجهٌ ماديّ لسجلٍّ لا كودٌ يُخترع على الجدار.
 *
 * الأنماط في ملفَّين: الهيكل المشترك بين عروض الاجتماعات في
 * `meeting-deck.css`، وما يخصّ هذا العرض وحده في `identity-meeting.css`.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WarehouseIdentityDeck from '../../components/identity-meeting/WarehouseIdentityDeck.jsx';
import '../../styles/meeting-deck.css';
import '../../styles/identity-meeting.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<DashboardLayout title="الهوية التشغيلية للمستودعات" light>
  <WarehouseIdentityDeck base={base} client:load />
</DashboardLayout>
