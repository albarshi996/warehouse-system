---
/**
 * ماستر الموردين (§15.2) — مصدر واحد لبيانات الموردين بديلًا للحقل النصّي الحرّ.
 * قائمة + إضافة/تعديل + استيراد Excel بمعاينة + أرشفة (لا حذف). للمديرَين.
 * المحرّك: partnerService + partnersImportService (توأم العملاء عبر kind).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PartnerMaster from '../../components/brandzo-erp/partners/PartnerMaster.jsx';
---

<DashboardLayout title="ماستر الموردين" showGuide={false}>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">🤝 ماستر الموردين</h1>
      <p class="text-gray-300 text-sm leading-relaxed max-w-3xl">
        مصدرٌ واحدٌ لبيانات الموردين — رمزٌ فريدٌ لكلّ مورّد بدل الاسم النصّي، مع
        الاستيراد من شيت Excel بمرادفات عربية/إنجليزية. الأرصدة <span class="text-brand-gold font-bold">افتتاحيّة للعرض</span>،
        و<span class="text-brand-gold font-bold">لا حذف</span> — أرشفة فقط.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <PartnerMaster kind="supplier" client:load />
  </div>
</DashboardLayout>
