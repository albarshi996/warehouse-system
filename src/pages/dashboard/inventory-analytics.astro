---
/**
 * تحليل المخزون: التقييم والراكد وإعادة الطلب — أوّل بنود حزمة التقارير §17
 * غير المبنيّة. عرضٌ حيٌّ فوق `inventoryAnalytics.js` الخالص المُختبَر، يقرأ
 * ماستر الأصناف ودفتر الحركات القائمَين — لا بيانات جديدة ولا تغيير قواعد.
 * الوصول للمديرَين (مقيَّد في `navCatalog`).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import InventoryAnalytics from '../../components/brandzo-erp/inventory/InventoryAnalytics.jsx';
---

<DashboardLayout title="تحليل المخزون" showGuide={false} light>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-2">تحليل المخزون — التقييم والراكد وإعادة الطلب</h1>
      <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
        سؤالان ماليّان قبل أيّ تقرير: <span class="text-brand-gold font-bold">كم رأس مالٍ راقدٌ لا يتحرّك؟</span>
        و<span class="text-brand-gold font-bold">أيّ صنفٍ تحت حدّه يوشك أن ينفد؟</span> — كلاهما محسوبٌ من أرصدة الماستر
        وتكاليفه وتواريخ الخروج في الدفتر، لا من انطباع.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <InventoryAnalytics client:load />
  </div>
</DashboardLayout>
