---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import OperationsCommand from '../../components/brandzo-erp/ledger/OperationsCommand.jsx';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

/*
 * ─── لوحة التحكم — «المعيار الدافئ» (إعادة تصميم معتمَدة 2026-07-29) ────────────
 * القاعدة الذهبية: صفر حذف — كل مقصد قائم بقي، أُعيد عرضه فقط. التغييرات مقابل
 * النسخة السابقة: أيقونات خطّية بدل الإيموجي · لون تمييز واحد (ذهبي) والأحمر
 * محجوز للحالة/التحذير (بطاقة الاجتماعات لم تعد حمراء) · شريط الأرقام الثابت
 * أُزيل · طبقة «ابدأ من هنا» صعدت للأعلى · بطاقة/سطح/نصف قطر/ظلّ موحّدة عبر
 * توكِنز global.css · أرقام لاتينية. عقد سكربت التخصيص محفوظ حرفيًّا.
 */

// ── الطبقة الأولى العمليّة: ابدأ من هنا (المسار الأساسيّ الأكثر تكرارًا) ──
const startHere = [
  { id: 'start-docs', path: '/dashboard/documents', icon: 'fileText',
    title: 'المستندات', desc: 'إنشاء ومتابعة المستندات التشغيلية المحكومة' },
  { id: 'start-tasks', path: '/dashboard/tasks', icon: 'checkSquare',
    title: 'المهام التشغيلية', desc: 'لوحة المهام اليومية وتوزيعها ومتابعتها' },
  { id: 'start-reports', path: '/dashboard/reports', icon: 'barChart3',
    title: 'مركز التقارير', desc: 'كل تقارير المنظومة — تشغيلية وجودة وتحليلية' },
];

// ── البطاقات الحاوية (كل المقاصد محفوظة كما هي) ──
const hubs = [
  {
    id: 'hub-structure', icon: 'building2', title: 'الهيكل التنظيمي للمستودعات',
    desc: 'بوابة التوظيف والتقارير الإدارية والهيكل والدورة المستندية.',
    links: [
      { path: '/dashboard/org-structure', icon: 'folders', label: 'الهيكل التنظيمي' },
      { path: '/dashboard/workflows', icon: 'workflows', label: 'الهيكل والمسارات (الدورة المستندية)' },
      { path: '/dashboard/recruitment', icon: 'userPlus', label: 'التوظيف الذكي', roles: 'admin,warehouse_manager' },
    ],
  },
  {
    id: 'hub-warehouse-ops', icon: 'package', title: 'عمليات المخزنية',
    desc: 'المستندات والأصناف والمهام والعمليات وإدارة المستودعات.',
    links: [
      { path: '/dashboard/documents', icon: 'fileText', label: 'المستندات' },
      { path: '/dashboard/products', icon: 'package', label: 'إدارة الأصناف' },
      { path: '/dashboard/tasks', icon: 'checkSquare', label: 'المهام التشغيلية' },
      { path: '/dashboard/stock-operations', icon: 'wrench', label: 'عمليات مخزنية' },
      { path: '/dashboard/warehouses', icon: 'warehouse', label: 'إدارة المستودعات' },
    ],
  },
  {
    id: 'hub-dashboards', icon: 'barChart3', title: 'لوحات القيادة',
    desc: 'المؤشرات والمتابعة الحيّة ودفتر الحركات والنقل والرقابة على الطلبات.',
    roles: 'admin,warehouse_manager',
    links: [
      { path: '/dashboard/command-center', icon: 'target', label: 'لوحة القيادة التشغيلية' },
      { path: '/dashboard/supply-chain', icon: 'barChart3', label: 'لوحة سلاسل الإمداد' },
      { path: '/dashboard/operations', icon: 'activity', label: 'متابعة العمليات' },
      { path: '/dashboard/stock-ledger', icon: 'notebook', label: 'دفتر حركات المخزون' },
      { path: '/dashboard/transfers', icon: 'arrowLeftRight', label: 'النقل بين المستودعات' },
      { path: '/dashboard/order-control', icon: 'gauge', label: 'الرقابة على الطلبات' },
    ],
  },
  {
    id: 'hub-training', icon: 'graduationCap', title: 'التدريب والتطوير',
    desc: 'محاكي أودو ودورات ERP ودليل التثبيت والأرشيف التأسيسي.',
    links: [
      { path: '/dashboard/learn-odoo', icon: 'graduationCap', label: 'تعلّم أودو (محاكي الواجهة)' },
      { path: '/dashboard/erp-workflows', icon: 'settings', label: 'دورات عمل ERP' },
      { path: '/dashboard/archive', icon: 'archive', label: 'الأرشيف التأسيسي' },
    ],
  },
  {
    id: 'hub-access', icon: 'shield', title: 'الصلاحيات والأدوار',
    desc: 'مَن يدخل، وبأي دور، وماذا يرى ويعتمد.',
    roles: 'admin',
    links: [
      { path: '/dashboard/users', icon: 'users', label: 'إدارة المستخدمين' },
      { path: '/dashboard/access-control', icon: 'shieldCheck', label: 'الصلاحيات والأدوار' },
      { path: '/dashboard/arch-wiki', icon: 'map', label: 'خريطة النظام' },
    ],
  },
];

// بطاقة الاجتماعات — مفردة كما هي (طلب المالك)، لكن دون اللون الأحمر (الأحمر للحالة فقط).
const meetingsCard = {
  id: 'ft-meetings', path: '/dashboard/meetings', icon: 'handshake',
  title: 'الاجتماعات التحضيرية',
  desc: 'الاجتماعات السبعة مع إدارات الشركة: عرض ومحضر حيّ وخطاب.',
  roles: 'admin,warehouse_manager',
};

// ── الأقسام المجمّعة (كل المقاصد محفوظة) ──
const groups = [
  {
    id: 'daily', title: 'العمليات اليومية', icon: 'calendar',
    cards: [
      { id: 'forms', path: '/dashboard/forms', icon: 'clipboardList',
        title: 'النماذج التشغيلية', desc: 'استعرض النماذج الـ19 — قلب التوثيق العملي' },
      { id: 'stock-ops', path: '/dashboard/stock-operations', icon: 'wrench',
        title: 'عمليات مخزنية', desc: 'نظام تفاعلي لإدارة الجرد والعمليات اليومية' },
    ],
  },
  {
    id: 'inventory', title: 'المستودعات والجرد', icon: 'package',
    cards: [
      { id: 'retail', path: '/dashboard/retail-hub', icon: 'mapPin',
        title: 'خريطة الأسواق', desc: 'تحليل فئات المستهلكين والأسواق في بنغازي' },
      { id: 'assets', path: '/dashboard/assets-inventory', icon: 'layers',
        title: 'جرد الأصول', desc: 'جرد أجهزة ومركبات ومكاتب برندزو مع التصدير' },
      { id: 'vehicles', path: '/dashboard/vehicles-inventory', icon: 'car',
        title: 'جرد المركبات', desc: 'تفتيش شامل للمركبات مع استمارة التسليم والاستلام' },
    ],
  },
  {
    id: 'reports', title: 'التقارير والتحليل', icon: 'barChart3',
    cards: [
      { id: 'reports-center', path: '/dashboard/reports', icon: 'barChart3', featured: true,
        title: 'مركز التقارير', desc: 'كل تقارير المنظومة — التشغيلية والجودة والتحليلية والتوثيق المرئي — في مكان واحد' },
      { id: 'staffing', path: '/تقرير-التوظيف-والجدول-الزمني.html', newtab: true, icon: 'users',
        title: 'تقرير التوظيف', desc: 'جدول زمن إدارة المستودعات والهيكل الوظيفي' },
    ],
  },
];

// أنظمة قادمة — نمط «قريباً».
const soon = [
  { id: 'soon-brands', icon: 'tag', title: 'بوابات علامات إضافية',
    desc: 'إدارة مستودعات لعلامات تجارية أخرى ضمن نفس البوابة.' },
  { id: 'soon-kpi', icon: 'trendingUp', title: 'لوحة المؤشرات المالية',
    desc: 'مؤشرات الأداء والتكاليف التشغيلية لحظيًّا.' },
];
---

{/* light: الرئيسية أول صفحة مرحَّلة لنظام أودو الفاتح (المرحلة ١، 2026-07-30) */}
<DashboardLayout title="لوحة التحكم" showGuide={false} light>
  <div id="dash-root" class="text-right" dir="rtl">
    {/* ─── الترويسة + زر التخصيص ─────────────────────────────────────────── */}
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-ink mb-2">
            إدارة مستودعات برند زو
            <span class="block text-lg font-normal text-ink-2 mt-1">Brandzo Warehouse Management — Benghazi 2026</span>
          </h1>
          <p class="text-muted text-sm leading-relaxed">
            بوابة العمليات الرسمية لإدارة المستودعات والتوزيع في بنغازي
          </p>
        </div>

        {/* أدوات التخصيص */}
        <div class="shrink-0 flex flex-wrap items-center gap-2">
          <button id="btn-customize" type="button"
            class="inline-flex items-center gap-2 rounded-xl border border-line bg-chip hover:bg-surface-2 px-4 py-2 text-sm font-bold text-ink-2 transition-colors">
            <Icon name="settings" size={16} /><span id="btn-customize-label">تخصيص العرض</span>
          </button>
          <div id="customize-actions" class="hidden flex-wrap items-center gap-2">
            <span id="hidden-count" class="text-xs text-muted"></span>
            <button id="btn-showall" type="button"
              class="rounded-xl border border-line bg-chip hover:bg-surface-2 px-3 py-2 text-xs font-bold text-ink-2 transition-colors">
              إظهار الكل
            </button>
            <button id="btn-done" type="button"
              class="rounded-xl bg-accent hover:brightness-110 px-4 py-2 text-xs font-bold text-[#101026] transition-all">
              تم
            </button>
          </div>
        </div>
      </div>

      <div class="w-20 h-1 bg-accent rounded-chip mt-4 mb-2"></div>
      <p id="customize-hint" class="hidden text-xs text-accent/90 bg-accent/5 border border-accent/20 rounded-lg px-3 py-2">
        وضع التخصيص مُفعّل — انقر أي بطاقة لإخفائها أو إظهارها. تُحفظ اختياراتك في هذا المتصفّح.
      </p>
    </div>

    {/* ─── الطبقة صفر: النبض الحيّ — لوحة القيادة التشغيلية مدمجة ─────────────
         إعادة استخدام لمكوّن OperationsCommand نفسه (لا نسخ): أي تطوير له
         ينعكس هنا وفي /dashboard/command-center معًا. القاعدة الذهبية: صفر حذف —
         الصفحة المستقلة باقية كما هي. مقيَّد بأدوار الإدارة أسوةً ببطاقة
         «لوحات القيادة»، وقابل للإخفاء من «تخصيص العرض» كأي بطاقة. */}
    <ul class="list-none p-0 m-0">
      <li data-item-roles="admin,warehouse_manager">
        <section data-section data-group="pulse" class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-grid place-items-center w-8 h-8 rounded-lg bg-accent/10 border border-accent/25 text-accent"><Icon name="target" size={17} /></span>
            <h2 class="text-lg sm:text-xl font-bold text-ink">النبض الحيّ — لوحة القيادة التشغيلية</h2>
            <div class="flex-1 h-px bg-line"></div>
            <a href={`${base}/dashboard/command-center`}
              class="text-xs font-bold text-accent hover:underline whitespace-nowrap">الصفحة الكاملة ←</a>
          </div>
          <div class="dash-card relative" data-card-id="live-pulse">
            <span class="card-badge"></span>
            <OperationsCommand client:load />
          </div>
        </section>
      </li>
    </ul>

    {/* ─── الطبقة الأولى: ابدأ من هنا ─────────────────────────────────────── */}
    <section data-section data-group="start" class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-grid place-items-center w-8 h-8 rounded-lg bg-accent/10 border border-accent/25 text-accent"><Icon name="rocket" size={17} /></span>
        <h2 class="text-lg sm:text-xl font-bold text-ink">ابدأ من هنا</h2>
        <div class="flex-1 h-px bg-line"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {startHere.map((c) => (
          <div class="dash-card relative" data-card-id={c.id}>
            <span class="card-badge"></span>
            <a href={`${base}${c.path}`}
              class="group flex items-center gap-4 h-full rounded-card p-5 bg-surface border border-line shadow-card hover:bg-surface-2 hover:border-accent/40 hover:-translate-y-0.5 transition-all">
              <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 text-accent shrink-0"><Icon name={c.icon} size={24} /></span>
              <span class="flex-1 min-w-0">
                <span class="block font-bold text-ink">{c.title}</span>
                <span class="block text-xs text-muted mt-1 leading-relaxed">{c.desc}</span>
              </span>
              <span class="text-muted group-hover:text-accent text-xl transition-all group-hover:-translate-x-1">←</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    {/* ─── الأنظمة الرئيسية (الحاويات) ────────────────────────────────────── */}
    <section data-section data-group="hubs" class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-grid place-items-center w-8 h-8 rounded-lg bg-accent/10 border border-accent/25 text-accent"><Icon name="grid" size={17} /></span>
        <h2 class="text-lg sm:text-xl font-bold text-ink">الأنظمة الرئيسية</h2>
        <div class="flex-1 h-px bg-gradient-to-l from-accent/40 to-transparent"></div>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0 items-start">
        {hubs.map((h) => (
          <li class="dash-card relative" data-card-id={h.id} data-item-roles={h.roles || null}>
            <span class="card-badge"></span>
            <div class="h-full rounded-card p-5 bg-surface border border-line shadow-card hover:border-accent/40 transition-all">
              <div class="flex items-center gap-3 mb-1.5">
                <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-accent/10 border border-accent/25 text-accent shrink-0"><Icon name={h.icon} size={20} /></span>
                <h3 class="font-extrabold text-ink text-base leading-snug">{h.title}</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed mb-4">{h.desc}</p>
              <ul class="space-y-2 list-none p-0 m-0">
                {h.links.map((l) => (
                  <li data-item-roles={l.roles || null}>
                    <a href={`${base}${l.path}`}
                      class="group flex items-center gap-2.5 rounded-xl border border-line bg-chip hover:bg-surface-2 hover:border-accent/40 px-3 py-2.5 transition-all">
                      <Icon name={l.icon} size={16} class="text-muted group-hover:text-accent transition-colors" />
                      <span class="flex-1 text-sm font-bold text-ink-2 group-hover:text-ink transition-colors">{l.label}</span>
                      <span class="text-accent/60 group-hover:text-accent text-sm transition-colors">←</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}

        {/* بطاقة الاجتماعات — مفردة، بلا أحمر */}
        <li class="dash-card relative" data-card-id={meetingsCard.id} data-item-roles={meetingsCard.roles || null}>
          <span class="card-badge"></span>
          <a href={`${base}${meetingsCard.path}`}
            class="group block h-full rounded-card p-5 bg-surface border border-line shadow-card hover:bg-surface-2 hover:border-accent/40 hover:-translate-y-1 transition-all">
            <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-accent/10 border border-accent/25 text-accent mb-3"><Icon name={meetingsCard.icon} size={22} /></span>
            <h3 class="font-extrabold text-ink text-base mb-1.5 leading-snug">{meetingsCard.title}</h3>
            <p class="text-xs text-muted leading-relaxed">{meetingsCard.desc}</p>
            <span class="mt-4 inline-flex items-center gap-2 rounded-chip border border-line bg-chip px-4 py-1.5 text-sm text-ink-2 group-hover:border-accent/40 transition-colors">
              دخول ←
            </span>
          </a>
        </li>
      </ul>
    </section>

    {/* ─── الأقسام المجمّعة ──────────────────────────────────────────────── */}
    {groups.map((grp) => (
      <section data-section data-group={grp.id} class="mb-9">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-grid place-items-center w-8 h-8 rounded-lg bg-accent/10 border border-accent/25 text-accent"><Icon name={grp.icon} size={17} /></span>
          <h2 class="text-lg sm:text-xl font-bold text-ink">{grp.title}</h2>
          <div class="flex-1 h-px bg-line"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {grp.cards.map((c) => (
            <div class="dash-card relative" data-card-id={c.id}>
              <span class="card-badge"></span>
              <a href={`${base}${c.path}`}
                target={c.newtab ? '_blank' : null}
                rel={c.newtab ? 'noopener noreferrer' : null}
                class:list={[
                  'group block h-full rounded-card p-5 border shadow-card transition-all hover:-translate-y-1',
                  c.featured
                    ? 'bg-surface border-accent/30 hover:border-accent/50'
                    : 'bg-surface border-line hover:bg-surface-2 hover:border-accent/40',
                ]}>
                <div class="flex items-start justify-between mb-3">
                  <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-accent/10 border border-accent/25 text-accent"><Icon name={c.icon} size={20} /></span>
                  {c.newtab && (
                    <span class="text-[10px] text-muted border border-line rounded-chip px-2 py-0.5">↗ نافذة جديدة</span>
                  )}
                </div>
                <h3 class="font-bold text-ink mb-2">{c.title}</h3>
                <p class="text-sm text-muted leading-relaxed">{c.desc}</p>
              </a>
            </div>
          ))}
        </div>
      </section>
    ))}

    {/* ─── أنظمة قادمة ───────────────────────────────────────────────────── */}
    <section data-section data-group="soon" class="mb-9">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-grid place-items-center w-8 h-8 rounded-lg bg-chip border border-line text-muted"><Icon name="puzzle" size={17} /></span>
        <h2 class="text-lg sm:text-xl font-bold text-ink">أنظمة قادمة</h2>
        <div class="flex-1 h-px bg-line"></div>
        <span class="text-xs text-muted whitespace-nowrap">قيد التطوير</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {soon.map((c) => (
          <div class="dash-card relative" data-card-id={c.id}>
            <span class="card-badge"></span>
            <button type="button" class="soon-btn block w-full text-right h-full bg-chip border border-dashed border-line rounded-card p-5 cursor-not-allowed">
              <div class="flex items-start justify-between mb-3">
                <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-chip border border-line text-muted"><Icon name={c.icon} size={20} /></span>
                <span class="text-[10px] font-bold text-accent border border-accent/30 bg-accent/10 rounded-chip px-2 py-0.5">قريبًا</span>
              </div>
              <h3 class="font-bold text-ink-2 mb-2">{c.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{c.desc}</p>
            </button>
          </div>
        ))}
      </div>
    </section>

    {/* ─── التذييل ───────────────────────────────────────────────────────── */}
    <div class="text-center text-sm text-muted mt-8">
      إعداد: محمد البرشي — متخصص سلاسل الإمداد · بنغازي 2026 · غير تجاري
    </div>
  </div>

  {/* توست بسيط لبطاقات «قريباً» */}
  <div id="soon-toast" class="fixed bottom-6 inset-x-0 z-[80] hidden justify-center px-4 pointer-events-none">
    <div class="inline-flex items-center gap-2 rounded-xl bg-surface border border-accent/30 text-ink text-sm font-bold px-5 py-3 shadow-2xl">
      <Icon name="puzzle" size={16} class="text-accent" /> هذا النظام قيد التطوير — قريبًا
    </div>
  </div>

  <style>
    /* شارة الحالة أعلى البطاقة — تظهر فقط في وضع التخصيص */
    .dash-card .card-badge {
      position: absolute; top: .5rem; left: .5rem; z-index: 5;
      display: none; align-items: center; gap: .25rem;
      font-size: 11px; font-weight: 700; line-height: 1;
      padding: .3rem .55rem; border-radius: 9999px;
      pointer-events: none;
    }
    #dash-root.customizing .dash-card .card-badge { display: inline-flex; }
    .dash-card .card-badge.shown  { background: rgba(46,158,91,.15);  color: #86efac; border: 1px solid rgba(46,158,91,.4); }
    .dash-card .card-badge.hidden-b { background: rgba(148,163,184,.15); color: #cbd5e1; border: 1px solid rgba(148,163,184,.4); }

    /* في الوضع العادي: البطاقات المخفية لا تظهر */
    #dash-root:not(.customizing) .dash-card.is-hidden { display: none; }

    /* في وضع التخصيص: تظهر باهتة وقابلة للنقر لإعادتها */
    #dash-root.customizing .dash-card { cursor: pointer; outline: 1px dashed rgba(255,255,255,.18); outline-offset: 3px; border-radius: 1rem; }

    /* نسخ الثيم الفاتح (bz-light) — ألوان الشارات أعلاه محسوبة على الداكن */
    :global(html.bz-light) .dash-card .card-badge.shown    { background: rgba(46,158,91,.12);   color: #1e7c47; border-color: rgba(46,158,91,.45); }
    :global(html.bz-light) .dash-card .card-badge.hidden-b { background: rgba(100,116,139,.12); color: #475569; border-color: rgba(100,116,139,.45); }
    :global(html.bz-light) #dash-root.customizing .dash-card { outline-color: rgba(33,37,41,.25); }
    #dash-root.customizing .dash-card.is-hidden { opacity: .4; }
    #dash-root.customizing .dash-card a,
    #dash-root.customizing .dash-card button { pointer-events: none; }
  </style>

  <script is:inline>
    (function () {
      'use strict';
      var root = document.getElementById('dash-root');
      if (!root) return;

      var KEY = 'bz-dash-hidden-v1';
      var cards = Array.prototype.slice.call(root.querySelectorAll('.dash-card'));
      var sections = Array.prototype.slice.call(root.querySelectorAll('[data-section]'));

      function load() {
        try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); }
        catch { return new Set(); }
      }
      function save(set) {
        try { localStorage.setItem(KEY, JSON.stringify(Array.from(set))); }
        catch { /* التخزين غير متاح — نتجاهل */ }
      }
      var hidden = load();

      function refresh() {
        var count = 0;
        cards.forEach(function (c) {
          var isHidden = hidden.has(c.getAttribute('data-card-id'));
          c.classList.toggle('is-hidden', isHidden);
          if (isHidden) count++;
          var badge = c.querySelector('.card-badge');
          if (badge) {
            badge.textContent = isHidden ? 'مخفية' : 'ظاهرة';
            badge.classList.toggle('hidden-b', isHidden);
            badge.classList.toggle('shown', !isHidden);
          }
        });

        // إخفاء رأس أي قسم لا يحوي بطاقة ظاهرة (في الوضع العادي فقط)
        var customizing = root.classList.contains('customizing');
        sections.forEach(function (s) {
          if (customizing) { s.style.display = ''; return; }
          var anyVisible = Array.prototype.some.call(
            s.querySelectorAll('.dash-card'),
            function (c) { return !hidden.has(c.getAttribute('data-card-id')); }
          );
          s.style.display = anyVisible ? '' : 'none';
        });

        var hc = document.getElementById('hidden-count');
        if (hc) hc.textContent = count ? (count + ' بطاقة مخفية') : 'لا بطاقات مخفية';
      }

      // تبديل بطاقة عند النقر في وضع التخصيص
      cards.forEach(function (c) {
        c.addEventListener('click', function (e) {
          if (!root.classList.contains('customizing')) return;
          e.preventDefault();
          var id = c.getAttribute('data-card-id');
          if (hidden.has(id)) hidden.delete(id); else hidden.add(id);
          save(hidden);
          refresh();
        });
      });

      // زر التخصيص
      var btn = document.getElementById('btn-customize');
      var actions = document.getElementById('customize-actions');
      var hint = document.getElementById('customize-hint');
      var label = document.getElementById('btn-customize-label');
      function setCustomizing(on) {
        root.classList.toggle('customizing', on);
        if (actions) actions.classList.toggle('hidden', !on);
        if (actions) actions.classList.toggle('flex', on);
        if (hint) hint.classList.toggle('hidden', !on);
        if (label) label.textContent = on ? 'إنهاء التخصيص' : 'تخصيص العرض';
        refresh();
      }
      if (btn) btn.addEventListener('click', function () {
        setCustomizing(!root.classList.contains('customizing'));
      });
      var done = document.getElementById('btn-done');
      if (done) done.addEventListener('click', function () { setCustomizing(false); });
      var showAll = document.getElementById('btn-showall');
      if (showAll) showAll.addEventListener('click', function () {
        hidden.clear(); save(hidden); refresh();
      });

      // توست بطاقات «قريباً»
      var toast = document.getElementById('soon-toast');
      var toastTimer;
      root.querySelectorAll('.soon-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          if (root.classList.contains('customizing') || !toast) return;
          toast.classList.remove('hidden');
          toast.classList.add('flex');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toast.classList.add('hidden');
            toast.classList.remove('flex');
          }, 2200);
        });
      });

      refresh();
    })();
  </script>
</DashboardLayout>
