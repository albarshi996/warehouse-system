---
/**
 * ماستر العملاء (§15.3) — توأم ماستر الموردين بنفس المحرّك (kind='customer').
 * قائمة + إضافة/تعديل + استيراد Excel بمعاينة + أرشفة (لا حذف). للمديرَين.
 * ربط كل بيع بمعرّف العميل لا بالاسم النصّي (§15.3).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PartnerMaster from '../../components/brandzo-erp/partners/PartnerMaster.jsx';
---

<DashboardLayout title="ماستر العملاء" showGuide={false}>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">👥 ماستر العملاء</h1>
      <p class="text-gray-300 text-sm leading-relaxed max-w-3xl">
        مصدرٌ واحدٌ لبيانات العملاء — رمزٌ فريدٌ لكلّ عميل بدل الاسم النصّي، مع
        الاستيراد من شيت Excel. توأم ماستر الموردين بنيةً ومحرّكًا. الأرصدة
        <span class="text-brand-gold font-bold">افتتاحيّة للعرض</span>، و<span class="text-brand-gold font-bold">لا حذف</span> — أرشفة فقط.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <PartnerMaster kind="customer" client:load />
  </div>
</DashboardLayout>
