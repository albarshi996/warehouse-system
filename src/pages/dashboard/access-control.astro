---
/**
 * الصلاحيات والأدوار — **محرر الصلاحيات الفعلي** (المحور ٢-ب، 2026-08-02).
 * شبكة (الأدوار الاثنا عشر × شاشات الكتالوج) يحرّرها المدير العام وتُحفظ في
 * `access_control/matrix` فتسري فورًا على فتح الصفحات والقائمة الجانبية.
 * كانت قبل ذلك عرضًا توثيقيًّا ساكنًا لا يُنفَّذ منه شيء.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/tokens.css';
import '../../styles/odoo.css';
import AccessControlHub from '../../components/brandzo-erp/access/AccessControlHub.jsx';
---

<DashboardLayout title="الصلاحيات والأدوار" showGuide={false} light>
  <div class="text-right" dir="rtl">
    <div class="mb-4">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-2">الصلاحيات والأدوار</h1>
      <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
        تحكّم دقيق قابل للتنفيذ: افتح أو احجب أي شاشة لأي دور، بطبقة تجاوزات فوق
        كتالوج القائمة تسري فورًا على البوابة كلها. التوثيق المقروء للأدوار في
        «المرجع التشغيلي الرسمي — فصل أدوار البوابة» (مولَّد من هذا الكود نفسه).
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <AccessControlHub client:load />
  </div>
</DashboardLayout>
