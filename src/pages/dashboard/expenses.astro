---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ExpensesBoard from '../../components/brandzo-erp/ledger/ExpensesBoard.jsx';
---

<DashboardLayout title="المصاريف المبوّبة" light>
  <div class="text-right" dir="rtl">
    <h1 class="text-2xl font-bold text-ink mb-1 no-print">المصاريف — تسجيلٌ بالفاتورة وتقريرٌ يُطبع</h1>
    <p class="text-sm text-ink-2 mb-5 no-print">
      سجّل مصروفًا بالفاتورة بخطوةٍ واحدة (يُقيَّد فورًا)، واطبع تقريرَ المصروفات أو صدّره إكسل —
      كلُّه معزولٌ بالمحلّ. والرواتبُ والسلفُ والتشغيلُ تظهر في «المصروف لكلّ فئة» أدناه.
    </p>
    <ExpensesBoard client:load />
  </div>
</DashboardLayout>
