---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ExpensesBoard from '../../components/brandzo-erp/ledger/ExpensesBoard.jsx';
---

<DashboardLayout title="المصاريف المبوّبة" light>
  <div class="text-right" dir="rtl">
    <h1 class="text-2xl font-bold text-ink mb-1">المصاريف المبوّبة والرواتب والسلف</h1>
    <p class="text-sm text-ink-2 mb-5">
      تقريرٌ نظيفٌ لكلّ فئة — إيجارٌ وصيانةٌ ونظافةٌ وتشغيلٌ ورواتب — معزولٌ بالمحلّ.
      تُنشأ المستنداتُ من «بدء مستند جديد»، وتُقيَّد في دفتر الجهاز عند إنجازها، فيظهر أثرُها هنا.
    </p>
    <ExpensesBoard client:load />
  </div>
</DashboardLayout>
