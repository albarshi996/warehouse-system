---
/**
 * الرقابة على الطلبات — التقريران الرقابيان لدورة المبيعات.
 *
 * لماذا وُجدت؟ لأن أمر البيع صار يحجز الرصيد ويسجّل العجز — فحوّلنا ذلك إلى
 * قرار: تقرير الطلبات المعلّقة (لماذا لم يُنفَّذ كل طلب؟) وتقرير الأصناف غير
 * المتوفّرة (ماذا نشتري؟ بقيمته المفقودة ومتوسط طلبه الشهري وآخر نفاد).
 *
 * القاعدة الذهبية: لا حذف — صفحة ومكوّن جديدان (ledger/OrderControlBoard).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import OrderControlBoard from '../../components/brandzo-erp/ledger/OrderControlBoard.jsx';
---

<DashboardLayout title="الرقابة على الطلبات" showGuide={false}>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">📋 الرقابة على الطلبات</h1>
      <p class="text-gray-300 text-sm leading-relaxed max-w-3xl">
        كل طلبٍ لم يُنفَّذ له <span class="text-brand-gold font-bold">سببٌ ظاهر</span>: أهو رصيدٌ ناقص أم تنفيذٌ
        متعثّر؟ راقب الطلبات المعلّقة مصنّفةً بالرصيد وسبب التوقّف، واقرأ الأصناف غير المتوفّرة
        بقيمتها المفقودة ومتوسط طلبها الشهري — إشارةَ شراءٍ مسبَّبة لا شكوى.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <OrderControlBoard client:load />
  </div>
</DashboardLayout>
