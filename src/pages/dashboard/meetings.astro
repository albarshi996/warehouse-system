---
/**
 * الاجتماعات ومحاضرها — أداةُ محاضر موحّدة، يدويّةٌ بالكامل.
 *
 * أُعيدت صياغة هذه الصفحة (2026-08-04): كانت نظامَين متوازيَين — اجتماعاتٌ
 * سبعٌ مبذورةٌ ثابتة (vanilla-JS) + جزيرةُ اجتماعاتٍ جماعية — فيصطدمان بصريًّا
 * ويربكان. الآن سطحٌ واحدٌ (`MeetingsApp`): كلّ اجتماعٍ يُنشأ يدويًّا (عنوان ·
 * إدارات/كيانات تُختار أو تُكتب حرّةً · بنودٌ بخطّ اليد)، والاجتماعات السبعة
 * صارت **قوالب** يبدأ منها المالك بنقرة. والهوية صارت الهوية المعتمدة (bz-light،
 * بنفسجيّ `#714B67`، بلا إيموجي، الأحمر للتحذير وحده) عبر توكِنز `var(--color-*)`.
 *
 * القشرة رفيعة: أنماط المكوّن والمستندات المطبوعة + جزيرة React + مضيف الطباعة.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import MeetingsApp from '../../components/brandzo-erp/meetings/MeetingsApp.jsx';
---

<DashboardLayout title="Brandzo | الاجتماعات ومحاضرها" light>

<style is:inline>
  /* ═══════════ لوحة الهوية المعتمدة (bz-light) ═══════════
     كل الألوان من توكِنز global.css التي تنقلب للفاتح تحت html.bz-light:
     --color-accent = #714B67 (الهوية) · --color-surface = أبيض · --color-ink
     للنصّ · --color-line للحدود. الأخضر/الكهرمانيّ/الأحمر دلاليّة، والأحمر
     للتحذير وحده. */
  .gm-wrap, .gm-room { direction: rtl; font-family: inherit; color: var(--color-ink); }

  /* رأس الصفحة */
  .mt-hero { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 14px; box-shadow: var(--shadow-card); padding: 20px 24px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; flex-wrap: wrap; }
  .mt-hero-in { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; flex: 1; min-width: 260px; }
  .mt-hero h2 { font-size: 1.35rem; font-weight: 800; color: var(--color-ink); }
  .mt-hero p { color: var(--color-ink-2); font-size: .86rem; margin-top: 5px; max-width: 640px; line-height: 1.8; }
  .mt-kpis { display: flex; gap: 9px; flex-wrap: wrap; }
  .mt-kpi { background: var(--color-chip); border: 1px solid var(--color-line); border-radius: 12px; padding: 9px 15px; text-align: center; min-width: 78px; }
  .mt-kpi .n { display: block; font-size: 1.4rem; font-weight: 800; color: var(--color-accent); line-height: 1.15; }
  .mt-kpi .l { font-size: .7rem; color: var(--color-ink-2); margin-top: 2px; }
  .mt-kpi.alert .n { color: #b02a37; }
  .mt-hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* البطاقات */
  .kcard { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 14px; box-shadow: var(--shadow-card); overflow: hidden; margin-bottom: 14px; }
  .kchead { background: var(--color-surface); border-bottom: 1px solid var(--color-line-strong); padding: 12px 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .kchead h3 { color: var(--color-ink); font-size: .98rem; font-weight: 800; }
  .kchead-hint { color: var(--color-ink-2); font-size: .76rem; }
  .kchead-lead { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .kcbody { padding: 16px 18px; }
  .kempty { text-align: center; padding: 26px 16px; color: var(--color-ink-2); font-size: .9rem; }

  /* أزرار */
  .kbtn { padding: 8px 15px; border-radius: 9px; border: 1px solid transparent; cursor: pointer; font-family: inherit; font-size: .83rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; transition: all .18s; white-space: nowrap; }
  .kbtn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(20,20,40,.10); }
  .kbtn:disabled { opacity: .45; cursor: not-allowed; }
  .kbtn.sm { padding: 6px 12px; font-size: .78rem; }
  .b-accent { background: var(--color-accent); color: #fff; }
  .b-accent:hover:not(:disabled) { background: #5d3e55; }
  .b-ok { background: #1e7c47; color: #fff; }
  .b-ok:hover:not(:disabled) { background: #17663a; }
  .b-navy { background: #ede8ec; color: var(--color-accent); border-color: rgba(113,75,103,.22); }
  .b-navy:hover:not(:disabled) { background: #e3dbe1; }
  .b-ghost { background: var(--color-surface-2); color: var(--color-ink-2); border-color: var(--color-line-strong); }
  .b-ghost:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent); }
  .mini { border: 1px solid var(--color-line-strong); background: var(--color-surface); border-radius: 8px; padding: 5px 11px; font-family: inherit; font-size: .76rem; font-weight: 700; cursor: pointer; color: var(--color-ink); }
  .mini:hover { border-color: var(--color-accent); background: var(--color-chip); color: var(--color-accent); }

  /* رقائق الاختيار (الإدارات/الحالات/القوالب) */
  .chips { display: flex; gap: 7px; flex-wrap: wrap; }
  .chip { border: 1.5px solid var(--color-line-strong); background: var(--color-surface); border-radius: 18px; padding: 5px 13px; font-family: inherit; font-size: .78rem; font-weight: 700; cursor: pointer; color: var(--color-ink-2); transition: all .15s; display: inline-flex; align-items: center; gap: 6px; }
  .chip:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent); }
  .chip:disabled { opacity: .55; cursor: default; }
  .chip.on { color: #fff; border-color: var(--color-accent); background: var(--color-accent); }
  .chip.tpl:hover { background: var(--color-chip); }
  .chip.entity { cursor: default; }
  .chip-x { background: rgba(255,255,255,.25); border: none; color: #fff; border-radius: 50%; width: 16px; height: 16px; font-size: .62rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .entity-add { display: flex; gap: 7px; margin-top: 9px; flex-wrap: wrap; }
  .entity-add input { flex: 1; min-width: 220px; border: 1.5px solid var(--color-line-strong); border-radius: 8px; padding: 7px 11px; font-family: inherit; font-size: .84rem; background: var(--color-surface); color: var(--color-ink); }
  .entity-add input:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(113,75,103,.12); }

  /* شبكة بطاقات الاجتماعات */
  .mgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px,1fr)); gap: 11px; margin-bottom: 16px; }
  .mcard { text-align: right; background: var(--color-surface); border: 1.5px solid var(--color-line-strong); border-radius: 13px; padding: 13px 15px; cursor: pointer; font-family: inherit; box-shadow: var(--shadow-card); transition: all .18s; }
  .mcard:hover { border-color: var(--color-accent); transform: translateY(-2px); box-shadow: var(--shadow-card-hover); }
  .mc-top { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; }
  .mc-dept { font-size: .9rem; font-weight: 800; color: var(--color-ink); }
  .mc-state { font-size: .75rem; font-weight: 700; margin-bottom: 7px; }
  .mc-bar { height: 5px; background: var(--color-surface-2); border-radius: 3px; overflow: hidden; margin-bottom: 6px; }
  .mc-bar span { display: block; height: 100%; background: var(--color-accent); }
  .mc-meta { font-size: .7rem; color: var(--color-ink-2); }

  /* الحقول */
  .fld { display: flex; flex-direction: column; gap: 4px; }
  .fld label { font-size: .74rem; font-weight: 800; color: var(--color-ink-2); }
  .fld input, .fld select, .fld textarea { border: 1.5px solid var(--color-line-strong); border-radius: 9px; padding: 8px 11px; font-family: inherit; font-size: .88rem; background: var(--color-surface); color: var(--color-ink); width: 100%; }
  .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(113,75,103,.12); }
  .fld input:disabled, .fld textarea:disabled { background: var(--color-surface-2); color: var(--color-ink-2); }
  .fld input.ro { background: var(--color-chip); font-weight: 800; color: var(--color-accent); }
  .fld textarea { resize: vertical; min-height: 56px; }
  .frow { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; }
  @media (max-width: 860px) { .frow { grid-template-columns: 1fr 1fr; } }

  /* البنود */
  .item { border: 1.5px solid var(--color-line-strong); border-radius: 13px; margin-bottom: 11px; overflow: hidden; }
  .item.st-agreed { border-color: rgba(30,124,71,.5); }
  .item.st-escalate { border-color: rgba(176,42,55,.5); }
  .item.st-deferred { border-color: rgba(154,107,1,.5); }
  .it-head { background: var(--color-surface-2); padding: 9px 14px; display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .it-n { background: var(--color-accent); color: #fff; border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: .72rem; font-weight: 800; flex-shrink: 0; }
  .gm-item-title { flex: 1; min-width: 120px; border: 1.5px solid var(--color-line-strong); border-radius: 8px; padding: 6px 10px; font-family: inherit; font-size: .9rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); }
  .gm-item-title:disabled { background: var(--color-surface-2); color: var(--color-ink-2); }
  .it-body { padding: 13px 15px; border-top: 1px solid var(--color-line); }
  .iact { border: 1.5px solid var(--color-line-strong); background: var(--color-surface); border-radius: 7px; padding: 3px 11px; font-family: inherit; font-size: .76rem; font-weight: 700; cursor: pointer; color: var(--color-ink-2); }
  .iact.del:hover { border-color: #b02a37; background: #fdecec; color: #b02a37; }

  /* الأشخاص */
  .people-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 760px) { .people-grid { grid-template-columns: 1fr; } }
  .people-lbl { font-size: .74rem; font-weight: 800; color: var(--color-ink-2); }
  .prow { border: 1.5px solid var(--color-line-strong); border-radius: 10px; padding: 8px 12px; margin-bottom: 7px; display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 8px; align-items: center; }
  @media (max-width: 720px) { .prow { grid-template-columns: 1fr 1fr; } }
  .prow input { border: 1.5px solid var(--color-line-strong); border-radius: 8px; padding: 6px 10px; font-family: inherit; font-size: .84rem; background: var(--color-surface); color: var(--color-ink); }
  .prow input:disabled { background: var(--color-surface-2); }

  /* أزرار المحضر أسفل الغرفة */
  .mt-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .mt-actions-info { flex: 1; min-width: 180px; font-size: .82rem; color: var(--color-ink-2); }

  /* شارة الحفظ السحابيّ */
  .kchip { display: inline-flex; align-items: center; gap: 7px; background: var(--color-chip); border: 1px solid var(--color-line-strong); color: var(--color-ink-2); border-radius: 20px; padding: 5px 13px; font-size: .76rem; font-weight: 700; }
  .kchip .dot { width: 9px; height: 9px; border-radius: 50%; background: #9aa0aa; }
  .kchip.online .dot { background: #1e7c47; }
  .kchip.pending .dot { background: #9a6b01; }
  .kchip.dirty .dot { background: #b02a37; }

  /* المسجّل */
  .rec-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .rec-btn { width: 54px; height: 54px; border-radius: 50%; border: none; cursor: pointer; background: var(--color-accent); color: #fff; box-shadow: 0 6px 16px rgba(113,75,103,.28); transition: all .18s; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; }
  .rec-btn:hover:not(:disabled) { transform: translateY(-2px); }
  .rec-btn:disabled { opacity: .45; cursor: not-allowed; }
  .rec-btn.live { animation: recPulse 1.4s infinite; background: #b02a37; }
  @keyframes recPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(176,42,55,.4); } 50% { box-shadow: 0 0 0 12px rgba(176,42,55,0); } }
  .rec-meta { display: flex; flex-direction: column; min-width: 76px; }
  .rec-time { font-family: 'Cairo',monospace; font-size: 1.3rem; font-weight: 900; color: var(--color-ink); line-height: 1.1; }
  .rec-dot-lbl { font-size: .74rem; color: var(--color-ink-2); font-weight: 700; }
  .rec-transcript { background: var(--color-surface-2); border: 1.5px solid var(--color-line-strong); border-radius: 10px; padding: 12px 14px; min-height: 90px; max-height: 260px; overflow-y: auto; font-size: .88rem; line-height: 1.85; color: var(--color-ink); }
  .rec-empty { color: var(--color-ink-2); font-style: italic; }
  .rec-n { color: var(--color-accent); font-weight: 700; font-size: .72rem; }

  /* التوست */
  .toastw { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 999; display: flex; flex-direction: column; gap: 8px; align-items: center; }
  .toast { background: var(--color-ink); color: #fff; padding: 11px 22px; border-radius: 12px; font-size: .88rem; font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.25); border-right: 4px solid var(--color-accent); max-width: min(600px,92vw); white-space: pre-line; }

  /* النافذة الحوارية */
  .dlg { position: fixed; inset: 0; z-index: 400; background: rgba(31,36,48,.42); display: none; align-items: center; justify-content: center; padding: 16px; }
  .dlg.on { display: flex; }
  .dlgbox { background: var(--color-surface); border-radius: 16px; width: min(620px,100%); max-height: 92vh; overflow: auto; box-shadow: 0 26px 70px rgba(0,0,0,.3); }
  .dlgbox.wide { width: min(920px,100%); }
  .dlghead { position: sticky; top: 0; background: var(--color-surface); border-bottom: 1px solid var(--color-line-strong); color: var(--color-ink); padding: 13px 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px; z-index: 2; }
  .dlghead h3 { font-size: .98rem; font-weight: 800; }
  .dlgbody { padding: 15px 18px; display: flex; flex-direction: column; gap: 11px; }
  .dlgfoot { padding: 0 18px 16px; display: flex; gap: 8px; justify-content: flex-start; flex-wrap: wrap; }
  .dlgwarn { background: #fdf6e6; border: 1px solid #ecd9a4; color: #7a5b12; border-radius: 10px; padding: 8px 13px; font-size: .8rem; line-height: 1.7; }

  /* لوحة التقرير المجمّع */
  .mt-report-note { font-size: .84rem; line-height: 1.85; color: var(--color-ink-2); }
  .rpactions { display: flex; gap: 8px; flex-wrap: wrap; }
  .rpreview { border: 1px solid var(--color-line-strong); border-radius: 12px; max-height: 60vh; overflow: auto; background: var(--color-surface-2); padding: 10px; display: none; }
  .rpreview.on { display: block; }
  .rpreview .doc { transform: scale(.94); transform-origin: top center; }

  /* ═══════════ وضع العرض (شرائح ملء الشاشة) ═══════════ */
  .mt-present { position: fixed; inset: 0; z-index: 500; background: linear-gradient(160deg,#faf7f9,#f1edf0); display: flex; flex-direction: column; }
  .mt-stage { flex: 1; overflow: auto; padding: 34px 40px 100px; display: flex; justify-content: center; }
  .mt-present .slide { max-width: 1000px; width: 100%; background: var(--color-surface); border: 1px solid var(--color-line-strong); border-radius: 18px; box-shadow: 0 18px 50px rgba(20,20,40,.12); padding: 30px 38px; align-self: flex-start; }
  .sl-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .sl-count { background: var(--color-accent); color: #fff; border-radius: 16px; padding: 3px 14px; font-size: .85rem; font-weight: 800; }
  .sl-dept { color: var(--color-ink-2); font-size: .95rem; font-weight: 700; }
  .sl-draft { background: #fdf6e6; color: #7a5b12; border: 1px dashed #d8b24a; border-radius: 12px; padding: 2px 10px; font-size: .72rem; font-weight: 700; }
  .sl-title { font-size: clamp(1.4rem,3vw,2.3rem); font-weight: 900; color: var(--color-ink); margin-bottom: 20px; line-height: 1.4; border-right: 5px solid var(--color-accent); padding-right: 16px; }
  .sl-box { background: var(--color-surface-2); border: 1px solid var(--color-line); border-radius: 14px; padding: 15px 20px; margin-bottom: 12px; }
  .sl-box h4 { font-size: .82rem; font-weight: 800; letter-spacing: .5px; margin-bottom: 8px; color: var(--color-accent); }
  .sl-box p { font-size: clamp(1rem,1.6vw,1.3rem); line-height: 1.85; color: var(--color-ink); margin-bottom: 6px; }
  .sl-box p:last-child { margin-bottom: 0; }
  .sl-box.ask { border-right: 4px solid var(--color-accent); }
  .sl-box.why { border-right: 4px solid #3d6ea8; }
  .sl-box.them { border-right: 4px solid #8a6b80; }
  .sl-box.decided { border-right: 4px solid #1e7c47; background: rgba(30,124,71,.08); }
  .sl-nav { position: fixed; bottom: 0; inset-inline: 0; background: var(--color-surface); border-top: 1px solid var(--color-line-strong); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; z-index: 3; box-shadow: 0 -4px 18px rgba(20,20,40,.06); }
  .sl-prog { flex: 1; height: 6px; background: var(--color-surface-2); border-radius: 3px; overflow: hidden; min-width: 120px; }
  .sl-prog span { display: block; height: 100%; background: var(--color-accent); transition: width .2s; }
  .sl-hint { color: var(--color-ink-2); font-size: .72rem; font-weight: 600; }
  @media (max-width: 720px) { .sl-hint { display: none; } }

  /* ═══════════ المستندات المطبوعة (المحضر · التقرير) ═══════════
     ورقةٌ بيضاء رسميّة بصبغة الهوية البنفسجيّة بدل الذهبي. */
  #docPrint { position: absolute; left: -12000px; top: 0; direction: rtl; }
  .doc { width: 210mm; min-height: 297mm; background: #fff; box-sizing: border-box; padding: 14mm 16mm; font-family: 'Tajawal','Cairo',sans-serif; color: #1f2430; }
  .d-head { display: flex; justify-content: space-between; align-items: center; border-bottom: .8mm solid #714B67; padding-bottom: 3.5mm; margin-bottom: 5mm; }
  .d-logo { background: #714B67; color: #fff; border-radius: 3mm; padding: 2.5mm 6mm; font-family: 'Cairo',sans-serif; font-weight: 900; font-size: 13pt; }
  .d-t { text-align: center; }
  .d-t h1 { font-size: 14pt; font-weight: 900; color: #1f2430; }
  .d-t .en { font-size: 7.5pt; color: #6b7280; }
  .d-ref { border: .3mm solid #714B67; background: #f7f2f6; border-radius: 2mm; padding: 1.5mm 4mm; font-size: 8.5pt; font-weight: 900; font-family: 'Cairo',sans-serif; text-align: center; white-space: nowrap; }
  .d-grid { display: grid; grid-template-columns: auto 1fr auto 1fr; border: .3mm solid #d4d4dc; border-radius: 2mm; overflow: hidden; margin-bottom: 4mm; }
  .d-grid .cell { padding: 2mm 3.5mm; font-size: 9pt; border-bottom: .2mm solid #e8e8ee; }
  .d-grid .cell.lbl { background: #f7f2f6; font-weight: 800; color: #5d3e55; white-space: nowrap; }
  .d-goal { background: #f7f2f6; border-right: 1mm solid #714B67; padding: 2.5mm 4mm; font-size: 9pt; margin-bottom: 4mm; }
  .d-h { font-size: 10.5pt; font-weight: 900; color: #1f2430; border-right: 1mm solid #714B67; padding-right: 3mm; margin: 5mm 0 2.5mm; }
  .d-att { list-style: none; font-size: 9pt; }
  .d-att li { padding: 1.2mm 0; border-bottom: .2mm dotted #e8e8ee; }
  .d-att i { color: #5d3e55; font-style: normal; font-size: 8pt; }
  .d-tbl { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
  .d-tbl th { background: #714B67; color: #fff; padding: 2mm 2.5mm; text-align: right; font-size: 8pt; font-weight: 700; }
  .d-tbl td { padding: 2mm 2.5mm; border-bottom: .2mm solid #e8e8ee; vertical-align: top; }
  .d-tbl .d-n { text-align: center; font-weight: 800; color: #5d3e55; width: 8mm; }
  .d-tbl .d-c { text-align: center; white-space: nowrap; }
  .d-disc { color: #6b7280; font-size: 7.5pt; margin-top: 1mm; }
  .d-muted { color: #9aa0aa; }
  .d-warn { background: #fdecec; border-right: 1mm solid #b02a37; padding: 2.5mm 4mm; font-size: 8.5pt; margin-top: 4mm; }
  .d-outcome { background: #f7f2f6; border: .3mm solid #714B67; border-radius: 2mm; padding: 3mm 4mm; font-size: 8.5pt; line-height: 1.8; margin-top: 5mm; }
  .d-sigs { display: grid; grid-template-columns: repeat(auto-fit,minmax(55mm,1fr)); gap: 10mm; margin-top: 12mm; }
  .d-sig { text-align: center; font-size: 9pt; position: relative; }
  .d-sig .sig-img { position: absolute; top: -2mm; left: 50%; transform: translateX(-50%); height: 17mm; max-width: 90%; object-fit: contain; z-index: 2; }
  .d-sig .line { border-bottom: .3mm dashed #9aa0aa; height: 14mm; margin-bottom: 1.5mm; }
  .d-sig b { display: block; font-size: 9.5pt; }
