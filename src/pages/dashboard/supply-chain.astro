---
/**
 * لوحة سلاسل الإمداد التنفيذية — المرجع التشغيلي ٤-٣ (Executive Dashboard).
 *
 * شاشة واحدة للإدارة العليا تجمع لحظيًّا (onSnapshot):
 *   - حالة الأسطول الفوري: في الطريق / متوقفة / في الصيانة.
 *   - POD% (هدف 100%) و OTIF (هدف ≥95%) وتنبيهات انحراف الوقود.
 *   - أوامر الشغل المفتوحة + العالي الخطورة + MTTR (هدف ≤2 ساعة).
 *   - العُهد النشطة وقيمتها.
 *   - تنبيهات انتهاء الصلاحية خلال 7/30 يومًا من مخزن الأرصدة (FEFO).
 *
 * الوصول: المديران (رابط القائمة مقيّد + حارس ذاتي في الصفحة).
 *
 * الواجهة (لمسة أودو): مبنيّة على مكوّنات لوحة اللوجستيات الفاتحة نفسها —
 * حاوية .o_theme + بطاقات o_kpi وأقسام o_dashboard وجداول o_list_view وشارات
 * o_badge. حوكمة الواجهة: بلا إيموجي · الأحمر للتنبيه فقط · أيقونات SVG خطّية.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/tokens.css';
import '../../styles/odoo.css';
import Icon from '../../components/ui/Icon.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

// أزرار الدخول لصفحات مجموعة «سلاسل الإمداد والحركة» من داخل اللوحة التنفيذية.
const scLinks = [
  { href: `${base}/dashboard/fleet-operations`, icon: 'truck', label: 'عمليات الأسطول' },
  { href: `${base}/dashboard/maintenance-center`, icon: 'wrench', label: 'مركز الصيانة' },
  { href: `${base}/dashboard/custody`, icon: 'handshake', label: 'العُهد العينية' },
  { href: `${base}/dashboard/vehicles-inventory`, icon: 'car', label: 'جرد المركبات' },
];
---

<DashboardLayout title="Brandzo | لوحة سلاسل الإمداد" light>
<style is:inline>
  /* مخصّصات اللوحة — كلّها معزولة تحت .o_theme وبتوكِنز أودو (var(--o-*)) فقط. */
  .o_theme .o_sc_head { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
  .o_theme .o_sc_title { font-size: 22px; font-weight: var(--o-font-weight-bold); color: var(--o-main-text-color); margin: 0; }
  .o_theme .o_sc_sub { font-size: var(--o-font-size-sm); color: var(--o-main-color-muted); margin: 5px 0 0; line-height: 1.6; }
  .o_theme .o_live_badge { display: inline-flex; align-items: center; gap: 8px; background: var(--o-badge-success-bg); color: var(--o-text-success); border: 1px solid #cfe8d6; border-radius: 20px; padding: 6px 14px; font-size: var(--o-font-size-xs); font-weight: var(--o-font-weight-bold); white-space: nowrap; }
  .o_theme .o_live_badge .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--o-success); animation: o_scpulse 2s infinite; }
  @keyframes o_scpulse { 50% { opacity: 0.35; } }

  .o_theme .o_fleet_strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(138px, 1fr)); gap: 12px; padding: 16px; }
  .o_theme .o_fchip { text-align: center; border: 1px solid var(--o-border-color); border-radius: var(--o-border-radius-lg); padding: 14px 10px; background: var(--o-view-background); box-shadow: var(--o-shadow-sm); }
  .o_theme .o_fchip .n { font-size: 26px; font-weight: var(--o-font-weight-bold); line-height: 1.1; color: var(--o-main-text-color); font-variant-numeric: tabular-nums; }
  .o_theme .o_fchip .l { font-size: var(--o-font-size-xs); color: var(--o-main-color-muted); margin-top: 5px; font-weight: var(--o-font-weight-medium); }
  .o_theme .o_fchip.is-danger .n { color: var(--o-text-danger); }
  .o_theme .o_fchip.is-warn .n { color: var(--o-text-warning); }
  .o_theme .o_fchip.is-ok .n { color: var(--o-text-success); }
  .o_theme .o_fchip.is-info .n { color: var(--o-text-info); }

  .o_theme .o_sc_row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 10px 14px; font-size: var(--o-font-size-sm); color: var(--o-main-text-color); }
  .o_theme .o_sc_row + .o_sc_row { border-top: 1px solid var(--o-gray-200); }
  .o_theme .o_sc_row .meta { color: var(--o-main-color-muted); font-size: var(--o-font-size-xs); }
  .o_theme .o_sc_row .lead { font-weight: var(--o-font-weight-bold); }
  .o_theme .o_sc_row.is-danger .lead { color: var(--o-text-danger); }
  .o_theme .o_sc_row.is-warn .lead { color: var(--o-text-warning); }
  .o_theme .o_sc_bar { flex: 1; min-width: 90px; height: 8px; background: var(--o-gray-200); border-radius: 4px; overflow: hidden; }
  .o_theme .o_sc_bar > span { display: block; height: 100%; background: var(--o-action); border-radius: 4px; }
</style>

<div class="o_theme" dir="rtl">
  <div id="deniedView" class="o_dashboard" style="display:none">
    <div class="o_dashboard_empty">لوحة سلاسل الإمداد التنفيذية متاحة للمدير العام ومدير المستودع فقط.</div>
  </div>

  <div id="dashView" class="o_dashboard" style="display:none">
    <div class="o_sc_head">
      <div>
        <h1 class="o_sc_title">لوحة سلاسل الإمداد التنفيذية</h1>
        <p class="o_sc_sub">أسطول · صيانة · عُهد · صلاحيات — لحظيًّا من قاعدة البيانات الحية (المرجع ٤-٣)</p>
      </div>
      <span class="o_live_badge"><span class="dot"></span> بث مباشر</span>
    </div>

    <!-- روابط سريعة لصفحات سلاسل الإمداد والحركة -->
    <div class="o_dashboard_links" style="margin-bottom:22px">
      {scLinks.map((l) => (
        <a class="o_quicklink" href={l.href}>
          <Icon name={l.icon} size={16} /> {l.label}
        </a>
      ))}
    </div>

    <!-- المؤشّرات التنفيذيّة -->
    <div class="o_dashboard_kpis">
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="truck" size={20} /></span><span class="o_kpi_value" id="xEnroute">0</span><span class="o_kpi_label">رحلات في الطريق الآن</span><span class="o_kpi_sub">حالة الأسطول الفوري</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="checkCircle" size={20} /></span><span class="o_kpi_value" id="xPod">—</span><span class="o_kpi_label">الشحنات الموثّقة POD</span><span class="o_kpi_sub">الهدف: 100% — صفر تسليم بلا توثيق</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="target" size={20} /></span><span class="o_kpi_value" id="xOtif">—</span><span class="o_kpi_label">OTIF — في الوقت</span><span class="o_kpi_sub">الهدف: ≥95% أسبوعيًّا</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="alertTriangle" size={20} /></span><span class="o_kpi_value" id="xFuel">0</span><span class="o_kpi_label">تنبيهات انحراف الوقود</span><span class="o_kpi_sub">استهلاك يتجاوز القياسي بـ15%</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="wrench" size={20} /></span><span class="o_kpi_value" id="xWo">0</span><span class="o_kpi_label">أوامر شغل مفتوحة</span><span class="o_kpi_sub">منها <span id="xWoHigh">0</span> عالي الخطورة</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="activity" size={20} /></span><span class="o_kpi_value" id="xMttr">—</span><span class="o_kpi_label">متوسط وقت الإصلاح MTTR</span><span class="o_kpi_sub">الهدف: ≤ ساعتان (علاجي)</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="handshake" size={20} /></span><span class="o_kpi_value" id="xCust">0</span><span class="o_kpi_label">عُهد نشطة</span><span class="o_kpi_sub">بقيمة <span id="xCustVal">0</span> د.ل</span></div>
      <div class="o_kpi"><span class="o_kpi_icon"><Icon name="alertTriangle" size={20} /></span><span class="o_kpi_value" id="xExp7">0</span><span class="o_kpi_label">تنتهي صلاحيتها ≤7 أيام</span><span class="o_kpi_sub">و<span id="xExp30">0</span> تشغيلة خلال 30 يومًا (FEFO)</span></div>
    </div>

    <!-- حالة الأسطول الفوري -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="truck" size={16} /> حالة الأسطول الفوري</div>
      <div class="o_dashboard_card">
        <div class="o_fleet_strip">
          <div class="o_fchip"><div class="n" id="fPrep">0</div><div class="l">قيد التحضير</div></div>
          <div class="o_fchip is-warn"><div class="n" id="fGate">0</div><div class="l">تصريح بوابة</div></div>
          <div class="o_fchip is-info"><div class="n" id="fEnroute">0</div><div class="l">في الطريق</div></div>
          <div class="o_fchip is-ok"><div class="n" id="fDeliv">0</div><div class="l">سُلّمت اليوم</div></div>
          <div class="o_fchip is-danger"><div class="n" id="fDown">0</div><div class="l">أصول متوقفة</div></div>
          <div class="o_fchip is-warn"><div class="n" id="fMaint">0</div><div class="l">صيانة مركبات مفتوحة</div></div>
        </div>
      </div>
    </div>

    <!-- تدخّل الآن + التوزيع -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="alertTriangle" size={16} /> تدخّل الآن</div>
      <div class="o_dashboard_grid2">
        <div class="o_dashboard_card">
          <div class="o_dashboard_card_head"><span>يتطلب تدخلًا الآن</span></div>
          <div id="attention"><div class="o_dashboard_empty">لا شيء عاجل — المنظومة خضراء.</div></div>
        </div>
        <div class="o_dashboard_card">
          <div class="o_dashboard_card_head"><span>التوزيع حسب المناطق</span><span class="o_count">آخر 30 رحلة منتهية · نسبة الالتزام</span></div>
          <div id="zonesPerf"><div class="o_dashboard_empty">لا رحلات منتهية بعد.</div></div>
        </div>
      </div>
    </div>

    <!-- النشاط الأخير -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="activity" size={16} /> النشاط الأخير</div>
      <div class="o_dashboard_grid2">
        <div class="o_dashboard_card">
          <div class="o_dashboard_card_head"><span>أحدث أوامر الشغل</span></div>
          <div id="latestWos"><div class="o_dashboard_empty">لا أوامر شغل.</div></div>
        </div>
        <div class="o_dashboard_card">
          <div class="o_dashboard_card_head"><span>أحدث الرحلات</span></div>
          <div id="latestTrips"><div class="o_dashboard_empty">لا رحلات.</div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { TRIP_STATES, ZONES, tripSnapshot, podRate, otifRate } from '../../services/fleet/fleetModel.js';
  import { WO_STATES, OPEN_WO_STATES, mttrHours, woSnapshot, pmStatus } from '../../services/maintenance/workOrderModel.js';
  import { custodySummary } from '../../services/custody/custodyModel.js';
  import { listenTrips } from '../../services/fleet/fleetOpsService.js';
  import { listenAssets, listenWorkOrders } from '../../services/maintenance/maintenanceService.js';
  import { listenCustodies } from '../../services/custody/custodyService.js';
  import { listenBalances } from '../../services/balances/balancesService.js';
  import { expiryStatus } from '../../services/balances/balanceKey.js';
  import { listenVehicles } from '../../services/vehicles/vehiclesService.js';
  import { subscribeAuth, fetchUserProfile } from '../../services/auth/authService.js';

  const ALLOWED = ['admin', 'warehouse_manager'];
  let trips = [], wos = [], assets = [], custodies = [], balances = [], vehicles = [];

  const $ = (id) => document.getElementById(id);
  import { escAttr as esc } from '../../services/ui/escape.js';
  const today = () => new Date().toISOString().slice(0, 10);
  const pct = (x) => x == null ? '—' : Math.round(x * 100) + '%';

  // خرائط الحالة → متغيّر شارة أودو (o_badge-*) بلا إيموجي.
  const TRIP_VARIANT = { preparing: 'draft', gatepass: 'warn', enroute: 'progress', delivered: 'done', closed: 'done', cancelled: 'danger' };
  const WO_VARIANT = { draft: 'draft', confirmed: 'warn', in_progress: 'progress', repaired: 'done', back_in_service: 'done', scrapped: 'danger' };
  const badge = (variant, label) => `<span class="o_badge o_badge-${variant || 'draft'}">${esc(label || '')}</span>`;
  const setAlert = (id, on) => { const k = $(id)?.closest('.o_kpi'); if (k) k.classList.toggle('alert', !!on); };

  let started = false;
  subscribeAuth(async (user) => {
    if (!user) return;
    const profile = await fetchUserProfile(user);
    if (!ALLOWED.includes(profile?.role)) {
      $('deniedView').style.display = '';
      return;
    }
    $('dashView').style.display = '';
    if (started) return;
    started = true;
    listenTrips((l) => { trips = l; render(); });
    listenWorkOrders((l) => { wos = l; render(); });
    listenAssets((l) => { assets = l; render(); });
    listenCustodies((l) => { custodies = l; render(); });
    listenVehicles((l) => { vehicles = l; render(); });
    listenBalances((l) => { balances = l; render(); }, () => {});
  });

  function render() {
    const snap = tripSnapshot(trips);
    $('xEnroute').textContent = snap.enroute;
    $('xPod').textContent = pct(podRate(trips));
    $('xOtif').textContent = pct(otifRate(trips));
    const fuel = trips.reduce((n, t) => n + (Number(t.fuelSummary?.anomalies) || 0) + (t.tripStats?.anomalous ? 1 : 0), 0);
    $('xFuel').textContent = fuel;
    setAlert('xFuel', fuel > 0);

    const ws = woSnapshot(wos);
    $('xWo').textContent = ws.open;
    $('xWoHigh').textContent = ws.highOpen;
    setAlert('xWoHigh', ws.highOpen > 0);
    const mttr = mttrHours(wos.filter((w) => w.type === 'corrective'));
    $('xMttr').textContent = mttr == null ? '—' : mttr.toFixed(1) + 'س';

    const cs = custodySummary(custodies);
    $('xCust').textContent = cs.active;
    $('xCustVal').textContent = cs.valueAtRisk.toLocaleString('ar-LY');

    // انتهاء الصلاحية من مخزن الأرصدة (استباقي — تقرير ٥ في م-٤).
    const now = Date.now();
    let exp7 = 0, exp30 = 0;
    for (const b of balances) {
      if (!(Number(b.qty) > 0)) continue;
      if (expiryStatus(b.expiry, now, 7) === 'near' || expiryStatus(b.expiry, now, 7) === 'expired') exp7 += 1;
      else if (expiryStatus(b.expiry, now, 30) === 'near') exp30 += 1;
    }
    $('xExp7').textContent = exp7;
    $('xExp30').textContent = exp30;
    setAlert('xExp7', exp7 > 0);

    // حالة الأسطول الفوري.
    $('fPrep').textContent = snap.preparing;
    $('fGate').textContent = snap.gatepass;
    $('fEnroute').textContent = snap.enroute;
    $('fDeliv').textContent = trips.filter((t) => t.deliveredDate === today()).length;
    $('fDown').textContent = assets.filter((a) => a.status === 'down').length;
    $('fMaint').textContent = vehicles.reduce((n, v) => n + (Number(v.openMaintenance) || 0), 0);

    renderZones();
    renderAttention();
    renderLists();
  }

  function renderZones() {
    const finished = trips
      .filter((t) => (t.state === 'delivered' || t.state === 'closed') && t.plannedDate && t.deliveredDate)
      .slice(0, 30);
    if (!finished.length) {
      $('zonesPerf').innerHTML = '<div class="o_dashboard_empty">لا رحلات منتهية بعد.</div>';
      return;
    }
    $('zonesPerf').innerHTML = ZONES.map((z) => {
      const zt = finished.filter((t) => t.zone === z.id);
      const onTime = zt.filter((t) => t.deliveredDate <= t.plannedDate).length;
      const rate = zt.length ? onTime / zt.length : null;
      return `<div class="o_catbar_row">
        <span class="o_catbar_name">${esc(z.label)}</span>
        <span class="meta" style="min-width:52px">${zt.length} رحلة</span>
        <span class="o_sc_bar"><span style="width:${rate == null ? 0 : rate * 100}%"></span></span>
        <span class="o_catbar_val" style="min-width:48px">${pct(rate)}</span>
      </div>`;
    }).join('');
  }

  function renderAttention() {
    const items = [];
    for (const w of wos) {
      if (OPEN_WO_STATES.includes(w.state) && w.priority === 'high') {
        items.push(`<div class="o_sc_row is-danger"><span class="lead">عالي الخطورة:</span> ${esc(w.assetName || '')} — ${esc(w.description)} ${badge('danger', WO_STATES[w.state]?.label)}</div>`);
      }
    }
    for (const a of assets) {
      const s = pmStatus(a, today());
      if (s.status === 'overdue') items.push(`<div class="o_sc_row is-danger"><span class="lead">وقائية متأخرة:</span> ${esc(a.name || a.code)} <span class="meta">${esc(a.nextPmDate || '')}${a.nextPmKm ? ' · ' + a.nextPmKm + ' كم' : ''}</span></div>`);
    }
    for (const t of trips) {
      if (t.state === 'enroute' && t.plannedDate && t.plannedDate < today()) {
        items.push(`<div class="o_sc_row is-warn"><span class="lead">رحلة متأخرة عن موعدها:</span> ${esc(t.number || '')} → ${esc(t.destination)} <span class="meta">مخطط ${esc(t.plannedDate)}</span></div>`);
      }
      if ((t.tripStats?.anomalous) || Number(t.fuelSummary?.anomalies) > 0) {
        items.push(`<div class="o_sc_row is-warn"><span class="lead">انحراف وقود:</span> ${esc(t.number || t.plateNo || '')} — ${esc(t.driverName || '')} ${badge('warn', 'يُراجع مدير الأسطول')}</div>`);
      }
    }
    $('attention').innerHTML = items.length ? items.slice(0, 12).join('') : '<div class="o_dashboard_empty">لا شيء عاجل — المنظومة خضراء.</div>';
  }

  function renderLists() {
    const woRows = wos.slice(0, 6).map((w) => `
      <tr>
        <td class="decoration-bf">${esc(w.number || 'مسودة')}</td>
        <td>${esc(w.assetName || '—')}</td>
        <td>${esc(String(w.description || '').slice(0, 48))}</td>
        <td>${badge(WO_VARIANT[w.state], WO_STATES[w.state]?.label)}</td>
      </tr>`).join('');
    $('latestWos').innerHTML = woRows
      ? `<div class="o_list_scroll"><table class="o_list_view"><thead><tr><th>الرقم</th><th>الأصل</th><th>الوصف</th><th>الحالة</th></tr></thead><tbody>${woRows}</tbody></table></div>`
      : '<div class="o_dashboard_empty">لا أوامر شغل.</div>';

    const tripRows = trips.slice(0, 6).map((t) => `
      <tr>
        <td class="decoration-bf">${esc(t.number || 'مسودة')}</td>
        <td>${esc(t.plateNo || '—')}</td>
        <td>${esc(t.destination || '—')}</td>
        <td>${esc(t.driverName || '—')}</td>
        <td>${badge(TRIP_VARIANT[t.state], TRIP_STATES[t.state]?.label)}</td>
      </tr>`).join('');
    $('latestTrips').innerHTML = tripRows
      ? `<div class="o_list_scroll"><table class="o_list_view"><thead><tr><th>الرقم</th><th>اللوحة</th><th>الوجهة</th><th>السائق</th><th>الحالة</th></tr></thead><tbody>${tripRows}</tbody></table></div>`
      : '<div class="o_dashboard_empty">لا رحلات.</div>';
  }
</script>
</DashboardLayout>
