---
/**
 * «العرض الكامل» — محتويات غرفة القرار كلها في مسار واحد.
 *
 * كل محطة من التسع تُحاط بـ`.er-station` فيجمع الغلاف شرائح العرض من
 * المحطات كلها (~40 شريحة) ويبني «فهرس العرض» منها — فتصل لأي شريحة
 * من أي محطة أثناء التقديم دون خروج ولا إعادة تحميل. بلا وضع العرض،
 * الصفحة نفسها مستند شامل واحد قابل للتمرير والطباعة.
 */
import ExecutiveReviewShell from '../../../components/executive-review/ExecutiveReviewShell.astro';
import ReviewSections from '../../../components/executive-review/ReviewSections.astro';

const presentationSections = [
  ['model-policies', 'خمس سياسات تشغيلية'],
  ['governance-principle', 'المبدأ الحاكم'],
  ['governance-offices', 'حدود الاختصاص والتوجيه'],
  ['governance-matrix', 'من يطلب، من ينفذ، ومن يغلق'],
  ['governance-rules', 'ضوابط العمل داخل المواقع'],
  ['digital-hero', 'اعتماد القدرات الرقمية'],
  ['digital-outcomes', 'أين تعمل القدرات الرقمية'],
  ['digital-controls', 'استمرارية دون تجاوز للصلاحيات'],
  ['digital-decision', 'قرار اعتماد القدرات الرقمية'],
  ['catalog', 'كتالوج الاحتياجات التشغيلي'],
  ['sites-requirements', 'الأولويات التشغيلية للمخازن'],
  ['sites-masterplan', 'المخطط التنفيذي للتحوير والتجهيز'],
  ['sites-gallery', 'الموقع كما صممه المهندسون وكما هو اليوم'],
  ['restaurants-report', 'خطة المطاعم والمقاهي — REQ-006'],
  ['sectors-sales', 'توصية استثمارية معتمدة من الجلسة'],
  ['model-template', 'أي وظيفة تُبنى كدورة مكتملة'],
  ['model-chain', 'الدورة الموحدة'],
  ['status', 'الحالة الحالية والإنجازات'],
  ['achievements', 'ما تم بناؤه وتشغيله'],
  ['open-files', 'الحالة والخطوة التالية'],
  ['model-operating', 'النموذج التشغيلي الموحد'],
  ['decisions-board', 'قرارات الاجتماع'],
  ['decisions-after', 'التنفيذ والمتابعة والإغلاق'],
];
---

<ExecutiveReviewShell title="العرض التنفيذي الكامل — من المتابعة إلى القرار" active="present">
  {presentationSections.map(([key, label]) => (
    <div class="er-station" data-key={key} data-station={label}>
      <h2 class="er-station-title">{label}</h2>
      <ReviewSections section={key} />
    </div>
  ))}
</ExecutiveReviewShell>

<style is:global>
  .er-station{margin-top:34px;padding-top:10px;border-top:2px solid var(--color-line-strong)}
  .er-station:first-of-type{margin-top:0;border-top:0}
  .er-station-title{margin:0;font-size:13px;font-weight:900;color:var(--color-accent);letter-spacing:.02em}
  .review.presenting .er-station{margin:0;padding:0;border:0}
  .review.presenting .er-station-title{display:none}
</style>
