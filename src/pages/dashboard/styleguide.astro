---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/tokens.css';
import '../../styles/odoo.css';
import StyleguideApp from '../../components/odoo/StyleguideApp.jsx';
/*
 * /dashboard/styleguide — دليل أنماط نظام تصميم أودو (D3).
 * مرجع دائم للفريق: كل مكوّن مشترك بحالاته. معزول في حاوية .o_theme الفاتحة،
 * لا يمسّ ثيم البوابة الداكن (مرحلة ٠ — إضافة صرفة).
 */
---

<DashboardLayout title="دليل الأنماط — نظام التصميم" showGuide={false} light>
  <div class="text-right" dir="rtl">
    <h1 class="text-2xl font-bold text-ink mb-1">دليل الأنماط — مرحلة الاعتماد</h1>
    <p class="text-sm text-ink-2 mb-5 leading-relaxed">
      مرجع المكوّنات المشتركة (D2) بحالاتها كاملةً — لون الهوية معتمَد من
      <code class="text-accent" dir="ltr">tokens.css</code> (نقطة تحكّم واحدة).
    </p>
    <StyleguideApp client:load />
  </div>
</DashboardLayout>
