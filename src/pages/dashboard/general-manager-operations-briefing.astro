    { name: 'طابعات ملصقات حرارية', qty: 4, unit: 'طابعة', priority: 'عال', note: 'ملصقات مواقع A-05-R-02 وباليهات ودفعات وصلاحية' },
    { name: 'ميزان أرضي 2×2 م', qty: 2, unit: 'ميزان', priority: 'عال', note: 'الاستلام والصرف بدقة ±500 غ وربط القراءة بالمستند' },
    { name: 'ميزان منصة محمول', qty: 3, unit: 'ميزان', priority: 'متوسط', note: 'وزن العينات والطرود في الفرز' },
    { name: 'شاشات متابعة للمشرفين', qty: 3, unit: 'شاشة', priority: 'متوسط', note: 'عرض لوحات البوابة الحية في صالة العمليات والبوابة' },
    { name: 'عربات نقل وسلالم آمنة', qty: 1, unit: 'حزمة', priority: 'متوسط', note: 'عربات درج + سلالم منصة بحواجز للمستويات العلوية' },
  ]},
  { id: 'storage', title: 'احتياجات التخزين', hint: 'مستهلكات دورية — تُطلب بدورة الشراء الداخلية', items: [
    { name: 'باليتات بلاستيكية 1200×1000', qty: 500, unit: 'باليتة', priority: 'عال', note: 'قابلة للغسيل — شرط مناطق الغذاء والكوزمتيك (نوفا)' },
    { name: 'باليتات خشبية معالجة ISPM-15', qty: 300, unit: 'باليتة', priority: 'متوسط', note: 'للمخزون الجاف العام' },
    { name: 'صناديق تعشيش مقسمة', qty: 200, unit: 'صندوق', priority: 'متوسط', note: 'الأصناف الصغيرة وقطع الغيار' },
    { name: 'ملصقات مواقع + بطاقات Bin Card', qty: 1, unit: 'حزمة سنوية', priority: 'عال', note: 'ترقيم المواقع كاملًا قبل الجرد القادم' },
    { name: 'أفلام Stretch وأربطة', qty: 1, unit: 'حزمة شهرية', priority: 'عال', note: 'تثبيت الباليهات — استهلاك يُراقب بمؤشر' },
    { name: 'أقفال وأختام ترقيم للغرف', qty: 40, unit: 'قفل/ختم', priority: 'عال', note: 'غرف الرحبة 1–19 (عهدة نوفا) + أبواب 155' },
  ]},
  { id: 'dispatch', title: 'احتياجات الصرف والتسليم', hint: 'كل صرف يمر بالدورة: PICK ← PACK ← DN ← GP ← POD', items: [
    { name: 'كراتين شحن بمقاسات معتمدة', qty: 1, unit: 'حزمة شهرية', priority: 'عال', note: '3 مقاسات موحدة بشعار الشركة (تنسيق التسويق)' },
    { name: 'أشرطة معلمة + أكياس', qty: 1, unit: 'حزمة شهرية', priority: 'متوسط', note: 'شريط بشعار يكشف العبث' },
    { name: 'أختام تشغيلية (استُلم/فُحص/خرج)', qty: 12, unit: 'ختم', priority: 'متوسط', note: 'لكل نقطة عمل — بسجل عهدة أختام' },
    { name: 'حافظات مستندات للسائقين', qty: 10, unit: 'حافظة', priority: 'منخفض', note: 'نسخ DN/GP الاحتياطية حتى اكتمال POD الرقمي' },
  ]},
  { id: 'roles', title: 'احتياجات الأدوار الوظيفية', hint: 'لكل دور عدة قياسية تُسلَّم عهدةً — الزي بلوق موحد (تنسيق التسويق)', items: [
    { name: 'عدة أمين المخزن', qty: 4, unit: 'عدة/موظف', priority: 'عال', note: 'زي + حذاء سلامة + سترة عاكسة + قفازات + جهاز ماسح + دفتر عهدة' },
    { name: 'عدة مفتش الجودة', qty: 2, unit: 'عدة/موظف', priority: 'عال', note: 'زي + جهاز + حرارة IR + مجس اختراق + أختام QC + كاميرا توثيق' },
    { name: 'عدة ضابط البوابة', qty: 2, unit: 'عدة/موظف', priority: 'عال', note: 'زي + جهاز + كشاف + مرآة فحص أسفل المركبة + سجل بوابة' },
    { name: 'عدة مشرف المناولة والفرق', qty: 1, unit: 'حزمة فريق', priority: 'عال', note: 'سترات مرقمة + قفازات وأحزمة ظهر + خوذ لمناطق الرفوف' },
    { name: 'عدة دور الحركة (السائقين)', qty: 6, unit: 'عدة/سائق', priority: 'متوسط', note: 'زي + حافظة + Fleet Card + هاتف بتطبيق POD' },
    { name: 'عدة مراقب المخزون', qty: 2, unit: 'عدة/موظف', priority: 'متوسط', note: 'جهاز جرد + شارة دخول شامل + دفاتر عد أعمى' },
  ]},
];
const catalogItems = catalog.flatMap((section) => section.items.map((item) => ({ ...item, section: section.title })));

const sectors = [
  { name: 'المطاعم والمقاهي', state: 'green', role: 'نعمل كمورد خارجي — توريد مزدوج ودورة غذائية كاملة (REQ-006) لمشاريع Playtime وDistrict وBusiness District' },
  { name: 'مدينة الترفيه', state: 'green', role: 'مبدأ البوابة نفسه: لا مستند — لا حركة (وفق الاجتماع مع مدير القطاع)' },
  { name: 'البرندات', state: 'gray', role: 'لم يُناقش — يُجدول اجتماع نطاق' },
  { name: 'المولات', state: 'gray', role: 'لم يُناقش — يُجدول اجتماع نطاق' },
  { name: 'البيع بالتجزئة', state: 'gray', role: 'لم يُناقش — وسيعتمد على دورة REQ-004' },
];
const slideCount = 11 + decisions.length; // 17 شريحة
---

<DashboardLayout title="المراجعة التنفيذية لسلاسل الإمداد" light>
  <main class="deck-root" dir="rtl">

    <section id="deckMode">
      <!-- 1: الغلاف -->
      <article class="slide s-cover is-current" data-slide>
        <p class="eyebrow">إدارة السلاسل والإمداد والمخازن · BFP-SCM-PR-2026-010</p>
        <h1>Supply Chain<br/>Executive Review</h1>
        <h2>المراجعة التنفيذية لسلاسل الإمداد</h2>
        <div class="thread"><span>الواقع الحالي</span><i></i><span>ما تم إنجازه</span><i></i><span>التحديات</span><i></i><span>القرارات المطلوبة</span><i></i><span>الخطوة القادمة</span></div>
        <p class="motto" data-edit="motto">«من المتابعة إلى القرار»</p>
      </article>

      <!-- 2: لوحة المدير العام -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>لوحة المدير العام</span><h2>الحالة العامة لإدارة سلاسل الإمداد</h2></header>
        <div class="board">
          {board.map((row, i) => (
            <div class={`board-row st-${row.state}`}><i class="dot"></i><b>{row.label}</b><span data-edit={`board-${i}`}>{row.word}</span></div>
          ))}
        </div>
        <p class="talk" data-edit="talk-board">شرح المتحدث: افتتح بدقيقة واحدة — أخضران يعملان، ثلاثة صفراء تنتظر قراركم، وأحمر واحد هو موضوع اليوم.</p>
      </article>

      <!-- 3: 3×3 -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>في ثلاث جمل لكل عمود</span><h2>إنجازات · تحديات · قرارات</h2></header>
        <div class="threes">
          <div class="col c-green"><h3>3 إنجازات</h3><ol>{threes.wins.map((x, i) => <li data-edit={`t-win-${i}`}>{x}</li>)}</ol></div>
          <div class="col c-yellow"><h3>3 تحديات</h3><ol>{threes.risks.map((x, i) => <li data-edit={`t-risk-${i}`}>{x}</li>)}</ol></div>
          <div class="col c-red"><h3>3 قرارات مطلوبة</h3><ol>{threes.asks.map((x, i) => <li data-edit={`t-ask-${i}`}>{x}</li>)}</ol></div>
        </div>
        <p class="talk" data-edit="talk-threes">شرح المتحدث: هذه الشريحة تختصر الاجتماع كله — إن ضاق الوقت فهي وشرائح القرارات تكفي.</p>
      </article>

      <!-- 4: ماذا أنجزنا -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المحطة 2 · منذ اجتماع المالية 02.08</span><h2>ماذا أنجزنا؟</h2></header>
        <div class="wins">
          {wins.map((w, i) => (<div class="win"><b>{String(i + 1).padStart(2, '0')}</b><div><h3>{w.t}</h3><p data-edit={`win-${i}`}>{w.d}</p></div><span>{w.tag}</span></div>))}
        </div>
        <p class="talk" data-edit="talk-wins">شرح المتحدث: كل إنجاز له دليل حي بالبوابة — يمكن فتح أي شاشة أثناء العرض.</p>
      </article>

      <!-- 5: المشاريع المفتوحة -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المحطة 3 · حالة كل ملف</span><h2>المشاريع المفتوحة</h2></header>
        <div class="projects">
          {projects.map((p, i) => (<div class={`proj st-${p.state}`}><i class="dot"></i><b>{p.name}</b><p data-edit={`proj-${i}`}>{p.line}</p><span>التالي: {p.next}</span></div>))}
        </div>
      </article>

      <!-- 6: موقع 155 -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المواقع · جرد مصوَّر رسمي</span><h2>موقع أبوهادي 155</h2></header>
        <div class="site-slide">
          <svg viewBox="0 0 640 258" role="img" aria-label="مخطط توضيحي لمخازن 155">
            <text x="632" y="16" font-size="10" fill="#8a93a6" text-anchor="end">مخطط توضيحي — المرجع NAS-8155-ARC</text>
            {warehouses.slice(0, 5).map((wh, i) => { const w = 24 + wh.area / 34; const xs = [8, 112, 172, 252, 372]; return (
              <g><rect x={xs[i]} y="24" width={w} height="92" rx="6" fill={wh.used === 0 ? '#1e3a2f' : wh.used === 100 ? '#3a1e24' : '#3a321e'} stroke={wh.used === 0 ? '#48b184' : wh.used === 100 ? '#d06a7c' : '#cfa14e'} stroke-width="1.6"/>
              <text x={xs[i] + w / 2} y="60" font-size="17" font-weight="800" text-anchor="middle" fill="#fff">{wh.code}</text>
              <text x={xs[i] + w / 2} y="82" font-size="10" text-anchor="middle" fill="#aeb6c6">{wh.area.toLocaleString('en-US')} م² · {wh.used}%</text></g>
            ); })}
            {warehouses.slice(5).map((wh, i) => { const w = 24 + wh.area / 34; const xs = [8, 106, 204, 302, 400]; return (
              <g><rect x={xs[i]} y="130" width={w} height="92" rx="6" fill={wh.used === 0 ? '#1e3a2f' : wh.used === 100 ? '#3a1e24' : '#3a321e'} stroke={wh.used === 0 ? '#48b184' : wh.used === 100 ? '#d06a7c' : '#cfa14e'} stroke-width="1.6"/>
              <text x={xs[i] + w / 2} y="166" font-size="17" font-weight="800" text-anchor="middle" fill="#fff">{wh.code}</text>
              <text x={xs[i] + w / 2} y="188" font-size="10" text-anchor="middle" fill="#aeb6c6">{wh.area.toLocaleString('en-US')} م² · {wh.used}%</text></g>
            ); })}
            <rect x="480" y="130" width="152" height="92" rx="6" fill="#1e2f3a" stroke="#5f9cb4" stroke-width="1.6"/>
            <text x="556" y="166" font-size="13" font-weight="800" text-anchor="middle" fill="#fff">كتلة التبريد</text>
            <text x="556" y="188" font-size="10" text-anchor="middle" fill="#aeb6c6">12 غرفة · تُثبَّت بالمسح</text>
            <text x="8" y="248" font-size="10" fill="#8a93a6">أخضر: فارغ جاهز · ذهبي: مشغول جزئيًا · أحمر: مشغول بالكامل</text>
          </svg>
          <div class="big-facts">
            <div><b>{totalArea.toLocaleString('en-US')}</b><span>م² مخازن جافة (10 مخازن)</span></div>
            <div><b>{weightedUsed}%</b><span data-edit="f155-used">إشغال مرجّح — كله لأطراف خارجية</span></div>
            <div><b>{emptyArea.toLocaleString('en-US')}</b><span data-edit="f155-empty">م² فارغة تنتظر قرار التخصيص</span></div>
          </div>
        </div>
        <p class="talk" data-edit="talk-155">شرح المتحدث: تفاصيل كل مخزن (المخزون والجهة الشاغلة) في الملحق — والصور المعمارية الكاملة مرفقة بملف الاجتماع.</p>
      </article>

      <!-- 7: الرحبة -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المواقع · المرجع PROJET LYBIE</span><h2>مستودعات الرحبة — عقد نوفا</h2></header>
        <div class="site-slide">
          <svg viewBox="0 0 640 258" role="img" aria-label="مخطط توضيحي للرحبة">
            <rect x="8" y="20" width="624" height="86" rx="6" fill="#232f45" stroke="#7f8ba5" stroke-width="1.6"/>
            <text x="320" y="56" font-size="16" font-weight="800" text-anchor="middle" fill="#fff">الهنقر الرئيسي 24 × 80 م (≈ 1,920 م²)</text>
            <text x="320" y="80" font-size="11" text-anchor="middle" fill="#aeb6c6">تشوين عام ومناولة — مخطط الأساسات 24×80m Hangar</text>
            <text x="12" y="132" font-size="12" font-weight="800" fill="#e7d5ae">غرف التخزين 1–19 — عهدة شركة نوفا (كوزمتيك)</text>
            {rahbaRooms.map((n, i) => (
              <g><rect x={8 + (i % 10) * 63} y={142 + Math.floor(i / 10) * 54} width="55" height="46" rx="5" fill="#33273b" stroke="#a98cb8" stroke-width="1.4"/>
              <text x={8 + (i % 10) * 63 + 27.5} y={142 + Math.floor(i / 10) * 54 + 29} font-size="14" font-weight="800" text-anchor="middle" fill="#fff">{n}</text></g>
            ))}
          </svg>
          <div class="big-facts">
            <div><b>19</b><span data-edit="frb-1">غرفة مخصصة لنوفا — منتجات الكوزمتيك</span></div>
            <div><b>0</b><span data-edit="frb-2">عقد موقّع حتى الآن — موضوع القرار 5</span></div>
            <div><b>شهرية</b><span data-edit="frb-3">دورة فوترة مقترحة عبر البوابة + أقفال وأختام لكل غرفة</span></div>
          </div>
        </div>
        <p class="talk" data-edit="talk-rahba">شرح المتحدث: الكوزمتيك يحتاج ضبط حرارة ورطوبة وتهوية — تدخل في اشتراطات العقد الفنية.</p>
      </article>

      <!-- 8: أين المشكلة -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المحطة 4 · بلا تجميل</span><h2>أين المشكلة؟</h2></header>
        <div class="blockers">
          {blockers.map((b, i) => (<div class="blocker"><b>{String(i + 1).padStart(2, '0')}</b><div><h3>{b.t}</h3><p data-edit={`blk-${i}`}>{b.d}</p></div><span>{b.o}</span></div>))}
        </div>
      </article>

      <!-- 9: التعامل مع الإدارات -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المحطة 5-أ · نموذج المكاتب داخل المستودعات</span><h2>التعامل مع الإدارات</h2></header>
        <p class="rule-line" data-edit="office-rule">{officeRule}</p>
        <div class="offices">
          {offices.map((o, i) => (
            <div class="office-row"><b>{o.dept}</b><p data-edit={`off-${i}`}>{o.tasks}</p><span data-edit={`offp-${i}`}>في البوابة: {o.portal}</span></div>
          ))}
        </div>
        <p class="talk" data-edit="talk-offices">شرح المتحدث: كل سطر «في البوابة» دورة تعمل فعلًا اليوم — لسنا نقترح نظريًا. تفصيل عندنا/عند التبعية في الملحق.</p>
      </article>

      <!-- 10-15: شرائح القرارات -->
      {decisions.map(([id, title, scope, owner, ifYes, ifLate], index) => (
        <article class="slide s-decision" data-slide data-decision={id}>
          <header class="slide-head"><span>قرار المدير العام · {String(index + 1)} من {decisions.length}</span><h2>{title}</h2></header>
          <p class="d-scope" data-edit={`d-scope-${id}`}>{scope}</p>
          <div class="impact-pair">
            <div class="if-yes"><b>الأثر عند الاعتماد</b><p data-edit={`d-yes-${id}`}>{ifYes}</p></div>
            <div class="if-late"><b>الأثر عند التأخير</b><p data-edit={`d-late-${id}`}>{ifLate}</p></div>
          </div>
          <footer class="d-foot"><small>جهة الحسم: {owner}</small>
            <label class="no-print">موقف الاجتماع
              <select data-decision-state={id}><option value="pending">ينتظر القرار</option><option value="approved">معتمد</option><option value="conditional">معتمد بشروط</option><option value="deferred">مؤجل</option></select>
            </label>
          </footer>
        </article>
      ))}

      <!-- 16: ما بعد الاجتماع -->
      <article class="slide" data-slide>
        <header class="slide-head"><span>المحطة 6 · ضمان التنفيذ</span><h2>ماذا سيحدث بعد الاجتماع؟</h2></header>
        <table class="after"><thead><tr><th>#</th><th>الإجراء</th><th>المسؤول</th><th>التاريخ</th></tr></thead><tbody>
          {followups.map(([action, owner, due], i) => (
            <tr><td>{String(i + 1).padStart(2, '0')}</td>
            <td><input data-fu-action={i} type="text" value={action}></td>
            <td><input data-fu-owner={i} type="text" value={owner}></td>
            <td><input data-fu-due={i} type="date" value={due}></td></tr>
          ))}
        </tbody></table>
      </article>

      <!-- 17: الخاتمة -->
      <article class="slide s-cover" data-slide>
        <p class="eyebrow">الخلاصة</p>
        <h2 class="closing-line">هذا وضعنا. هذه نتائجنا.<br/>هذه معوقاتنا — <b id="decidedCount">و0 من 6</b> قرارات حُسمت.</h2>
        <p class="motto" data-edit="closing">الخطوة القادمة تبدأ بتوقيعكم — والتفاصيل كاملة في الملاحق والطباعة.</p>
        <div class="thread"><span>شكرًا لوقتكم</span></div>
      </article>

      <div class="deck-chrome no-print">
        <div class="progress"><i id="progressBar"></i></div>
        <div class="controls">
          <button type="button" id="prevBtn" aria-label="الشريحة السابقة">‹ السابقة</button>
          <span id="counter">1 / {slideCount}</span>
          <button type="button" id="nextBtn" aria-label="الشريحة التالية">التالية ›</button>
          <span class="sep"></span>
          <span id="syncChip" class="sync-chip">جارٍ الاتصال…</span>
          <button type="button" id="editBtn">تحرير الشروح</button>
          <button type="button" id="annexBtn">الملاحق التفصيلية</button>
          <button type="button" id="printBtn">طباعة</button>
          <button type="button" id="exportBtn">تصدير المحضر</button>
          <button type="button" id="fsBtn">ملء الشاشة</button>
        </div>
      </div>
    </section>

    <!-- ═══ الملاحق التفصيلية ═══ -->
    <section id="annexMode" hidden>
      <div class="annex-bar no-print"><button type="button" id="backToDeck">‹ العودة للعرض</button><h2>الملاحق التفصيلية</h2><b id="grandTotal">0 د.ل</b></div>

      <div class="annex-block">
        <h3>ملحق أ — كتالوج الاحتياجات التشغيلي</h3>
        <p class="annex-note">البنود المعمارية والهندسية خارج الكتالوج عمدًا — مطلوبة من الفريق الهندسي بتكليف قائم. الأسعار حقول قرار تُملأ في الاجتماع <b>وتُزامَن مع قاعدة البيانات</b> فتبقى بعد الاجتماع.</p>
        {catalog.map((section) => (
          <details class="proc-section" open>
            <summary><h4>{section.title}</h4><small>{section.hint}</small><i data-sec-total={section.id}>0 د.ل</i></summary>
            <div class="table-wrap"><table class="purchase-table"><thead><tr><th>البند</th><th>البيان التشغيلي</th><th>الكمية</th><th>الأولوية</th><th>تقدير الوحدة</th><th>الإجمالي</th><th>الموقف</th></tr></thead><tbody>
              {section.items.map((item) => { const index = catalogItems.findIndex((x) => x.section === section.title && x.name === item.name); return (
                <tr>
                  <td class="item-cell"><b>{item.name}</b></td>
                  <td class="note-cell">{item.note}</td>
                  <td><b>{Number(item.qty).toLocaleString('en-US')}</b><small>{item.unit}</small></td>
                  <td><span class={`priority ${item.priority === 'حرج' ? 'critical' : ''}`}>{item.priority}</span></td>
                  <td><input class="cost-input no-print" data-cost={index} type="number" min="0" step="0.01" placeholder="0"><span class="print-only" data-cost-print={index}>0</span></td>
                  <td><strong data-line-total={index}>0</strong></td>
                  <td><select class="status-input no-print" data-status={index}><option value="unpriced">غير مسعّر</option><option value="rfq">طلب عروض</option><option value="quoted">عروض مستلمة</option><option value="approved">معتمد</option><option value="ordered">تم الطلب</option></select><span class="print-only" data-status-print={index}>غير مسعّر</span></td>
                </tr>
              ); })}
            </tbody></table></div>
          </details>
        ))}
      </div>

      <div class="annex-block">
        <h3>ملحق ب — التعامل مع الإدارات: النموذج كاملًا مستندًا إلى البوابة (موضوع القرار 2)</h3>
        <p class="annex-note"><b>القاعدة الحاكمة:</b> {officeRule}. كل بطاقة تبين مهام المكتب، وأين تعيش دورته <b>في البوابة فعلًا اليوم</b>، وما الذي عندنا وما الذي عند التبعية.</p>
        <div class="office-cards">
          {offices.map((o) => (
            <article>
              <h4>{o.dept}</h4>
              <dl>
                <div><dt>مهام المكتب</dt><dd>{o.tasks}</dd></div>
                <div><dt>في البوابة اليوم</dt><dd class="portal-ref">{o.portal}</dd></div>
                <div><dt>عندنا (يوميًا)</dt><dd>{o.ours}</dd></div>
                <div><dt>عند التبعية</dt><dd>{o.theirs}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>

      <div class="annex-block">
        <h3>ملحق ج — وظائف سلاسل الإمداد في الشركة القابضة والسياسات المالية (موضوع القرار 1)</h3>
        <p class="annex-note">برندزو شركة قابضة متعددة القطاعات — لكل وظيفة دورنا فيها ودورة معتمدة تبدأ وتنتهي. الأحمر هو ما ينتظر اعتماد اليوم.</p>
        <div class="fn-grid">
          {functions_.map((f) => (
            <article class={`st-${f.state}`}><header><i class="dot"></i><h4>{f.fn}</h4></header>
            <dl><div><dt>دورنا</dt><dd>{f.role}</dd></div><div><dt>الدورة</dt><dd class="cycle">{f.cycle}</dd></div></dl>
            <footer>{f.label}</footer></article>
          ))}
        </div>
      </div>

      <div class="annex-block">
        <h3>ملحق د — تفاصيل المواقع مخزنًا مخزنًا</h3>
        <div class="table-wrap"><table class="purchase-table wh-table"><thead><tr><th>المخزن</th><th>المساحة م²</th><th>الإشغال</th><th>المخزون الحالي</th><th>الجهة الشاغلة</th><th>الحالة</th></tr></thead><tbody>
          {warehouses.map((wh) => (
            <tr><td><b>{wh.code}</b></td><td>{wh.area.toLocaleString('en-US')}</td><td>{wh.used}%</td><td>{wh.stock}</td><td>{wh.party}</td><td>{wh.state}</td></tr>
          ))}
          <tr><td><b>الرحبة</b></td><td>≈ 1,920 + غرف</td><td>—</td><td>هنقر 24×80 م + غرف 1–19 كوزمتيك</td><td>شركة نوفا (بانتظار العقد)</td><td>موضوع القرار 5</td></tr>
        </tbody></table></div>
      </div>

      <div class="annex-block">
        <h3>ملحق هـ — القطاعات الخمسة ودور سلاسل الإمداد (موضوع القرار 6)</h3>
        <div class="sectors-grid">
          {sectors.map((s) => (<article class={`st-${s.state}`}><i class="dot"></i><h4>{s.name}</h4><p>{s.role}</p></article>))}
        </div>
      </div>
    </section>
  </main>
</DashboardLayout>

<script>
  /* جسر المزامنة: وحدة ES تستورد Firebase وتعرّضها للسكربت المضمّن. */
  import { subscribeReview, saveReview } from '../../services/briefing/gmReviewService.js';
  window.__gmSync = { subscribeReview, saveReview };
  window.dispatchEvent(new Event('gm-sync-ready'));
</script>

<script define:vars={{ catalogItems, catalog: catalog.map((s) => ({ id: s.id, title: s.title })), slideCount }}>
  /* global catalogItems, catalog, slideCount */
  const STORAGE_KEY = 'brandzo-gm-review-v3';
  let state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
  let lastSyncedJson = '';
  let saveTimer = null;

  const chip = document.getElementById('syncChip');
  function setChip(mode, text) { chip.textContent = text; chip.className = `sync-chip sc-${mode}`; }

  /* الحفظ: محليًا فورًا + سحابيًا (مدموجًا) بعد مهلة قصيرة. */
  function save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    if (!window.__gmSync) return;
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      setChip('saving', 'جارٍ الحفظ…');
      const payload = JSON.parse(JSON.stringify(state));
      lastSyncedJson = JSON.stringify(payload);
      window.__gmSync.saveReview(payload)
        .then(() => setChip('ok', 'متزامن مع قاعدة البيانات'))
        .catch((e) => { console.error('[gm-review] save failed', e); setChip('err', 'تعذر الحفظ السحابي — محفوظ محليًا'); });
    }, 600);
  }
  const money = (value) => `${Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 2 })} د.ل`;

  /* ── محرك الشرائح ── */
  const slides = [...document.querySelectorAll('[data-slide]')];
  let current = 0;
  function goTo(index) {
    current = Math.max(0, Math.min(slides.length - 1, index));
    slides.forEach((slide, i) => slide.classList.toggle('is-current', i === current));
    document.getElementById('counter').textContent = `${current + 1} / ${slideCount}`;
    document.getElementById('progressBar').style.width = `${((current + 1) / slides.length) * 100}%`;
  }
  document.getElementById('nextBtn').addEventListener('click', () => goTo(current + 1));
  document.getElementById('prevBtn').addEventListener('click', () => goTo(current - 1));
  document.addEventListener('keydown', (event) => {
    if (!document.getElementById('annexMode').hidden) return;
    if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;
    if (document.activeElement?.isContentEditable) return;
    if (event.key === 'ArrowLeft' || event.key === ' ' || event.key === 'PageDown') { event.preventDefault(); goTo(current + 1); }
    if (event.key === 'ArrowRight' || event.key === 'PageUp') { event.preventDefault(); goTo(current - 1); }
    if (event.key === 'Home') goTo(0);
    if (event.key === 'End') goTo(slides.length - 1);
  });
  goTo(0);

  const deckEl = document.getElementById('deckMode');
  const annexEl = document.getElementById('annexMode');
  document.getElementById('annexBtn').addEventListener('click', () => { deckEl.hidden = true; annexEl.hidden = false; window.scrollTo(0, 0); });
  document.getElementById('backToDeck').addEventListener('click', () => { annexEl.hidden = true; deckEl.hidden = false; });

  /* ── الشروح القابلة للتحرير (تُزامَن سحابيًا) ── */
  const editables = [...document.querySelectorAll('[data-edit]')];
  function applyTexts() {
    editables.forEach((el) => { const saved = state.texts?.[el.dataset.edit]; if (saved !== undefined && saved !== el.innerText) el.innerText = saved; });
  }
  let editing = false;
  const editBtn = document.getElementById('editBtn');
  editBtn.addEventListener('click', () => {
    editing = !editing;
    document.body.classList.toggle('gm-edit', editing);
    editBtn.textContent = editing ? 'إنهاء التحرير' : 'تحرير الشروح';
    editables.forEach((el) => el.setAttribute('contenteditable', editing ? 'true' : 'false'));
  });
  editables.forEach((el) => el.addEventListener('blur', () => {
    if (!editing) return;
    state.texts ||= {}; state.texts[el.dataset.edit] = el.innerText; save();
  }));

  /* ── مواقف القرارات ── */
  function updateDecided() {
    const values = [...document.querySelectorAll('[data-decision-state]')].map((s) => s.value);
    const done = values.filter((v) => v !== 'pending').length;
    const el = document.getElementById('decidedCount'); if (el) el.textContent = `و${done} من ${values.length}`;
    document.querySelectorAll('[data-decision]').forEach((card) => card.classList.toggle('is-decided', card.querySelector('select').value !== 'pending'));
  }
  document.querySelectorAll('[data-decision-state]').forEach((select) => {
    select.addEventListener('change', () => { state.decisions ||= {}; state.decisions[select.dataset.decisionState] = select.value; save(); updateDecided(); });
  });

  /* ── الكتالوج ── */
  const lineTotal = (index) => Number(catalogItems[index].qty) * Number(state.costs?.[index] || 0);
  function renderBudget() {
    let grand = 0;
    catalog.forEach((section) => {
      const total = catalogItems.reduce((sum, item, index) => item.section === section.title ? sum + lineTotal(index) : sum, 0);
      grand += total;
      const el = document.querySelector(`[data-sec-total="${section.id}"]`); if (el) el.textContent = money(total);
    });
    document.getElementById('grandTotal').textContent = money(grand);
  }
  function paintCost(index) {
    document.querySelector(`[data-line-total="${index}"]`).textContent = money(lineTotal(index));
    document.querySelector(`[data-cost-print="${index}"]`).textContent = money(state.costs?.[index] || 0);
  }
  document.querySelectorAll('[data-cost]').forEach((input) => {
    const index = input.dataset.cost;
    input.addEventListener('input', () => {
      state.costs ||= {}; state.costs[index] = Number(input.value || 0); save(); paintCost(index); renderBudget();
    });
  });
  const statusLabels = { unpriced: 'غير مسعّر', rfq: 'طلب عروض', quoted: 'عروض مستلمة', approved: 'معتمد', ordered: 'تم الطلب' };
  document.querySelectorAll('[data-status]').forEach((select) => {
    const index = select.dataset.status;
    select.addEventListener('change', () => { state.statuses ||= {}; state.statuses[index] = select.value; save(); document.querySelector(`[data-status-print="${index}"]`).textContent = statusLabels[select.value]; });
  });

  /* ── جدول المتابعة ── */
  document.querySelectorAll('[data-fu-action], [data-fu-owner], [data-fu-due]').forEach((input) => {
    const group = input.dataset.fuAction !== undefined ? 'fuA' : input.dataset.fuOwner !== undefined ? 'fuO' : 'fuD';
    const key = input.dataset.fuAction ?? input.dataset.fuOwner ?? input.dataset.fuDue;
    input.addEventListener('input', () => { state[group] ||= {}; state[group][key] = input.value; save(); });
  });

  /* ── تطبيق الحالة كاملة على الواجهة (محلية أو قادمة من السحابة) ── */
  function applyState() {
    applyTexts();
    document.querySelectorAll('[data-decision-state]').forEach((select) => { select.value = state.decisions?.[select.dataset.decisionState] || 'pending'; });
    updateDecided();
    document.querySelectorAll('[data-cost]').forEach((input) => { const i = input.dataset.cost; input.value = state.costs?.[i] || ''; paintCost(i); });
    document.querySelectorAll('[data-status]').forEach((select) => { const i = select.dataset.status; select.value = state.statuses?.[i] || 'unpriced'; document.querySelector(`[data-status-print="${i}"]`).textContent = statusLabels[select.value]; });
    document.querySelectorAll('[data-fu-action], [data-fu-owner], [data-fu-due]').forEach((input) => {
      const group = input.dataset.fuAction !== undefined ? 'fuA' : input.dataset.fuOwner !== undefined ? 'fuO' : 'fuD';
      const key = input.dataset.fuAction ?? input.dataset.fuOwner ?? input.dataset.fuDue;
      if (state[group]?.[key] !== undefined) input.value = state[group][key];
    });
    renderBudget();
  }
  applyState();

  /* ── الاشتراك السحابي: أحدث نسخة تُطبق فورًا على كل الأجهزة ── */
  function startSync() {
    if (!window.__gmSync) return;
    setChip('saving', 'جارٍ الاتصال…');
    window.__gmSync.subscribeReview((remote, pending) => {
      if (remote === null) { setChip('ok', 'متزامن — لا بيانات محفوظة بعد'); return; }
      const { updatedAt: _updatedAt, updatedByUid: _updatedByUid, ...data } = remote;
      const json = JSON.stringify(data);
      if (json === lastSyncedJson) { setChip('ok', 'متزامن مع قاعدة البيانات'); return; }
      lastSyncedJson = json;
      state = { ...state, ...data };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      applyState();
      setChip('ok', pending ? 'جارٍ الحفظ…' : 'متزامن مع قاعدة البيانات');
    });
  }
  if (window.__gmSync) startSync(); else window.addEventListener('gm-sync-ready', startSync, { once: true });

  /* ── أدوات ── */
  document.getElementById('printBtn').addEventListener('click', () => window.print());
  document.getElementById('fsBtn').addEventListener('click', () => {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen?.(); else document.exitFullscreen?.();
  });
  window.addEventListener('beforeprint', () => { annexEl.hidden = false; deckEl.hidden = false; document.querySelectorAll('details').forEach((d) => { d.dataset.wasOpen = d.open ? '1' : ''; d.open = true; }); });
  window.addEventListener('afterprint', () => { annexEl.hidden = true; document.querySelectorAll('details').forEach((d) => { d.open = d.dataset.wasOpen === '1'; }); });
  document.getElementById('exportBtn').addEventListener('click', () => {
    const payload = { exportedAt: new Date().toISOString(), document: 'BFP-SCM-PR-2026-010', ...state };
    const url = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8' }));
    const link = document.createElement('a'); link.href = url; link.download = `Brandzo-SC-Executive-Review-${new Date().toISOString().slice(0, 10)}.json`; link.click(); URL.revokeObjectURL(url);
  });
</script>

