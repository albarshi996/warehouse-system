---
/**
 * لوحة القيادة التشغيلية — الشاشة الواحدة التي تُتوّج الدورة المستندية العالمية.
 *
 * لماذا وُجدت؟ لأن الدورة كلها (الدفتر · المبيعات · النقل · التقارير) صارت
 * بياناتٍ حيّة، فتُوّجت بشاشةٍ واحدة تعرض للإدارة: المؤشرات الأربعة (نسبة
 * التنفيذ · زمن دورة الطلب · دقّة المخزون · دقّة التسليم)، ولوحة استثناءاتٍ
 * تعرض ما يحتاج تدخّلًا فقط، ولقطةً لحظية موزَّعة على المبيعات والمخازن والنقل
 * والمخزون والمالية. كل رقمٍ فيها مردودٌ إلى مستنده.
 *
 * القاعدة الذهبية: لا حذف — صفحة ومكوّن جديدان (ledger/OperationsCommand).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import OperationsCommand from '../../components/brandzo-erp/ledger/OperationsCommand.jsx';
---

<DashboardLayout title="لوحة القيادة التشغيلية" showGuide={false} light>
  <div class="text-right" dir="rtl">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-2">لوحة القيادة التشغيلية</h1>
      <p class="text-ink-2 text-sm leading-relaxed max-w-3xl">
        الدورة المستندية العالمية في <span class="text-accent font-bold">شاشةٍ واحدة</span>: مؤشرات الأداء
        الأربعة، ولوحة استثناءاتٍ تعرض ما يحتاج تدخّلًا اليوم فقط، ولقطةٌ لحظية للمبيعات والمخازن والنقل
        والمخزون والمالية — تُحدَّث فور كل حركة، وكل رقمٍ فيها مردودٌ إلى مستنده.
      </p>
      <div class="w-20 h-1 bg-brand-red rounded-full mt-3"></div>
    </div>

    <OperationsCommand client:load />
  </div>
</DashboardLayout>
