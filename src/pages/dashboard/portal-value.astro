---
/**
 * لماذا البوابة تكامليّة لأودو — صفحة شرح الإنجاز وموقع البوابة من أودو.
 * عرضٌ خالص فوق `src/data/portal-value.json` + تفاعل طباعة بسيط.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import data from '../../data/portal-value.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<DashboardLayout title="لماذا البوابة تكامليّة لأودو" light>
  <div class="text-right" dir="rtl">
    {/* البطل */}
    <div class="mb-8 rounded-2xl bg-gradient-to-br from-brand-navy via-[#1a1a3e] to-[#0d0d2b] border border-accent/30 p-6 sm:p-10">
      <p class="text-[11px] text-muted mb-2">{data.meta.refNumber} · الإصدار {data.meta.version} · {data.meta.issued}</p>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-ink leading-snug mb-4">{data.hero.headline}</h1>
      <p class="text-sm sm:text-base text-ink-2 leading-relaxed max-w-4xl">{data.hero.lead}</p>
      <div class="mt-6 grid grid-cols-3 sm:grid-cols-6 gap-3">
        {data.stats.map((s) => (
          <div class="bg-white/5 border border-accent/20 rounded-xl p-3 text-center">
            <div class="text-xl sm:text-2xl font-extrabold text-brand-yellow">{s.value}</div>
            <div class="text-[10px] text-ink-2 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-3 no-print">
        <a href={`${base}/dashboard/reference-guide`} class="px-4 py-2 bg-chip border border-line text-ink rounded-xl text-xs font-bold hover:bg-surface-2 transition-all">الشرح التفاعلي للمرجع</a>
        <a href={`${base}/dashboard/acceptance-check`} class="px-4 py-2 bg-chip border border-line text-ink rounded-xl text-xs font-bold hover:bg-surface-2 transition-all">صفحة المطابقة والاستلام</a>
        <a href={`${base}/dashboard/role-activity`} class="px-4 py-2 bg-chip border border-line text-ink rounded-xl text-xs font-bold hover:bg-surface-2 transition-all">سجلّ حركة الأدوار</a>
        <button type="button" id="printValue" class="px-4 py-2 bg-brand-red text-white rounded-xl text-xs font-bold hover:bg-brand-red-dark transition-all">طباعة</button>
      </div>
    </div>

    {/* ركائز القيمة */}
    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink mb-4">ركائز القيمة</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {data.valuePillars.map((p) => (
          <div class="rounded-2xl bg-chip border border-line p-5">
            <h3 class="font-bold text-ink text-sm mb-2 flex items-center gap-2"><span class="w-1.5 h-5 rounded bg-brand-yellow shrink-0"></span>{p.title}</h3>
            <p class="text-xs text-ink-2 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* لا تُعيق أودو */}
    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink mb-1">{data.nonBlocking.title}</h2>
      <p class="text-xs text-muted mb-4">البوابة طبقةُ حوكمةٍ فوق أودو لا منافِسًا له — تُسرّع التنصيب وتقيس القبول.</p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
        {data.nonBlocking.points.map((pt) => (
          <div class="rounded-2xl bg-green-500/5 border border-green-500/20 p-4">
            <h3 class="font-bold text-green-300 text-sm mb-1">{pt.t}</h3>
            <p class="text-xs text-ink-2 leading-relaxed">{pt.d}</p>
          </div>
        ))}
      </div>
    </section>

    {/* المرونة */}
    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink mb-4">{data.flexibility.title}</h2>
      <div class="rounded-2xl bg-chip border border-line p-6">
        <ul class="space-y-3">
          {data.flexibility.points.map((pt) => (
            <li class="text-sm text-ink-2 leading-relaxed flex gap-3"><span class="text-brand-yellow shrink-0 font-bold">◆</span><span>{pt}</span></li>
          ))}
        </ul>
      </div>
    </section>

    {/* تتبّع الأدوار */}
    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink mb-1">{data.roleTracking.title}</h2>
      <p class="text-sm text-ink-2 leading-relaxed mb-4 max-w-4xl">{data.roleTracking.lead}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {data.roleTracking.features.map((f) => (
          <div class="rounded-2xl bg-chip border border-line p-5">
            <h3 class="font-bold text-ink text-sm mb-2">{f.t}</h3>
            <p class="text-xs text-ink-2 leading-relaxed">{f.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-4 no-print">
        <a href={`${base}/dashboard/role-activity`} class="inline-block px-5 py-2.5 bg-brand-navy text-white rounded-xl text-xs font-bold hover:opacity-90 transition-all">افتح سجلّ حركة الأدوار الحيّ ←</a>
      </div>
    </section>

    {/* تقسيم الأدوار — جدول المقارنة */}
    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink mb-4">{data.comparison.title}</h2>
      <div class="rounded-2xl bg-chip border border-line overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-right border-collapse min-w-[560px]">
            <thead>
              <tr class="text-ink-2 border-b border-line text-[11px]">
                <th class="p-3 font-bold">الجانب</th>
                <th class="p-3 font-bold">دور البوابة</th>
                <th class="p-3 font-bold">دور أودو</th>
              </tr>
            </thead>
            <tbody>
              {data.comparison.rows.map((r) => (
                <tr class="border-b border-line align-top">
                  <td class="p-3 font-bold text-ink">{r.aspect}</td>
                  <td class="p-3 text-ink-2">{r.portal}</td>
                  <td class="p-3 text-ink-2">{r.odoo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* مسار التكامل */}
    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink mb-4">{data.integration.title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {data.integration.steps.map((step, i) => (
          <div class="rounded-2xl bg-chip border border-line p-5 relative">
            <span class="absolute -top-3 right-4 w-8 h-8 rounded-full bg-brand-navy text-brand-yellow flex items-center justify-center font-extrabold text-sm">{i + 1}</span>
            <p class="text-xs text-ink-2 leading-relaxed mt-3">{step}</p>
          </div>
        ))}
      </div>
    </section>

    {/* اعتماد */}
    <section class="rounded-2xl bg-gradient-to-br from-brand-navy to-[#0d0d2b] border border-line p-6">
      <h2 class="text-sm font-bold text-ink mb-6 text-center">اعتماد</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-2xl mx-auto text-center">
        <div>
          <img src={`${base}/identity/signatures/signature-2.png`} alt="توقيع محمد البرشي" class="h-16 mx-auto mb-2 object-contain" />
          <p class="font-bold text-ink text-sm">محمد البرشي</p>
          <p class="text-[11px] text-muted">مدير إدارة السلاسل والإمداد والمخازن</p>
        </div>
        <div>
          <img src={`${base}/identity/signatures/signature-1.png`} alt="توقيع رمزي الباش" class="h-16 mx-auto mb-2 object-contain" />
          <p class="font-bold text-ink text-sm">رمزي الباش</p>
          <p class="text-[11px] text-muted">مدير إدارة الخدمات اللوجستية والخدمية</p>
        </div>
      </div>
    </section>
  </div>

  <style>
    @media print { .no-print { display: none !important; } }
  </style>

  <script>
    document.getElementById('printValue')?.addEventListener('click', function () { window.print(); });
  </script>
</DashboardLayout>
