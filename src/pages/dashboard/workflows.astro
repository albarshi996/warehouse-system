---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/tokens.css';
import '../../styles/odoo.css';
import Icon from '../../components/ui/Icon.astro';
import FAQ from '../../components/brandzo-erp/FAQ.jsx';
import org from '../../data/org-structure.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

/*
 * /dashboard/workflows — الهيكل والمسارات (لمسة أودو الفاتحة).
 * صفحةٌ تعريفيّة تشرح الهيكل التنظيمي والدورة المستندية الاثنتي عشرة والقواعد
 * الذهبية والتكامل مع أودو. مُرحّلة إلى نمط البوابة الموحّد: حاوية .o_theme
 * وبطاقات وأقسام أودو، بلا إيموجي (أيقونات SVG خطّية) والأحمر للتحذير فقط.
 */
const pillars = [
  { title: 'قسم الحوكمة المستندية', icon: 'shield', desc: 'اعتماد الأذونات والترحيل' },
  { title: 'إدارة الجودة', icon: 'checkCircle', desc: 'التدقيق والتحقق' },
  { title: 'سلاسل الإمداد', icon: 'truck', desc: 'التخطيط واللوجستيات' },
  { title: 'إدارة المستودعات', icon: 'warehouse', desc: 'ملكية المخزون' },
  { title: 'الإدارة التجارية', icon: 'shoppingCart', desc: 'المشتريات والعقود' },
  { title: 'إدارة المالية', icon: 'dollarSign', desc: 'الرقابة المالية' },
  { title: 'الإدارة التقنية', icon: 'settings', desc: 'الأنظمة والدعم' },
  { title: 'الموارد البشرية', icon: 'users', desc: 'رأس المال البشري' },
];

const stages = [
  { num: '01', title: 'طلب الشراء (PR)', desc: 'Purchase Requisition', form: 'النموذج ١ — طلب شراء داخلي', role: 'موظف التجارية / المشتريات · اعتماد مدير الإدارة التجارية' },
  { num: '02', title: 'أمر الشراء (PO)', desc: 'Purchase Order', form: 'النموذج ٢ — أمر الشراء', role: 'مدير الإدارة التجارية + مدير إدارة المالية' },
  { num: '03', title: 'إشعار الشحن المسبق (ASN)', desc: 'Advanced Shipping Notice', form: 'النموذج ٣ — إشعار الشحن المسبق', role: 'موظف التجارية / المشتريات + قسم عمليات المستودع' },
  { num: '04', title: 'الاستلام والفحص (GRN + QC)', desc: 'Goods Received Note + Quality Check', form: 'النموذجان ٤ و٥ — مذكرة استلام بضاعة + تقرير فحص جودة', role: 'قسم عمليات المستودع + موظف الجودة' },
  { num: '05', title: 'التخزين الموجّه (Putaway)', desc: 'Putaway List + Bin Card', form: 'النموذجان ٦ و٧ — أمر تخزين موجه + بطاقة مراقبة الموقع', role: 'قسم عمليات المستودع' },
  { num: '06', title: 'التحضير (Pick & Pack)', desc: 'Picking & Packing — FEFO', form: 'النماذج ٨ و٩ و١٠ — طلب صرف داخلي + قائمة السحب + قائمة التعبئة', role: 'قسم عمليات المستودع' },
  { num: '07', title: 'الشحن والتوزيع (Dispatch)', desc: 'Delivery + Gate Pass', form: 'النموذجان ١١ و١٢ — إذن تسليم + تصريح خروج بوابة', role: 'قسم العمليات اللوجستية + موظف النقل والحركة' },
  { num: '08', title: 'المرتجعات (Returns)', desc: 'Return Note / Damaged Goods', form: 'النماذج ١٤ و١٥ و١٧ — إشعار مرتجع + تقرير بضاعة تالفة + إشعار دائن', role: 'قسم عمليات المستودع · اعتماد مدير إدارة المستودعات' },
  { num: '09', title: 'المطابقة الثلاثية', desc: '3-Way Match', form: 'مطابقة: أمر الشراء + مذكرة الاستلام + فاتورة المورد', role: 'موظف المالية / المحاسبة' },
  { num: '10', title: 'فاتورة المورد (Bill)', desc: 'Vendor Bill', form: 'تسجيل الالتزام المالي بعد نجاح المطابقة', role: 'موظف المالية / المحاسبة · اعتماد مدير إدارة المالية' },
  { num: '11', title: 'قيد اليومية', desc: 'Journal Entry', form: 'ترحيل آلي من تقييم المخزون (Inventory Valuation)', role: 'موظف المالية / المحاسبة' },
  { num: '12', title: 'الإغلاق المالي', desc: 'Financial Close', form: 'إغلاق الفترة — يشمل النموذجين ١٦ و١٨ (سند التسوية + ورقة الجرد)', role: 'مدير إدارة المالية' },
];

const rules = [
  { icon: 'shoppingCart', title: 'حوكمة الشراء', desc: 'لا أمر شراء (PO) دون طلب شراء (PR) معتمد من مدير الإدارة التجارية.' },
  { icon: 'checkCircle', title: 'بوابة الجودة (QC)', desc: 'لا اعتماد استلام «Done» قبل توقيع موظف الجودة على تقرير الفحص.' },
  { icon: 'layers', title: 'FEFO', desc: 'يُصرف الأقرب انتهاءً أولًا (First Expired, First Out) في كل عمليات الصرف.' },
  { icon: 'shieldCheck', title: 'تصريح البوابة (Gate Pass)', desc: 'لا تخرج أي مركبة من بوابة المستودع دون تصريح معتمد مربوط بإذن التسليم.' },
  { icon: 'checkSquare', title: 'المطابقة الثلاثية (3-Way Match)', desc: 'لا ترحيل لفاتورة مورّد قبل تطابق (أمر الشراء + مذكرة الاستلام + الفاتورة).' },
  { icon: 'shield', title: 'حارس التسويات', desc: 'لا تعديل لأي رصيد يدويًّا دون سند تسوية معتمد من مدير إدارة المالية.' },
];

const odooModules = ['المخزون → Inventory Module', 'المشتريات → Purchase Module', 'المبيعات → Sales Module', 'المحاسبة → Accounting Module'];
const odooBenefits = ['بيانات دقيقة 98.5%', 'مزامنة فورية', 'تقارير موحدة', 'امتثال كامل'];
---

<DashboardLayout title="الهيكل والمسارات" light>
<style is:inline>
  /* مخصّصات الصفحة — معزولة تحت .o_theme وبتوكِنز أودو (var(--o-*)) فقط. */
  .o_theme .o_wf_head h1 { font-size: 24px; font-weight: var(--o-font-weight-bold); color: var(--o-main-text-color); margin: 0; }
  .o_theme .o_wf_head .en { display: block; font-size: var(--o-font-size-sm); font-weight: var(--o-font-weight-medium); color: var(--o-main-color-muted); margin-top: 3px; }
  .o_theme .o_wf_head p { font-size: var(--o-font-size-sm); color: var(--o-main-color-muted); margin: 8px 0 0; line-height: 1.8; max-width: 780px; }

  .o_theme .o_grid_cards { display: grid; gap: 12px; }
  .o_theme .o_grid_cards.cols4 { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .o_theme .o_grid_cards.cols3 { grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }

  .o_theme .o_tile { border: 1px solid var(--o-border-color); border-radius: var(--o-border-radius-lg); background: var(--o-view-background); box-shadow: var(--o-shadow-card); padding: 16px; transition: box-shadow .15s ease, transform .15s ease; }
  .o_theme .o_tile:hover { box-shadow: var(--o-shadow-card-hover); transform: translateY(-2px); }
  .o_theme .o_tile_ic { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--o-border-radius-lg); background: var(--o-badge-info-bg); color: var(--o-action); margin-bottom: 10px; }
  .o_theme .o_tile h3 { font-size: var(--o-font-size-sm); font-weight: var(--o-font-weight-bold); color: var(--o-main-text-color); margin: 0 0 4px; }
  .o_theme .o_tile p { font-size: var(--o-font-size-xs); color: var(--o-main-color-muted); margin: 0; line-height: 1.6; }

  .o_theme .o_stage { border: 1px solid var(--o-border-color); border-radius: var(--o-border-radius-lg); background: var(--o-view-background); box-shadow: var(--o-shadow-card); padding: 14px 16px; transition: box-shadow .15s ease, transform .15s ease; }
  .o_theme .o_stage:hover { box-shadow: var(--o-shadow-card-hover); transform: translateY(-2px); }
  .o_theme .o_stage .num { font-size: 20px; font-weight: var(--o-font-weight-bold); color: var(--o-action); line-height: 1; }
  .o_theme .o_stage h3 { font-size: var(--o-font-size-sm); font-weight: var(--o-font-weight-bold); color: var(--o-main-text-color); margin: 8px 0 2px; }
  .o_theme .o_stage .en { font-size: var(--o-font-size-xs); color: var(--o-main-color-muted); }
  .o_theme .o_stage .meta { font-size: var(--o-font-size-xs); color: var(--o-main-color-muted); margin-top: 9px; display: flex; gap: 6px; align-items: flex-start; line-height: 1.55; }
  .o_theme .o_stage .meta svg { flex: none; margin-top: 1px; color: var(--o-action); }

  .o_theme .o_list_check { list-style: none; margin: 0; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .o_theme .o_list_check li { display: flex; align-items: center; gap: 9px; font-size: var(--o-font-size-sm); color: var(--o-main-text-color); }
  .o_theme .o_list_check li svg { flex: none; color: var(--o-text-success); }

  .o_theme .o_wf_note { font-size: var(--o-font-size-sm); color: var(--o-main-color-muted); line-height: 1.9; margin: 16px 0 0; }
  .o_theme .o_wf_note strong { color: var(--o-main-text-color); }
  .o_theme .o_wf_note a { color: var(--o-action); text-decoration: underline; }
  .o_theme .o_wf_actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .o_theme .o_wf_actions .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; font-weight: var(--o-font-weight-bold); text-decoration: none; }
  .o_theme .o_wf_foot { margin-top: 28px; text-align: center; font-size: var(--o-font-size-xs); color: var(--o-main-color-muted); line-height: 1.9; }
  .o_theme .o_wf_foot a { color: var(--o-action); text-decoration: underline; }
</style>

<div class="o_theme" dir="rtl">
  <div class="o_dashboard">
    <div class="o_wf_head" style="margin-bottom:22px">
      <h1>الهيكل والمسارات<span class="en">Organizational Structure &amp; Document Cycle</span></h1>
      <p>خريطة الحوكمة التشغيلية للمستودعات: الإدارات الرسمية، والدورة المستندية الاثنتا عشرة من الطلب إلى الإغلاق المالي، والقواعد الذهبية المفروضة آليًّا، وتقابلها في أودو.</p>
    </div>

    <!-- الهيكل التنظيمي -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="building2" size={16} /> الهيكل التنظيمي للمستودعات</div>
      <div class="o_grid_cards cols4">
        {pillars.map((p) => (
          <div class="o_tile">
            <span class="o_tile_ic"><Icon name={p.icon} size={19} /></span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
      <p class="o_wf_note">
        ٨ إدارات رسمية تتفرّع إلى <strong>{org.jobs.length} وظيفة معتمدة</strong> وفق تقرير هيكل الوظائف والأدوار (العدّ من المصدر الواحد آليًّا).
      </p>
      <div class="o_wf_actions">
        <a href={`${base}/تقرير-هيكل-الوظائف-والادوار.html`} target="_blank" class="btn btn-primary"><Icon name="fileText" size={16} /> عرض التقرير الكامل</a>
        <a href={`${base}/dashboard/recruitment`} class="btn btn-secondary"><Icon name="userPlus" size={16} /> الهيكل والتوظيف</a>
      </div>
    </div>

    <!-- الدورة المستندية -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="workflows" size={16} /> الدورة المستندية الكاملة</div>
      <div class="o_grid_cards cols3">
        {stages.map((s) => (
          <div class="o_stage">
            <div class="num">{s.num}</div>
            <h3>{s.title}</h3>
            <div class="en">{s.desc}</div>
            <div class="meta"><Icon name="fileText" size={14} /> <span>{s.form}</span></div>
            <div class="meta"><Icon name="users" size={14} /> <span>{s.role}</span></div>
          </div>
        ))}
      </div>
      <p class="o_wf_note">
        وبين المرحلتين ٠٨ و٠٩ تجري رقابة المخزون المستمرة: <strong>الجرد الدوري</strong> (النموذج ١٨)
        و<strong>التسويات المخزنية</strong> (النموذج ١٦) — بحارس اعتماد المدير المالي.
        النماذج المذكورة كلها من <strong>مصفوفة الـ٢١ نموذج رسمي</strong> وتُنشأ وتُعتمد في
        <a href={`${base}/dashboard/documents`}>المستندات الحيّة</a>.
      </p>
      <div class="o_wf_actions">
        <a href={`${base}/المرجع-التشغيلي-الرسمي.html`} target="_blank" class="btn btn-primary"><Icon name="bookOpen" size={16} /> المرجع التشغيلي الرسمي</a>
        <a href={`${base}/تقرير-الدورة-المستندية.html`} target="_blank" class="btn btn-secondary"><Icon name="fileText" size={16} /> تقرير الدورة المستندية</a>
      </div>
    </div>

    <!-- القواعد الذهبية -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="shieldCheck" size={16} /> القواعد الذهبية — الحُرّاس الستة</div>
      <p class="o_wf_note" style="margin:0 0 12px">المبدأ الحاكم: «لا حركة بدون مستند موقّع» — قواعد إلزامية لا يجوز الاستثناء منها، مفروضة آليًّا داخل موديول أودو.</p>
      <div class="o_grid_cards cols3">
        {rules.map((r) => (
          <div class="o_tile">
            <span class="o_tile_ic"><Icon name={r.icon} size={19} /></span>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- التكامل مع أودو -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="puzzle" size={16} /> التكامل مع أودو</div>
      <div class="o_dashboard_grid2">
        <div class="o_dashboard_card">
          <div class="o_dashboard_card_head"><span>الوحدات المقابلة في أودو</span></div>
          <ul class="o_list_check">
            {odooModules.map((m) => (<li><Icon name="checkCircle" size={16} /> {m}</li>))}
          </ul>
        </div>
        <div class="o_dashboard_card">
          <div class="o_dashboard_card_head"><span>مزايا التكامل</span></div>
          <ul class="o_list_check">
            {odooBenefits.map((b) => (<li><Icon name="checkCircle" size={16} /> {b}</li>))}
          </ul>
        </div>
      </div>
    </div>

    <!-- مُقاس على العالم -->
    <div class="o_dashboard_section">
      <div class="o_dashboard_section_title"><Icon name="globe" size={16} /> هذا الهيكل مُقاس على العالم</div>
      <div class="o_dashboard_card">
        <div style="padding:18px">
          <p class="o_wf_note" style="margin:0">
            الدورة الاثنتا عشرة والهيكل الوظيفي ليسا اجتهادًا محليًّا: قِيسا في
            <strong>دراسة مقارنة عالمية</strong> على ثمانية نماذج تشغيلية
            (وول مارت · أمازون · إيكيا · شي إن · علي بابا · كارفور · نون · إي باي) —
            بفجوات مُدلَّلة ومؤشرات أداء ومخاطر وأسئلة قرار وخارطة توصيات.
          </p>
          <div class="o_wf_actions">
            <a href={`${base}/dashboard/comparative-study`} class="btn btn-primary"><Icon name="barChart3" size={16} /> الدراسة المقارنة العالمية</a>
            <a href={`${base}/dashboard/global-doc-cycles`} class="btn btn-secondary"><Icon name="globe" size={16} /> الدورات المستندية العالمية</a>
            <a href={`${base}/dashboard/studies`} class="btn btn-secondary"><Icon name="bookOpen" size={16} /> مركز الدراسات</a>
          </div>
        </div>
      </div>
    </div>

    <FAQ client:load />

    <footer class="o_wf_foot">
      مصدر البيانات:
      <a href={`${base}/المرجع-التشغيلي-الرسمي.html`} target="_blank">المرجع التشغيلي الرسمي</a>
      (الدورة الـ١٢ ومصفوفة الـ٢١ نموذج) ·
      <a href={`${base}/تقرير-هيكل-الوظائف-والادوار.html`} target="_blank">تقرير هيكل الوظائف والأدوار</a>
      (١٨ وظيفة).
    </footer>
  </div>
</div>
</DashboardLayout>
