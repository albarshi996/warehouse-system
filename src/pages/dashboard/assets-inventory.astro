<!--
  ‹ASSET-101› كان هذا «تأكيدَ الحذف». ولا حذفَ في القاعدة: الأصلُ الخارجُ
  **يُكهَّن بسببٍ مكتوب** — فرقمُه مطبوعٌ على شيءٍ كان في الإدارة، ومحوُه
  يجعل جردًا قديمًا يذكر ما لا وجودَ له. و`firestore.rules` تمنع `delete`
  أصلًا، فنافذةُ حذفٍ كانت ستفشل عند الضغط لا قبله.
-->
<div class="modal-bg" id="arch-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-icon" id="arch-icon">⚠️</div>
      <div class="modal-title" id="arch-title">تكهين الأصل</div>
    </div>
    <div class="modal-body">
      <div id="arch-lead">تُكهَّن <strong id="arch-asset-id"></strong> فتخرج من الجرد — <strong>ولا تُحذف</strong>.</div>
      <label for="arch-reason" style="display:block;margin:14px 0 6px;font-size:12px;font-weight:600;color:var(--ink-2)">
        السبب <span style="color:#b91c1c">✱</span>
      </label>
      <textarea id="arch-reason" placeholder="مثال: تلفٌ نهائيّ · سُلّم للصيانة · نُقل لشركةٍ أخرى"></textarea>
      <div class="modal-note" id="arch-note">
        ورقمُها يبقى محجوزًا، ويُرى الأصلُ بتأشير «أظهر المكهَّن» — ويمكن إرجاعُه بسببٍ مكتوب.
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeArchModal()">إلغاء</button>
      <button class="btn btn-danger" id="arch-confirm" style="background:#b91c1c;color:#fff;border-color:#b91c1c" onclick="confirmArchive()">كهّن</button>
    </div>
  </div>
</div>
<div id="toast"></div>

<script>
// الوسم كان `is:inline` فلم يقبل استيرادًا، فكرّر كلّ شيءٍ محلّيًّا: نسخةَ
// تهريبٍ سابعة، وخريطتَي أعمدة الإكسل، والتصفية والإحصاء والترقيم — وكلّه
// خارج نطاق أيّ اختبار. وحُزم هنا ليأخذها من النواة. والدوالّ ما زالت تُعلَّق
// على `window` كما كانت، فمعالجات `onclick` في المحرَّر تجدها كما تجدها اليوم.
import {
  parseAssetRows, assetStats, filterAssets, nextAssetId,
} from '../../services/assets/assetsModel.js';
// ‹ASSET-101› كانت الشاشةُ تعمل في `let assets = []` وحدَه، فكلُّ ما يُدخَل
// فيها يضيع عند تحديث الصفحة. والآن `assets` **مرآةُ القاعدة**: يكتبها
// المستمعُ الحيّ وحدَه، ولا يكتبها معالجُ زرٍّ أبدًا — فسجلٌّ يُدفع في
// المصفوفة بلا كتابةٍ في السحابة يُظهر نجاحًا كاذبًا ويزول عند التحديث.
import {
  splitArchived, describeImportPlan, workbookToAssetRows, readAssetFiles,
  splitImportFiles, writeErrorMessage, readErrorMessage, cloudChipState, reasonModalCopy,
} from '../../services/assets/departmentAssets.js';
import {
  assetWorkbookModel, assetPrintModel, exportFileName,
} from '../../services/assets/assetsExport.js';
import {
  tableRowsHtml, cardsHtml, countLineHtml, deptBarsHtml, printRowsHtml,
  FORM_FIELDS, missingFormFields,
} from '../../services/assets/assetsView.js';
import {
  listenDepartmentAssets,
  saveDepartmentAsset,
  archiveDepartmentAsset,
  restoreDepartmentAsset,
  importDepartmentAssets,
  todayLocal,
} from '../../services/assets/departmentAssetsService.js';
import { subscribeAuth, fetchUserProfile } from '../../services/auth/authService.js';

// أدوارُ الكتابة — **للعرض فقط**؛ والإلزامُ الحقيقيّ في `firestore.rules`
// (`isManager` على `department_assets`). والقائمةُ نسخةُ تلك حرفيًّا.
//
// ★ وقرارُ المالك 2026-10-19: المديران وحدهما. وقِيس أنّ الشاشةَ يراها ثمانيةُ
// أدوارٍ فعُرض عليه الأمر، فاختار **أنّ تعريفَ ما تملكه الشركةُ قرارٌ إداريّ**
// — كتعريفِ ما يملكه المستودع في `warehouse_assets`. والستّةُ الباقيةُ **تقرأ
// ولا تكتب**، وتُقال لها ذلك في الشارة لا بزرٍّ يُضغط فيُرفض.
const WRITER_ROLES = ['admin', 'warehouse_manager'];

let assets = [];
let profile = null;
let canWrite = false;
let editId = null;
let archiveId = null;
let archiveMode = 'archive'; // 'archive' | 'restore'
let currentView = 'list';
let nextIdNum = 1;

function generateId() {
  const { id, next } = nextAssetId(assets, nextIdNum);
  nextIdNum = next;
  return id;
}
let _tt;
function showToast(msg, type='success', ms=3500) {
  const el = document.getElementById('toast');
  if (!el) return;
  el.textContent = msg;
  el.className = 'show t-' + type;
  clearTimeout(_tt);
  _tt = setTimeout(() => el.className = '', ms);
}

// ─── حالةُ السحابة والصلاحيّة ────────────────────────────────────────────
function setCloud(state, text) {
  const chip = document.getElementById('cloud-chip');
  if (!chip) return;
  chip.classList.remove('online', 'pending', 'offline', 'denied');
  chip.classList.add(state);
  document.getElementById('cloud-chip-text').textContent = text;
}
window.addEventListener('online',  () => setCloud('online',  'متصل — متزامن'));
window.addEventListener('offline', () => setCloud('offline', 'بلا إنترنت — يُحفظ محلّيًّا ويُرفع'));

/**
 * يُخفي أدواتَ الكتابة عمّن لا يملكها.
 *
 * ★ ويُنادى **عند الإقلاع أيضًا** و`canWrite` حينها `false`: فزرٌّ ظاهرٌ قبل
 * أن تُعرف الصلاحيّةُ يُضغط فيُرفَض، والأسلمُ ألّا يُرى حتّى تُعرف. ولا يلمس
 * شارةَ السحابة — تلك تقول حالةَ الاتّصال لا حالةَ الصلاحيّة.
 */
function applyWriteGate() {
  document.querySelectorAll('.writer-only').forEach((el) => { el.hidden = !canWrite; });
}

/** ★ الحارسُ الأماميُّ يسبق الطلب: رفضُ القاعدة رسالةٌ غامضة، وهذا نصٌّ يُفهم. */
function guardWrite() {
  if (canWrite) return true;
  showToast('حسابُك يقرأ هذه الشاشة ولا يكتب فيها — والحدُّ في قاعدة البيانات.', 'warn');
  return false;
}

/** الحيُّ وحدَه: المكهَّنُ لا يدخل رقمًا من أرقام اللقطة. */
const liveAssets = () => splitArchived(assets).live;
const showArchived = () => !!document.getElementById('filter-archived')?.checked;

function updateStats() {
  const st = assetStats(liveAssets());
  document.getElementById('s-total').textContent = st.total;
  document.getElementById('s-qty').textContent   = st.quantity;
  document.getElementById('s-good').textContent  = st.good;
  document.getElementById('s-bad').textContent   = st.bad;
  const chart = document.getElementById('dept-chart');
  const bars  = document.getElementById('chart-bars');
  chart.classList.toggle('visible', st.departments.length > 0);
  bars.innerHTML = deptBarsHtml(st.departments);
  const has = st.total > 0;
  document.getElementById('export-btn').disabled = !has;
  document.getElementById('print-btn').disabled  = !has;
}
function getFiltered() {
  const base = showArchived() ? assets : liveAssets();
  return filterAssets(base, {
    q: document.getElementById('search-input').value || '',
    department: document.getElementById('filter-dept').value,
    condition: document.getElementById('filter-cond').value,
  });
}
function renderTable() {
  const filtered = getFiltered();
  const count  = document.getElementById('record-count');
  const empty  = document.getElementById('empty-state');
  const tableV = document.getElementById('table-view');
  const gridV  = document.getElementById('grid-view');
  const base = showArchived() ? assets : liveAssets();
  if (base.length === 0) {
    empty.classList.add('visible');
    tableV.style.display = 'none';
    gridV.style.display  = 'none';
    count.style.display  = 'none';
    return;
  }
  empty.classList.remove('visible');
  count.style.display = 'block';
  count.innerHTML = countLineHtml({ shown: filtered.length, base: base.length, hidden: assets.length - base.length });
  // ★ البناءُ في `assetsView.js` مختبَرًا: التهريبُ في موضعين بمهرِّبَين
  // مختلفين · وحصرُ الكتابة (زرٌّ يُرسم لقارئٍ يُرفَض فيُقرأ عطبًا) · ووسمُ
  // المكهَّن (أصلٌ خارجٌ يُعرض كالقائم يُصدَّق جردًا).
  document.getElementById('table-body').innerHTML = tableRowsHtml(filtered, canWrite);
  gridV.innerHTML = cardsHtml(filtered, canWrite);
  if (currentView === 'list') {
    tableV.style.display = 'block'; gridV.style.display = 'none';
  } else {
    tableV.style.display = 'none'; gridV.style.display = 'grid';
  }
}
function switchView(v) {
  currentView = v;
  document.getElementById('vt-list').classList.toggle('active', v==='list');
  document.getElementById('vt-grid').classList.toggle('active', v==='grid');
  renderTable();
}
// ─── النموذجُ: خريطةٌ واحدةٌ تخدم التفريغَ والتعبئةَ والقراءة ──────────────
// وكانت ثلاثَ قوائمَ متوازيةٍ هنا — فحقلٌ يُضاف ويُنسى في التفريغ يحمل قيمةَ
// الأصل السابق إلى الجديد، ولا شيء يشتكي. والخريطةُ في `assetsView.js`
// واختبارٌ يحرس أنّها تغطّي شكلَ السجلّ كلَّه.
const fieldEl = (f) => document.getElementById(f.id);

function clearForm() {
  for (const f of FORM_FIELDS) {
    const el = fieldEl(f);
    if (!el) continue;
    el.value = f.today ? todayLocal() : f.empty;
    el.classList.remove('error');
  }
}
function populateForm(a) {
  for (const f of FORM_FIELDS) {
    const el = fieldEl(f);
    if (el) el.value = a[f.key] == null ? '' : String(a[f.key]);
  }
}
/** قيمُ النموذج كسجلٍّ — مقصوصةً، والكمّيّةُ رقمًا. */
function readForm() {
  const out = {};
  for (const f of FORM_FIELDS) out[f.key] = (fieldEl(f)?.value ?? '').trim();
  out.qty = parseInt(out.qty, 10);
  return out;
}
window.toggleForm = function() {
  if (!guardWrite()) return;
  editId = null;
  const panel = document.getElementById('form-panel');
  if (panel.classList.contains('open')) { window.cancelForm(); return; }
  clearForm();
  const newId = generateId();
  document.getElementById('form-id-badge').textContent = newId;
  document.getElementById('form-id-badge').dataset.pendingId = newId;
  document.getElementById('form-title-text').textContent = 'إضافة أصل جديد';
  document.getElementById('submit-btn').textContent = 'إضافة الأصل';
  document.getElementById('toggle-form-btn').textContent = '✕ إلغاء';
  panel.classList.add('open');
  panel.scrollIntoView({ behavior:'smooth', block:'nearest' });
}
window.cancelForm = function() {
  editId = null;
  document.getElementById('form-panel').classList.remove('open');
  document.getElementById('toggle-form-btn').textContent = '+ إضافة أصل';
  clearForm();
}
window.submitForm = async function() {
  if (!guardWrite()) return;
  document.querySelectorAll('#form-panel .error').forEach(el => el.classList.remove('error'));
  const values = readForm();
  const missing = missingFormFields(values);
  if (missing.length) {
    missing.forEach((id) => document.getElementById(id)?.classList.add('error'));
    showToast('يرجى تعبئة الحقول الإلزامية ✱', 'error');
    return;
  }
  const record = {
    ...values,
    id: editId || document.getElementById('form-id-badge').dataset.pendingId || generateId(),
  };
  // ★★★ لا كتابةَ في `assets` هنا. المستمعُ الحيُّ هو من يكتبها حين يُقِرُّ
  // الخادمُ السجلَّ (أو حين تُقيَّد الكتابةُ محلّيًّا بلا شبكة) — فدفعُه في
  // المصفوفة يُظهر نجاحًا قبل أن يحصل، ويزول عند أوّل تحديثِ صفحة.
  const btn = document.getElementById('submit-btn');
  const was = btn.textContent;
  btn.disabled = true; btn.textContent = 'جارٍ الحفظ…';
  try {
    await saveDepartmentAsset(record, profile, { mode: editId ? 'edit' : 'create' });
    showToast(editId ? 'حُفظ التعديل في قاعدة البيانات ✓' : 'حُفظ الأصل في قاعدة البيانات ✓');
    window.cancelForm();
  } catch (e) {
    showToast(writeErrorMessage(e), 'error', 6000);
  } finally {
    btn.disabled = false; btn.textContent = was;
  }
}

window.startEdit = function(id) {
  if (!guardWrite()) return;
  const a = assets.find(x => x.id === id);
  if (!a) { showToast('الأصل غير موجود', 'error'); return; }
  editId = id;
  clearForm();
  populateForm(a);
  document.getElementById('form-id-badge').textContent = id;
  document.getElementById('form-id-badge').dataset.pendingId = id;
  document.getElementById('form-title-text').textContent = 'تعديل الأصل';
  document.getElementById('submit-btn').textContent = 'حفظ التعديلات';
  document.getElementById('toggle-form-btn').textContent = '✕ إلغاء';
  const panel = document.getElementById('form-panel');
  panel.classList.add('open');
  panel.scrollIntoView({ behavior:'smooth', block:'start' });
}
// ─── التكهينُ والإرجاعُ — بسببٍ مكتوب، ولا حذفَ في القاعدة ───────────────
function openReasonModal(id, mode) {
  if (!guardWrite()) return;
  const a = assets.find(x => x.id === id);
  if (!a) { showToast('الأصل غير موجود', 'error'); return; }
  archiveId = id;
  archiveMode = mode;
  const copy = reasonModalCopy(mode, id + (a.assetName ? ' — ' + a.assetName : ''));
  document.getElementById('arch-title').textContent = copy.title;
  document.getElementById('arch-lead').textContent = copy.lead;
  document.getElementById('arch-note').textContent = copy.note;
  const btn = document.getElementById('arch-confirm');
  btn.textContent = copy.confirm;
  btn.className = copy.danger ? 'btn btn-danger' : 'btn btn-primary';
  btn.style.cssText = copy.danger ? 'background:#b91c1c;color:#fff;border-color:#b91c1c' : '';
  const ta = document.getElementById('arch-reason');
  ta.value = ''; ta.classList.remove('error');
  ta.placeholder = copy.placeholder;
  document.getElementById('arch-modal').classList.add('open');
  ta.focus();
}
window.openArchModal    = (id) => openReasonModal(id, 'archive');
window.openRestoreModal = (id) => openReasonModal(id, 'restore');
window.closeArchModal = function() {
  archiveId = null;
  document.getElementById('arch-modal').classList.remove('open');
}
window.confirmArchive = async function() {
  if (!archiveId) { window.closeArchModal(); return; }
  if (!guardWrite()) return;
  const ta = document.getElementById('arch-reason');
  const reason = (ta.value || '').trim();
  // ★ السببُ إلزاميٌّ في الشاشة وفي المنطق الخالص معًا: تكهينٌ بلا سببٍ
  // حذفٌ بثوبٍ آخر — يخرج الأصلُ ولا يُعرف لماذا.
  if (!reason) {
    ta.classList.add('error'); ta.focus();
    showToast('السببُ مطلوب — فأصلٌ يخرج بلا سببٍ مكتوبٍ لا يُعرف لماذا خرج.', 'error');
    return;
  }
  const btn = document.getElementById('arch-confirm');
  const was = btn.textContent;
  btn.disabled = true; btn.textContent = 'جارٍ…';
  const id = archiveId;
  try {
    if (archiveMode === 'archive') await archiveDepartmentAsset(id, reason, profile);
    else await restoreDepartmentAsset(id, reason, profile);
    showToast(archiveMode === 'archive' ? `كُهِّن ${id} بسببه المكتوب` : `أُرجع ${id} إلى الجرد`, 'warn');
    window.closeArchModal();
  } catch (e) {
    showToast(writeErrorMessage(e), 'error', 6000);
  } finally {
    btn.disabled = false; btn.textContent = was;
  }
}

// ============ BULK IMPORT — supports up to 1000 files simultaneously ============
// ★★★ وتغيّر جوهرُه ‹ASSET-101›: كان يكتب فوقَ أيِّ رقمٍ قائم
// (`assets[idx]=rec` · `totalUpdated++`) — مقبولٌ في ذاكرةٍ تزول، ومُهلِكٌ في
// قاعدةٍ تبقى: استيرادٌ يُعاد بعد يومِ جردٍ يمحو عملَ اليوم كلِّه بلا صوت.
// فالقراءةُ هنا، **والقرارُ في `planAssetImport` المختبَرة**: لا يُكتب إلّا
// الغائب، والمتخطَّى يُسمَّى برقمه.
//
// ★ والمعينات وحدَها بقيت في الوسم (`FileReader` و`XLSX`)، وما سواها هبط إلى
// `departmentAssets.js` فصار مختبَرًا: اختيارُ الورقة · الدفعاتُ · عدُّ
// التالف. وكان اختيارُ الورقة هنا بلا اختبار — وهو موضعُ عطبين حيَّين سابقًا.

/** يقرأ ملفًّا واحدًا إلى صفوفِ أصول — المُعينُ الوحيدُ الذي يحتاج المتصفّح. */
function readAssetWorkbook(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onerror = () => reject(new Error(`تعذّرت قراءة ${file.name}`));
    reader.onload = (ev) => {
      try {
        const wb = XLSX.read(ev.target.result, { type: 'binary', cellDates: true, raw: false });
        resolve(workbookToAssetRows(wb, (ws, deptOverride) =>
          parseAssetRows(XLSX.utils.sheet_to_json(ws, { header: 1, defval: '', raw: false }), { deptOverride })));
      } catch (err) { reject(err); }
    };
    reader.readAsBinaryString(file);
  });
}

document.getElementById('import-file').addEventListener('change', async function(e) {
  const picked = Array.from(e.target.files);
  e.target.value = '';
  if (!picked.length) return;
  if (!guardWrite()) return;

  const { ok: validFiles, bad } = splitImportFiles(picked);
  if (bad.length) showToast(`${bad.length} ملف غير صالح — يُقبل xlsx و xls فقط`, 'error');
  if (!validFiles.length) return;

  showToast(`جاري قراءة ${validFiles.length} ملف…`, 'warn');
  const { rows, unreadable } = await readAssetFiles(validFiles, {
    readRows: readAssetWorkbook,
    yieldFn: () => new Promise((r) => setTimeout(r, 0)),
  });
  if (!rows.length) {
    showToast(unreadable ? `لم يُقرأ شيء — ${unreadable} ملفًّا تعذّرت قراءتُه` : 'لا صفوفَ في الملفّات.', 'error');
    return;
  }

  showToast(`قُرئ ${rows.length} صفًّا — جارٍ الكتابة بلا دهس…`, 'warn');
  try {
    const plan = await importDepartmentAssets(rows, profile);
    showToast(
      `${validFiles.length} ملف · ${describeImportPlan(plan)}`
        + (unreadable ? `
وتعذّرت قراءةُ ${unreadable} ملفًّا` : ''),
      plan.skipped.length ? 'warn' : 'success',
      11000
    );
  } catch (err) {
    showToast(writeErrorMessage(err), 'error', 8000);
  }
});

window.exportExcel = function() {
  // ‹ASSET-101› يُصدَّر ما يُعرَض: المكهَّنُ خارجٌ إلّا أن يُؤشَّر «أظهر
  // المكهَّن». وملفٌّ يحمل أصولًا كُهِّنت بلا علامةٍ يُقرأ جردًا قائمًا.
  //
  // ★ وبناءُ الأوراق هبط إلى `assetsExport.js` مختبَرًا صفًّا صفًّا: عمودٌ
  // يزيح عمودًا لا يُسقط شيئًا ولا يشتكي، فيُصدَّر ملفٌّ سليمٌ في الظاهر فيه
  // «الماركة» في خانة «السيريال». وهنا الكتابةُ بالمكتبة لا غير.
  const exported = showArchived() ? assets : liveAssets();
  if (!exported.length) return;
  const day = todayLocal();
  const model = assetWorkbookModel(exported, { exportedOn: new Date().toLocaleDateString('ar-SA') });
  const wb = XLSX.utils.book_new();
  for (const sheet of [model.summary, model.main, ...model.departments]) {
    const ws = XLSX.utils.aoa_to_sheet(sheet.rows);
    ws['!cols'] = sheet.widths.map((wch) => ({ wch }));
    XLSX.utils.book_append_sheet(wb, ws, sheet.name);
  }
  XLSX.writeFile(wb, exportFileName(day));
  showToast('تم تصدير ملف Excel بنجاح');
}

window.printPDF = function() {
  const filtered = getFiltered();
  if (!filtered.length) { showToast('لا توجد بيانات للطباعة', 'error'); return; }
  // ★ الأرقامُ من `assetPrintModel` — **بدوالّ العدّ التي تبني الإكسل نفسِها**.
  // فلو عدَّ كلُّ مخرجٍ بنفسه لَافترقا، ولا يُكشف الفرقُ إلّا حين يقارنهما أحد.
  const m = assetPrintModel(filtered);
  const dateStr = new Date().toLocaleDateString('ar-SA', { year:'numeric', month:'long', day:'numeric' });
  const put = (id, v) => { document.getElementById(id).textContent = v; };
  put('p-date', dateStr); put('p-footer-date', dateStr);
  put('p-total', m.total); put('p-qty', m.quantity);
  put('ps-total', m.total); put('ps-excellent', m.excellent);
  put('ps-good2', m.good); put('ps-bad', m.bad);
  document.getElementById('print-body').innerHTML = printRowsHtml(m.rows);
  setTimeout(()=>window.print(),150);
}

window.renderTable = renderTable;
window.switchView = switchView;

// ─── الدورُ والصلاحيّةُ ثمّ الاستماعُ الحيّ ───────────────────────────────
// ★ الاستماعُ **بعد** اكتمال المصادقة: قاعدةُ الأمن تُلزم `signedIn()`، فطلبٌ
// يُرسَل قبلها يُرفض بـ`permission-denied` ويُقرأ «الشاشةُ معطوبة».
let assetsUnsub = null;
applyWriteGate(); // الأسلمُ: لا أدواتَ كتابةٍ حتّى تُعرف الصلاحيّة
subscribeAuth(async (user) => {
  if (!user) return; // AuthGate يتكفّل بالتحويل
  profile = await fetchUserProfile(user);
  canWrite = WRITER_ROLES.includes(profile?.role);
  applyWriteGate();
  // ★ وتُقال الصلاحيّةُ في الشارة **هنا** لا في أوّل لقطةٍ وحدَها: الشارةُ هي
  // الموضعُ الوحيدُ الذي يُعلم القارئَ أنّه قارئ، فتأخيرُها إلى وصول البيانات
  // يجعله يرى «متصل — متزامن» ويبحث عن أزرارٍ أُخفيت بلا سبب. (أمسكه التشغيل.)
  if (!canWrite) { const c = cloudChipState({ canWrite, hasPending: false }); setCloud(c.state, c.text); }
  if (!assetsUnsub) {
    setCloud('pending', 'جارٍ التحميل…');
    assetsUnsub = listenDepartmentAssets(
      (list, hasPending) => {
        assets = list;
        // ★ الترقيمُ يُقرأ من **كلّ** السجلّات بما فيها المكهَّن: رقمُ أصلٍ
        // كُهِّن يبقى محجوزًا، وإعادةُ استعماله تخلط بين شيئين في جردٍ قديم.
        nextIdNum = nextAssetId(assets, 1).next - 1;
        const chip = cloudChipState({ canWrite, hasPending });
        setCloud(chip.state, chip.text);
        updateStats();
        renderTable();
      },
      (e) => {
        console.error('assets listen', e);
        setCloud('offline', e?.code === 'permission-denied' ? 'لا صلاحيّةَ قراءة' : 'تعذّر الاتّصال بالقاعدة');
        showToast(readErrorMessage(e), 'error', 8000);
      }
    );
  }
  updateStats();
  renderTable();
});

updateStats();
renderTable();
</script>

