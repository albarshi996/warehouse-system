---
/**
 * صفحة تسجيل الدخول — مستقلّة عن DashboardLayout (بلا سايدبار).
 * تحمي بقيّة البوابة عبر حارس AuthGate الموجود في DashboardLayout.
 */
import '../styles/global.css';
import PwaHead from '../components/pwa/PwaHead.astro';
import LoginForm from '../components/brandzo-erp/access/LoginForm.jsx';
---

{/* bz-light: صفحة الدخول أوّل ما يراه المستخدم كل جلسة — تُوحَّد مع اللوحة
    الفاتحة بدل تنافر «دخول داكن ← لوحة فاتحة». الخطّ من global.css (IBM Plex
    مستضاف ذاتيًّا) فحُذف رابط Cairo الخارجيّ احترامًا لقاعدة العمل دون اتصال. */}
<html lang="ar" dir="rtl" class="bz-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>تسجيل الدخول - Brandzo Hub 2026</title>
    <PwaHead />
  </head>

  <body class="bz-page-bg min-h-screen flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md">
      {/* يظهر حين يطرد AuthGate حسابًا موقوفًا (?disabled=1) — المحور ٢-ب */}
      <div
        id="bz-disabled-note"
        hidden
        class="mb-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-bold text-red-700 text-center"
      >
        هذا الحساب موقوف — راجع المدير العام لإعادة تفعيله.
      </div>
      <LoginForm client:load />
    </div>
    <script>
      if (new URLSearchParams(location.search).get('disabled') === '1') {
        const el = document.getElementById('bz-disabled-note');
        if (el) el.hidden = false;
      }
    </script>
  </body>
</html>
