# ═══════════════════════════════════════════════════════════════════════════
#  إعدادُ حاوية المزامنة — انسخ هذا الملفَّ إلى `db/.env` واملأ سطرين
# ═══════════════════════════════════════════════════════════════════════════
#
#      cp db/.env.example db/.env
#
#  ثمّ املأ `FIREBASE_EMAIL` و`FIREBASE_PASSWORD` وحدَهما. والباقي مملوءٌ
#  سلفًا: مفاتيحُ `PUBLIC_FIREBASE_*` **علنيّةٌ أصلًا** — هي عينُها المضمَّنةُ
#  في حزمة البوّابة وفي `scripts/firestore-export.mjs`، ولا سرَّ فيها.
#
#  ★ و`db/.env` مُتجاهَلٌ في `.gitignore` — لا يدخل git بحال.
#
#  ★★ ولماذا بريدُك أنت لا مفتاحُ حسابِ خدمة؟ لأنّ المزامنةَ تمرّ بنفس بوّابة
#     الصلاحيّات التي يمرّ بها التطبيق. مفتاحُ الخدمة يتجاوز `firestore.rules`
#     كلَّها — فلو أخطأ سطرٌ لقرأ ما لا يُقرأ. وبحسابك: ما لا تراه أنت في
#     البوّابة لا تراه المزامنة.
# ═══════════════════════════════════════════════════════════════════════════

# ── املأ هذين وحدَهما ──────────────────────────────────────────────────────
FIREBASE_EMAIL=
FIREBASE_PASSWORD=

# ── مملوءةٌ سلفًا: إعداداتُ المشروع العلنيّة ───────────────────────────────
PUBLIC_FIREBASE_API_KEY=AIzaSyAWhqQVdhODZT0bdXnbyYzcmpnv11s9qoU
PUBLIC_FIREBASE_AUTH_DOMAIN=brandzo-erp-2026.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=brandzo-erp-2026
PUBLIC_FIREBASE_STORAGE_BUCKET=brandzo-erp-2026.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=991460523040
PUBLIC_FIREBASE_APP_ID=1:991460523040:web:d3c6f76b1ff13a1ab8d045

# ── كلمةُ مرور القاعدة المحلّيّة (اتركها كما هي للتطوير) ───────────────────
POSTGRES_PASSWORD=warehouse_local_dev
