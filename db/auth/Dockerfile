# ═══════════════════════════════════════════════════════════════════════════
#  جسرُ الرمز — Node عارٍ بلا حزمةٍ واحدة
# ═══════════════════════════════════════════════════════════════════════════
#
#  ★★ لا `npm install` ولا `package.json`: التحقّقُ كلُّه بـ`node:crypto`
#     المدمج، والجلبُ بـ`fetch` المدمج. فالصورةُ صغيرةٌ وسطحُ هجومها ضيّق —
#     ولا تبعيّةَ تُرقَّى أو تُخترق.
# ═══════════════════════════════════════════════════════════════════════════
FROM node:22-bookworm-slim

WORKDIR /app
COPY db/auth/verify.js db/auth/bridge.mjs ./db/auth/

USER node
EXPOSE 3001
CMD ["node", "db/auth/bridge.mjs"]
