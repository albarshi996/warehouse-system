rules_version = '2';

/*
 * ═══════════════════════════════════════════════════════════════════
 *  قواعد أمان Firestore — Brandzo Hub
 * ═══════════════════════════════════════════════════════════════════
 *  ⚠️ الحالة قبل هذه القواعد: قاعدة البيانات كانت مفتوحة للعالم —
 *     أي شخص يقرأ ويكتب ويحذف دون حساب (مُثبت بالاختبار 2026-07-14).
 *
 *  المبادئ:
 *   1. لا شيء بلا تسجيل دخول.
 *   2. الأدوار لا يعدّلها إلا المدير العام (وإلا رقّى كل موظّف نفسه).
 *   3. سجلّ المسح **غير قابل للتعديل أو الحذف** — التاريخ لا يُزوَّر
 *      (التصحيح يكون بقيد جديد، لا بمحو القديم).
 *
 *  كيف تنشرها:
 *   Firebase Console → Firestore Database → Rules → الصق هذا الملف → Publish
 * ═══════════════════════════════════════════════════════════════════
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // تمهيد المدير العام بالبريد — يطابق التمهيد في authService.js.
    // ضروري لكسر الحلقة المفرغة: بلا مستند دور لا صلاحية، وبلا صلاحية
    // لا يمكن إنشاء مستند الدور. عدّل البريد هنا وهناك معاً عند الحاجة.
    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'albarshi.96@gmail.com';
    }

    // الحساب المفعَّل: `active != false` يعامل غياب الحقل (وثائق قديمة)
    // كمفعَّل، فلا ينكسر أحد. الموقوف (`active == false`) يسقط من كل الأدوار
    // أدناه فلا يكتب شيئًا حسّاسًا — حتى لو التفّ على الواجهة برمزٍ صالح بعدُ.
    // الاستدعاء يعيد استعمال قراءة get() نفسها المخزّنة مع myRole() فبلا كلفة.
    // المدير العام المُمهَّد بالبريد فوق هذا (يستحيل أن يقفل نفسه).
    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (signedIn() && hasProfile() && isActive() && myRole() == 'admin');
    }

    function isManager() {
      return isBootstrapAdmin() ||
             (signedIn() && hasProfile() && isActive() && myRole() in ['admin', 'warehouse_manager']);
    }

    // كاتبو جرد المركبات: دور «الحركة» + المديرَان (تعاون المخازن والحركة).
    function isFleetWriter() {
      return isBootstrapAdmin() ||
             (signedIn() && hasProfile() && isActive() && myRole() in ['admin', 'warehouse_manager', 'fleet']);
    }

    // مشرفو المناولة: دور «مشرف المناولة» + المديرَان — يديرون فرق عمالة
    // الشحن/التفريغ ومهامها الزمنيّة (المحور الثاني).
    function isLaborWriter() {
      return isBootstrapAdmin() ||
             (signedIn() && hasProfile() && isActive() && myRole() in ['admin', 'warehouse_manager', 'labor_supervisor']);
    }

    // الفاعلون المخزنيون: من يملكون إنجاز مستندٍ يُحرّك المخزون, فيحتاجون
    // قيد الحركة وتعديل الرصيد. المجموعة = كل من يظهر `complete` في مخطّطات
    // الدورة (GRN·QC·PUTAWAY·PICK·DN·RET·DMG·ADJ) + المديرَان. **ودور الحركة
    // (fleet) أُضيف** لأنه يُنجز **تأكيد التسليم (POD)** فيخصم رصيد المركبة
    // (قرار المالك 2026-08-04). بوّابة `completeRoles` تحصر ما يُنجزه كلّ دور،
    // فالحركة لا تُنجز إلا POD. المشاهد ومستخدم الإدارة وحدهما خارجها.
    function isStockActor() {
      return isBootstrapAdmin() ||
             (signedIn() && hasProfile() && isActive() && myRole() in [
               'admin', 'warehouse_manager', 'storekeeper', 'qc_inspector',
               'gate_officer', 'purchase_officer', 'return_manager',
               'inventory_auditor', 'finance_manager', 'fleet'
             ]);
    }

    // فاعلو دورة المشتريات الداخلية (طلبات الإدارات من المالية): من يُنشئ أو
    // يعتمد حلقةً في سلسلة IPR→RFQ→IPO→PV→DLV. يضمّ **مستخدم الإدارة** (يُصدر
    // الطلب) و**أمين الخزينة** (يصرف) — وهما خارج isStockActor فلا يحرّكان
    // مخزونًا. البقيّة (المشتريات·المالي·المدير) مشمولون أصلًا، وذكرهم هنا
    // يوضّح النطاق. مستندات هذه السلسلة لا تمسّ الأرصدة فلا أثر مخزنيّ لها.
    // فاعلو البيع من المركبة. **لم يُضافوا إلى `isStockActor`** عمدًا: ذاك
    // يفتح الجرد وسجلّ المسح وطابور الأصناف المجهولة، والمندوب لا شأن له بها.
    // نطاقه أضيق: مستندات مركبته وأثرها على الأرصدة وحدها. ولذلك يُذكر صراحةً
    // حيث يلزم — والصراحة هنا أرخص من صلاحيةٍ زائدة لا يُنتبَه لها.
    function isVanSalesWriter() {
      return isBootstrapAdmin() ||
             (signedIn() && hasProfile() && isActive() && myRole() in [
               'admin', 'warehouse_manager', 'sales_rep', 'sales_supervisor'
             ]);
    }

    function isProcurementActor() {
      return isBootstrapAdmin() ||
             (signedIn() && hasProfile() && isActive() && myRole() in [
               'admin', 'warehouse_manager', 'department_user',
               'purchase_officer', 'finance_manager', 'treasury'
             ]);
    }

    // من يحقّ له حجز رقمٍ رسميّ من عدّاد `counters`: كل من يُنشئ مستندًا
    // مرقّمًا فعلًا — الفاعل المخزني (مستندات·عُهد) أو كاتب الأسطول (رحلات·
    // أوامر شغل·فحوصات) أو فاعل المشتريات الداخلية (طلب·صرف) أو المدير. المشاهد
    // وحده خارجها فلا يحرق أرقامًا (كان أي مصادَق يحرقها — خرق أُغلق بالمحور ٤).
    function canReserveNumber() {
      return isStockActor() || isFleetWriter() || isProcurementActor() || isVanSalesWriter();
    }

    // ── المستخدمون والأدوار ──────────────────────────────────────
    // القراءة: ملفّ المستخدم نفسه (الواجهة تحتاج دوره) أو مدير (شاشة الإدارة
    // تسرد الكلّ). كان أي مصادَق يقرأ دليل المستخدمين كاملًا — دور وبريد كلّ
    // زميل؛ حُصر بالمحور ٤. الكتابة للمدير العام فقط — وإلا رقّى كلٌّ نفسه.
    match /users/{uid} {
      // مشرف المبيعات يقرأ الدليل أيضًا: لا يضع خطّة زياراتٍ لمندوبٍ لا يعرف
      // معرّفه. توسعةٌ مقصودة ومحدودة بالقراءة — الكتابة تبقى للمدير العام وحده.
      allow read: if isManager() || myRole() == 'sales_supervisor'
                  || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── العمليات المخزنية ────────────────────────────────────────
    match /operations/{opId} {
      allow read: if signedIn();
      // إنشاء جلسة جرد/مسح: فاعل مخزنيّ فقط — لا أي مصادَق (كان viewer
      // يُنشئ عمليات؛ حُصر بالمحور ٤). شاشة «الجرد الذكي» لا يراها إلا
      // الأدوار المخزنية أصلًا، فلا تقييد جديد على من يعمل فعلًا.
      allow create: if isStockActor();
      // الإقفال والملخّص للمديرين فقط؛ ولا حذف للعمليات إطلاقاً.
      allow update: if isManager();
      allow delete: if false;

      // سجلّ المسح: إضافة فقط — لا تعديل ولا حذف (سجلّ تدقيق دائم).
      // وشرط ثالث (تدقيق كوديكس 2026-08-07): **العملية الأم ما زالت مفتوحة** —
      // كان بالإمكان إلحاق مسح بعملية مُقفلة، فيتغيّر جردٌ اعتُمد ملخّصه.
      // كلفة get() قراءة واحدة لكل مسح — ثمن مقبول لتجميد التاريخ.
      match /scans/{scanId} {
        allow read: if signedIn();
        allow create: if isStockActor()
                      && request.resource.data.byUid == request.auth.uid
                      && get(/databases/$(database)/documents/operations/$(opId)).data.status == 'open';
        allow update, delete: if false;
      }
    }

    // ── المستندات (محرّك النماذج — ROADMAP §11) ──────────────────
    //
    // ⚠️ ازدواج مقصود: أدوار الاعتماد أدناه تكرّر ما في مخطّطات
    //    `src/services/documents/schemas/*.js`. القواعد لا تستورد JS، فلا
    //    مفرّ. **عدّلهما معًا** — تمامًا كبريد تمهيد الأدمن أعلاه.
    //    الوارد F2:  PR → PO → GRN → QC → PUTAWAY
    //    الصادر F3:  PICK → PACK → DN → GP
    //
    // 🏅 حارس البوابة: اعتماد GP لضابط البوابة والمدير — **لا لأمين
    //    المخزن** الذي جهّز الشحنة. الفصل بين مَن يُعِدّ ومَن يُجيز هو
    //    الحارس نفسه، وهذه الطبقة على الخادم لا تُتجاوَز بتعديل الواجهة.
    //    المرتجعات F4: RET → CN · التسوية F4: CC → ADJ · والتالف DMG مفرد.
    //
    // 🔒 حارس التسوية: اعتماد ADJ للمدير المالي والمدير — لا لمراقب
    //    المخزون الذي أدخلها. و⚖️ الإشعار الدائن CN للمالية كذلك. الفصل
    //    بين مَن يُدخل ومَن يعتمد هو الحارس، وهذه الطبقة على الخادم.
    function approveRoles(docType) {
      return docType == 'GRN'     ? ['qc_inspector', 'warehouse_manager']
           : docType == 'PR'      ? ['warehouse_manager', 'purchase_officer']
           : docType == 'PO'      ? ['warehouse_manager', 'finance_manager']
           : docType == 'QC'      ? ['qc_inspector', 'warehouse_manager']
           : docType == 'PUTAWAY' ? ['warehouse_manager', 'inventory_auditor']
           : docType == 'SO'      ? ['warehouse_manager']
           : docType == 'PICK'    ? ['warehouse_manager']
           : docType == 'PACK'    ? ['qc_inspector', 'warehouse_manager']
           : docType == 'DN'      ? ['warehouse_manager']
           : docType == 'POD'     ? ['warehouse_manager', 'fleet']
           : docType == 'SRN'     ? ['qc_inspector', 'warehouse_manager']
           : docType == 'GP'      ? ['gate_officer', 'warehouse_manager']
           : docType == 'INV'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'TR'      ? ['warehouse_manager']
           : docType == 'TRN'     ? ['warehouse_manager']
           : docType == 'TRC'     ? ['warehouse_manager']
           : docType == 'RET'     ? ['qc_inspector', 'warehouse_manager']
           : docType == 'DMG'     ? ['qc_inspector', 'warehouse_manager']
           : docType == 'CC'      ? ['inventory_auditor', 'warehouse_manager']
           : docType == 'ADJ'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'CN'      ? ['finance_manager', 'warehouse_manager']
           : docType == 'CTR'     ? ['warehouse_manager', 'labor_supervisor']
           // البيع من المركبة: المندوب يعتمد فاتورته وحدها — لأنّ منعها يوقف
           // البيع في وجه تاجرٍ واقف، فيُسجَّل خارج النظام. أمّا المرتجع فيخرج
           // اعتماده من يده (هو الباب الذي يُخفى منه العجز)، وكذلك التسوية
           // فلا يعتمد أحدٌ فرق نفسه. والرقابة لاحقةٌ مركّبة لا سابقة.
           : docType == 'VLD'     ? ['warehouse_manager', 'sales_supervisor']
           : docType == 'VSI'     ? ['sales_rep', 'sales_supervisor']
           : docType == 'CRN'     ? ['sales_supervisor', 'warehouse_manager', 'return_manager']
           : docType == 'VRT'     ? ['warehouse_manager', 'sales_supervisor']
           : docType == 'VSR'     ? ['sales_supervisor', 'warehouse_manager']
           // البضاعة المحميّة: الإيداع **التزامٌ ائتمانيّ لا بيع** — المندوب
           // يمنح بضاعةً بلا مقابلٍ فوريّ ويعِد بحقّ إرجاعٍ يُكلّف لاحقًا، فيخرج
           // اعتماده من يده. والاسترداد هو الباب الذي يُخفى منه العجز. أمّا
           // تحقّق البيع فإثباتُ واقعةٍ وقعت — كالفاتورة، لا يوقفه انتظار.
           : docType == 'VCD'     ? ['sales_supervisor', 'warehouse_manager']
           : docType == 'VCS'     ? ['sales_rep', 'sales_supervisor']
           : docType == 'VCR'     ? ['sales_supervisor', 'warehouse_manager', 'return_manager']
           // المشتريات الداخلية: المدير المالي يعتمد الطلب والترسية والأمر
           // والصرف، والمستفيد (مستخدم الإدارة) يُقرّ استلام التسليم.
           // سند القبض (م٤-أ): يقبضه أمين الخزينة أو المندوب، ويعتمده المالي.
           // **من قبض المال لا يعتمد قبضه** — وإلّا فالسند إقرارٌ ذاتيّ لا مستند.
           : docType == 'RCP'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'SPV'     ? ['finance_manager', 'warehouse_manager']
           // التحصيل الميدانيّ (م٥-أ): يقبضه المندوب ويعتمده المشرف — من قبض
           // المال لا يعتمد قبضه. والإصدار له لأنّ منعه يوقف التحصيل في الشارع.
           : docType == 'RCV'     ? ['sales_supervisor', 'finance_manager', 'warehouse_manager']
           : docType == 'IPR'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'RFQ'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'IPO'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'PV'      ? ['finance_manager', 'warehouse_manager']
           : docType == 'DLV'     ? ['department_user', 'warehouse_manager']
           : [];
    }
    function completeRoles(docType) {
      return docType == 'GRN'     ? ['storekeeper', 'warehouse_manager']
           : docType == 'PR'      ? ['purchase_officer', 'warehouse_manager']
           : docType == 'PO'      ? ['purchase_officer', 'warehouse_manager']
           : docType == 'QC'      ? ['qc_inspector', 'warehouse_manager']
           : docType == 'PUTAWAY' ? ['storekeeper', 'warehouse_manager']
           : docType == 'SO'      ? ['storekeeper', 'warehouse_manager']
           : docType == 'PICK'    ? ['storekeeper', 'warehouse_manager']
           : docType == 'PACK'    ? ['storekeeper', 'warehouse_manager']
           : docType == 'DN'      ? ['storekeeper', 'warehouse_manager']
           : docType == 'POD'     ? ['fleet', 'warehouse_manager']
           : docType == 'SRN'     ? ['storekeeper', 'warehouse_manager']
           : docType == 'GP'      ? ['gate_officer', 'warehouse_manager']
           : docType == 'INV'     ? ['finance_manager', 'warehouse_manager']
           : docType == 'TR'      ? ['storekeeper', 'warehouse_manager']
           : docType == 'TRN'     ? ['storekeeper', 'warehouse_manager']
           : docType == 'TRC'     ? ['storekeeper', 'warehouse_manager']
           : docType == 'RET'     ? ['return_manager', 'warehouse_manager']
           : docType == 'DMG'     ? ['return_manager', 'warehouse_manager']
           : docType == 'CC'      ? ['inventory_auditor', 'warehouse_manager']
           : docType == 'ADJ'     ? ['warehouse_manager', 'finance_manager']
           : docType == 'CN'      ? ['finance_manager', 'warehouse_manager']
           : docType == 'CTR'     ? ['labor_supervisor', 'warehouse_manager']
           // البيع من المركبة: إرجاع المتبقّي يُنجزه **المستودع** لا المندوب —
           // من يُقرّ الاستلام غير من يُقرّ التسليم، فالفرق بينهما يظهر رقمًا
           // في التسوية بدل أن يُبتلع في توقيعٍ واحد.
           : docType == 'VLD'     ? ['storekeeper', 'warehouse_manager']
           : docType == 'VSI'     ? ['sales_rep', 'sales_supervisor']
           : docType == 'CRN'     ? ['sales_rep', 'sales_supervisor']
           : docType == 'VRT'     ? ['storekeeper', 'warehouse_manager']
           : docType == 'VSR'     ? ['sales_supervisor', 'warehouse_manager']
           // البضاعة المحميّة: الثلاثة يُنجزها الميدان — فالبضاعة تتحرّك بين
           // المركبة ورفّ التاجر، ولا يمرّ شيءٌ منها بالمستودع حتى `VRT`.
           : docType == 'VCD'     ? ['sales_rep', 'sales_supervisor']
           : docType == 'VCS'     ? ['sales_rep', 'sales_supervisor']
           : docType == 'VCR'     ? ['sales_rep', 'sales_supervisor']
           // المشتريات الداخلية: المشتريات تُنهي الطلب والكشف والأمر والتسليم،
           // وأمين الخزينة يُنهي سند الصرف (تنفيذ الصرف الفعليّ).
           : docType == 'IPR'     ? ['purchase_officer', 'warehouse_manager']
           : docType == 'RFQ'     ? ['purchase_officer', 'warehouse_manager']
           : docType == 'IPO'     ? ['purchase_officer', 'warehouse_manager']
           : docType == 'RCP'     ? ['treasury', 'finance_manager', 'warehouse_manager']
           : docType == 'SPV'     ? ['treasury', 'finance_manager', 'warehouse_manager']
           : docType == 'RCV'     ? ['sales_supervisor', 'finance_manager', 'warehouse_manager']
           : docType == 'PV'      ? ['treasury', 'warehouse_manager']
           : docType == 'DLV'     ? ['purchase_officer', 'warehouse_manager']
           : [];
    }

    match /documents/{docId} {
      function isCreator() {
        return signedIn() && resource.data.createdByUid == request.auth.uid;
      }
      // الحقول التي لا يجوز أن تتغيّر بعد الإنشاء — أي منها = تزوير هويّة المستند.
      function immutableKept() {
        return request.resource.data.type == resource.data.type
               && request.resource.data.createdByUid == resource.data.createdByUid
               && request.resource.data.createdAt == resource.data.createdAt;
      }
      // الرقم الرسمي يُكتب مرّة واحدة: من null إلى قيمة، ثم لا يتغيّر أبدًا.
      function numberWriteOnce() {
        return resource.data.number == null
               || request.resource.data.number == resource.data.number;
      }
      function movingTo(states) {
        return request.resource.data.state in states;
      }
      // البنود والرأس لا يتغيّران أثناء الاعتماد أو الإنجاز: المعتمِد يبتّ فيما
      // أُرسِل، لا يُعيد تسعيره. بدون هذا كان صاحب دور اعتمادٍ (مثل المالي على
      // أمر الشراء) يبدّل `unitPrice` في **نفس** كتابة الاعتماد — تلاعبٌ ماليّ
      // بلا أثرٍ في سجلّ التدقيق. تحرير البنود حكرٌ على مسودّة صاحبها وحده.
      function contentUnchanged() {
        return request.resource.data.lines == resource.data.lines
               && request.resource.data.header == resource.data.header;
      }

      allow read: if signedIn();

      // يولد مسودّةً باسم صاحبه وبلا رقم — لا أحد يُنشئ مستندًا معتمَدًا ابتداءً.
      // فاعل مخزنيّ أو فاعل مشتريات داخلية فقط (كان أي مصادَق يُنشئ مسودّات —
      // بابُ إغراق أُغلق بالمحور ٤؛ ومستخدم الإدارة/الخزينة أُضيفا لدورة المشتريات).
      allow create: if (isStockActor() || isProcurementActor() || isLaborWriter() || isVanSalesWriter())
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.state == 'draft'
                    && request.resource.data.number == null;

      // ثلاث بوّابات لا رابع لها:
      //  (أ) صاحب المستند يحرّر مسودّته أو يُرسلها.
      //  (ب) صاحب دور الاعتماد يبتّ في المُرسَل: يعتمد أو يرفض.
      //  (ج) صاحب دور الإنهاء يُنهي **المعتمَد** فقط.
      //
      // 🥇 هنا يصير حارس الجودة حقيقيًّا: لا طريق من 'submitted' إلى 'done'.
      //    من أراد إنهاء استلام فعليه المرور باعتماد مفتّش الجودة — ولو زوّر
      //    الواجهة كلّها، فهذه القاعدة على الخادم لا تُتجاوَز.
      // ختمُ أثرٍ جانبيّ لا يغيّر الحالة: القيد المخزني يضع `posted` على مستندٍ
      // منجَز، وحجز أمر البيع يضع `soAllocation` على معتمَد، وتحرير الحجز عند السحب
      // يضع `soReleasedByKey`/`soReleaseLog` على معتمَد (BZ-SCN-004). كلّها يكتبها
      // فاعلٌ مخزنيّ، وكلّها **لا تمسّ الحالة ولا الحقول الثابتة ولا الرقم** — فنسمح
      // بها بشرط ألّا يتغيّر إلا من هذه الحقول المعدودة. بدون هذا كان قيد أمين
      // المخزن (وهو الغالب) يرتدّ من الخادم.
      function isSideEffectStamp() {
        return isStockActor()
               // الختم لا يقع إلا على مستندٍ قابلٍ للقيد: soAllocation على «معتمَد»
               // و posted على «منجَز». يمنع ختم مسودّة/مُرسَل/مرفوض عشوائيًّا
               // (كان أيّ فاعلٍ مخزنيّ يختم أيّ مستندٍ بأيّ حالة).
               && resource.data.state in ['approved', 'done']
               && request.resource.data.state == resource.data.state
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'posted', 'postedAt', 'postedByUid', 'postedMoves',
                    'soAllocation', 'soShortfall', 'soReserved', 'soReleased',
                    'soReleasedByKey', 'soReleaseLog',
                    'updatedAt'
                  ]);
      }

      // ═══ نزاهة التاريخ (م٢-ب · يسدّ ف‑٨) ═══
      // الحكم هنا لا في المتصفّح: `request.time` ساعةُ الخادم، فمن قدّم ساعة
      // حاسوبه ليؤرّخ في المستقبل يجتاز فحص الواجهة ويرتدّ من هنا.
      //
      // نحرس ما يعرفه الخادم بلا خريطة ٣٥ نوعًا في القواعد: **وسم التأريخ
      // للماضي**. الواجهة تحسب أيّ حقلٍ ختمُ واقعة (من `timeFields.js`) وتكتب
      // الوسم؛ والخادم يفرض ألّا يُكتب وسمٌ كاذبٌ ولا يُمحى وسمٌ صادق.
      //
      // ثلاثة شروط لا رابع لها:
      //  (أ) الوسم لا يُمحى ولا يُقلَب إلى `false` — أثرُه دائم.
      //  (ب) الوسم الجديد يحمل ختم الخادم لا وقتًا يختاره المتصفّح.
      //  (ج) الوسم الجديد يُنسب إلى كاتبه لا إلى غيره.
      function datingTagKept() {
        return !('dating' in resource.data)
               || ('dating' in request.resource.data
                   && request.resource.data.dating.backdated == true);
      }
      function datingTagHonest() {
        return !('dating' in request.resource.data)
               || (('dating' in resource.data
                    && request.resource.data.dating == resource.data.dating)
                   || (request.resource.data.dating.at == request.time
                       && request.resource.data.dating.byUid == request.auth.uid));
      }

      allow update: if signedIn() && immutableKept() && numberWriteOnce()
                    && datingTagKept() && datingTagHonest() && (
                      isAdmin()
                      || isSideEffectStamp()
                      || (isCreator()
                          && resource.data.state in ['draft', 'rejected']
                          && movingTo(['draft', 'submitted']))
                      || (hasProfile()
                          && resource.data.state == 'submitted'
                          && myRole() in approveRoles(resource.data.type)
                          && movingTo(['approved', 'rejected'])
                          && contentUnchanged())
                      || (hasProfile()
                          && resource.data.state == 'approved'
                          && myRole() in completeRoles(resource.data.type)
                          && movingTo(['done', 'closed', 'canceled'])
                          && contentUnchanged())
                      // ── الحالتان الجديدتان (SAP-4 · قرار المالك 2026-08-13) ──
                      // «مغلق» يوقف تنفيذ المتبقّي، و«ملغى» يُبطل عمليّةً لم
                      // تُرحَّل بعد. والفرق بينهما محفوظٌ هنا لا في الواجهة وحدها.
                      //
                      // ⚠️ **لا إلغاء بعد الإنجاز.** المنجَز رحّل حركاتٍ في دفترٍ
                      // ملحق-فقط، فقلبُ حالته يترك أثرًا بلا مستندٍ يبرّره.
                      // التصحيح بمستندٍ عكسيّ لا بحالة — ولذلك `done` لا تُتيح
                      // إلا `closed`.
                      || (hasProfile()
                          && resource.data.state == 'done'
                          && myRole() in completeRoles(resource.data.type)
                          && movingTo(['closed'])
                          && contentUnchanged())
                      // صاحب المستند يُلغي ما لم يخرج من يده بعد. وما دخل
                      // المراجعة لا يُسحب من تحت المراجع — فلا `submitted` هنا.
                      || (isCreator()
                          && resource.data.state in ['draft', 'rejected']
                          && movingTo(['canceled'])
                          && contentUnchanged())
                    );

      // لا حذف لمستند أبدًا. المستند الخاطئ يُرفض ويبقى أثره.
      allow delete: if false;

      // سجلّ التدقيق: إضافة فقط باسم فاعلها — لا تعديل ولا حذف (نمط scans).
      // الكاتب فاعلُ مستنداتٍ (مخزنيّ أو مشتريات داخلية) لا أيّ مصادَق — يمنع
      // تلويث سجلّ تدقيق أيّ مستندٍ من غير المعنيّين به.
      match /audit/{entryId} {
        allow read: if signedIn();
        allow create: if (isStockActor() || isProcurementActor() || isLaborWriter() || isVanSalesWriter())
                      && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }

      // المرفقات: الأدلّة الماديّة (فاتورة مورّد · توقيع مندوب · صورة بضاعة).
      // ملحق-فقط باسم رافعها — لا تعديل ولا حذف (الدليل الذي يُمحى ليس دليلًا).
      // أوسع من سجلّ التدقيق: أيّ مصادَقٍ يرى المستند يُرفق دليلًا عليه — لأن
      // مندوب المورّد أو سائق التسليم قد يوقّع، وليس فاعلًا مخزنيًّا بالضرورة.
      // الحجم محكوم في الواجهة (ضغط < 700KB)، وسقف مستند Firestore حارسٌ أخير.
      match /attachments/{attId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }

      // الرقابة/المطابقة: قيود «أداة المقارنة» — طابق المستند الصادر بالنسخة
      // الموقّعة. ملحق-فقط باسم من طابق — لا تعديل ولا حذف (إعادة المطابقة قيدٌ
      // جديد، والأحدث يحكم). بخلاف المرفقات (يُرفقها أيّ مصادَق لأن مندوب المورّد
      // قد يوقّع)، **المطابقة حكمُ رقابةٍ** فتُحصر بالفاعل المخزنيّ/المشترياتيّ
      // النشط (يُدخل isActive تلقائيًّا) — فلا يزوّر مشاهدٌ أو موقوفٌ «مطابق» على
      // فاتورة. والاختلاف يُلزِم بسببٍ مكتوب **على الخادم** لا في الواجهة وحدها.
      match /control/{recId} {
        allow read: if signedIn();
        allow create: if (isStockActor() || isProcurementActor())
                      && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.result in ['matched', 'mismatch']
                      && (request.resource.data.result == 'matched'
                          || (request.resource.data.note is string
                              && request.resource.data.note.size() > 0));
        allow update, delete: if false;
      }
    }

    // ── قفل تخصيص التنفيذ الجزئي ──────────────────────────────────
    // وثيقة تشغيلية قابلة للتحديث، منفصلة تمامًا عن المستند المرحّل: تمنع
    // معاملتين متزامنتين من حجز الكمية المفتوحة نفسها، ولا تعيد كتابة الأصل.
    match /document_flow_allocations/{allocationId} {
      function validFlowAllocation() {
        return request.resource.data.keys().hasAll([
                 'sourceDocumentId', 'sourceDocumentType', 'targetDocumentType',
                 'allocatedByLine', 'revision', 'updatedByUid', 'updatedAt'
               ])
               && request.resource.data.keys().hasOnly([
                 'sourceDocumentId', 'sourceDocumentType', 'targetDocumentType',
                 'allocatedByLine', 'revision', 'updatedByUid', 'updatedAt'
               ])
               && request.resource.data.sourceDocumentId is string
               && request.resource.data.sourceDocumentId.size() > 0
               && request.resource.data.sourceDocumentType is string
               && request.resource.data.targetDocumentType is string
               && request.resource.data.allocatedByLine is map
               && request.resource.data.revision is int
               && request.resource.data.revision > 0
               && request.resource.data.updatedByUid == request.auth.uid
               && request.resource.data.updatedAt == request.time
               && exists(/databases/$(database)/documents/documents/$(request.resource.data.sourceDocumentId))
               && get(/databases/$(database)/documents/documents/$(request.resource.data.sourceDocumentId)).data.type
                  == request.resource.data.sourceDocumentType;
      }
      function identityKept() {
        return request.resource.data.sourceDocumentId == resource.data.sourceDocumentId
               && request.resource.data.sourceDocumentType == resource.data.sourceDocumentType
               && request.resource.data.targetDocumentType == resource.data.targetDocumentType;
      }

      allow read: if signedIn();
      allow create: if (isStockActor() || isProcurementActor() || isLaborWriter() || isVanSalesWriter())
                    && validFlowAllocation();
      allow update: if (isStockActor() || isProcurementActor() || isLaborWriter() || isVanSalesWriter())
                    && validFlowAllocation()
                    && identityKept()
                    && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // ── علاقات المستندات والسطر بالسطر ───────────────────────────
    // مجموعة مستقلة ملحقة-فقط بدل المفتاح الأحادي `links.<type>` الذي لا
    // يستطيع تمثيل طفلين من النوع نفسه أو أكثر من مصدر لسطر واحد. إعادة
    // المحاولة المتطابقة تحمل المعرّف الحتمي نفسه وتصبح noop في الخدمة؛ أما
    // الخادم فلا يسمح بتعديل العلاقة بعد نشرها أو حذفها تحت أي دور.
    match /document_links/{linkId} {
      function validEndpoint(endpoint) {
        return endpoint is map
               && endpoint.keys().hasAll([
                    'documentId', 'documentType', 'documentNumber', 'lineId', 'lineNumber'
                  ])
               && endpoint.keys().hasOnly([
                    'documentId', 'documentType', 'documentNumber', 'lineId', 'lineNumber'
                  ])
               && endpoint.documentId is string
               && endpoint.documentId.size() > 0
               && endpoint.documentType is string
               && endpoint.documentType.size() > 0
               && (endpoint.documentNumber == null || endpoint.documentNumber is string)
               && (endpoint.lineId == null || endpoint.lineId is string)
               && (endpoint.lineNumber == null
                   || (endpoint.lineNumber is int && endpoint.lineNumber > 0));
      }

      function endpointDocumentMatches(endpoint) {
        return existsAfter(/databases/$(database)/documents/documents/$(endpoint.documentId))
               && getAfter(/databases/$(database)/documents/documents/$(endpoint.documentId)).data.type
                  == endpoint.documentType;
      }

      function validRelation() {
        return request.resource.data.keys().hasAll([
                 'id', 'version', 'source', 'target', 'linkType',
                 'linkedQuantity', 'linkedValue', 'uom', 'operationId',
                 'correlationId', 'byUid', 'byName', 'byRole', 'createdAt'
               ])
               && request.resource.data.keys().hasOnly([
                 'id', 'version', 'source', 'target', 'linkType',
                 'linkedQuantity', 'linkedValue', 'uom', 'operationId',
                 'correlationId', 'byUid', 'byName', 'byRole', 'createdAt'
               ])
               && request.resource.data.id == linkId
               && request.resource.data.version == 1
               && validEndpoint(request.resource.data.source)
               && validEndpoint(request.resource.data.target)
               && request.resource.data.linkType in [
                    'BASE', 'TARGET', 'REFERENCE', 'RETURN', 'REVERSAL', 'CORRECTION'
                  ]
               && !(request.resource.data.source.documentId == request.resource.data.target.documentId
                    && request.resource.data.source.documentType == request.resource.data.target.documentType)
               && (request.resource.data.linkedQuantity == null
                   || (request.resource.data.linkedQuantity is number
                       && request.resource.data.linkedQuantity > 0
                       && request.resource.data.source.lineId is string
                       && request.resource.data.source.lineId.size() > 0
                       && request.resource.data.target.lineId is string
                       && request.resource.data.target.lineId.size() > 0))
               && (request.resource.data.linkedValue == null
                   || (request.resource.data.linkedValue is number
                       && request.resource.data.linkedValue > 0))
               && (request.resource.data.uom == null || request.resource.data.uom is string)
               && (request.resource.data.operationId == null || request.resource.data.operationId is string)
               && (request.resource.data.correlationId == null || request.resource.data.correlationId is string)
               && request.resource.data.byUid == request.auth.uid
               && request.resource.data.byName is string
               && request.resource.data.byRole is string
               && request.resource.data.createdAt == request.time
               && endpointDocumentMatches(request.resource.data.source)
               && endpointDocumentMatches(request.resource.data.target);
      }

      allow read: if signedIn();
      allow create: if (isStockActor() || isProcurementActor() || isLaborWriter() || isVanSalesWriter())
                    && validRelation();
      allow update, delete: if false;
    }

    // ── عدّادات الترقيم التسلسلي ──────────────────────────────────
    // العدّاد يزيد **واحدًا فقط في كل مرّة، وإلى الأمام فقط**: لا تصفير ولا
    // قفز. بهذا يستحيل إنتاج رقمين متطابقين أو إعادة استخدام رقم محروق.
    match /counters/{counterId} {
      allow read: if signedIn();
      // حاجز الأرقام: من يُنشئ مستندًا مرقّمًا فقط (كان أي مصادَق يقدر أن
      // يحرق أرقامًا رسمية — أخطر خرق كشفه المسح؛ أُغلق بالمحور ٤).
      allow create: if canReserveNumber() && request.resource.data.seq == 1;
      allow update: if canReserveNumber() && request.resource.data.seq == resource.data.seq + 1;
      allow delete: if false;
    }

    // ── التوظيف (بيانات حسّاسة: أسماء · هواتف · سير · رواتب) ─────
    // قراءةً وكتابةً للمديرَين فقط (قرار المالك 2026-07-16) — حتى القراءة،
    // بخلاف بقية المجموعات، لأن بيانات المرشحين ليست شأن كل مصادق.
    match /candidates/{candidateId} {
      allow read, create, update: if isManager();
      allow delete: if false; // المرشح المرفوض يبقى أثره — لا محو للتاريخ.

      match /files/{fileId} {
        allow read, create, update: if isManager();
        allow delete: if false;
      }
      // سجلّ التدقيق: إضافة فقط باسم فاعلها — نمط scans نفسه.
      match /audit/{entryId} {
        allow read: if isManager();
        allow create: if isManager()
                      && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── بيانات المخزون ───────────────────────────────────────────
    match /Items_Master/{docId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // ── الأصناف المعلّقة (I-د) ────────────────────────────────────
    // الباركود المجهول يُسجَّل هنا بدل أن يضيع مع جلسة الماسح.
    // الكتابة الأولى لأي مصادق (الماسح موظّف ميداني لا مدير)، لكن **البتّ
    // للمديرَين وحدهما**: الاعتماد يكتب في Items_Master (وهي isManager أصلًا)
    // فلا يستطيع الماسح ترقية صنفٍ لنفسه. ولا حذف — السجلّ المرفوض يبقى
    // أثرًا يمنع إعادة السؤال عن الباركود نفسه كل جلسة.
    match /Items_Pending/{barcode} {
      allow read: if signedIn();
      // إنشاء: فاعل مخزنيّ بحالة «معلّق» فقط (الماسح موظّف مخزني، والبتّ
      // للمديرَين). كان أي مصادَق يُنشئ — حُصر بالمحور ٤.
      allow create: if isStockActor() && request.resource.data.state == 'pending';
      allow update: if isManager()
                    || (isStockActor()
                        // تكرار مشاهدة من الماسح (فاعل مخزنيّ): الحالة لا تتغيّر
                        // والبتّ لا يُنتحل. كان أيّ مصادَقٍ يُحدّث — حُصر بالفاعل المخزنيّ.
                        && request.resource.data.state == resource.data.state
                        && request.resource.data.state == 'pending');
      allow delete: if false;
    }

    // ── كتالوج الطرف‑الصنف (SAP-2 · ف‑٦ · SR-48 ‹3077›) ─────────
    // علاقة الطرف بالصنف في جدولٍ مستقلّ: كود المورّد/العميل للصنف.
    // المعرّف حتميّ (نوع__رمز__صنف) فالإعادة تحديثٌ لا تكرار.
    // الإلزاميّ ثلاثة فقط + كود الطرف (§10.2 ‹251›) — والباقي اختياريّ.
    // القراءة لأيّ مصادَق (البحث بكود الطرف في بنود المستندات)، والكتابة
    // للمديرَين، ولا حذف — سجلُّ علاقةٍ استُعمل في مستندٍ يبقى أثره.
    // ⚠️ تُنشر بقرار المالك (قرار‑٥) — §3-١٠ ‹49› يمنع Claude من النشر.
    match /item_partner_catalog/{entryId} {
      allow read: if signedIn();
      allow create, update: if isManager()
                    && request.resource.data.partnerType in ['supplier', 'customer']
                    && request.resource.data.partnerCode is string
                    && request.resource.data.partnerCode != ''
                    && request.resource.data.sku is string
                    && request.resource.data.sku != ''
                    && request.resource.data.partnerItemCode is string
                    && request.resource.data.partnerItemCode != '';
      allow delete: if false;
    }

    // ── شركاء الأعمال: الموردون والعملاء (§15.2/15.3) ────────────
    // القراءة لأي مصادَق (أوامر الشراء والبيع والتقارير تحتاج الشريك).
    // الكتابة للمديرَين. **لا حذف** — أرشفة لا محو (archived=true)، فشريكٌ
    // استُعمل في مستندٍ يبقى أثره ولا يُمحى (نفس مبدأ عدم حذف المستندات).
    match /Suppliers_Master/{docId} {
      allow read: if signedIn();
      allow create, update: if isManager();
      allow delete: if false;
    }
    // ماستر العملاء. المديران يكتبونه كاملًا.
    //
    // 🔒 استثناءٌ ضيّق للميدان: المندوب ومشرفه يلتقطان **موقع المتجر وبياناته
    //    الميدانيّة فقط** (`geo`/`field`) — لا الأسعار ولا شروط الدفع ولا الاسم
    //    ولا الأرشفة. يُنفَّذ بـ`affectedKeys().hasOnly` فلا يكفي أن يُرسل
    //    المندوب حقلًا مسموحًا وحقلًا ممنوعًا في الطلب نفسه: يُرفض الطلب كلّه.
    //    (نفس درس `isSideEffectStamp` — تحديد الحقول لا تحديد الدور وحده.)
    match /Customers_Master/{docId} {
      allow read: if signedIn();
      allow create: if isManager();
      allow update: if isManager()
                    || (isVanSalesWriter()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['geo', 'field', 'byUid', 'byName', 'byRole', 'updatedAt']));
      allow delete: if false;
    }

    match /warehouses/{docId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // ── الأرصدة (كمية لكل صنف×مخزن×تشغيلة) ───────────────────────
    // القراءة لأي مصادَق (الجرد والمستندات تحتاج معرفة الرصيد). الكتابة:
    //   · المديرَان — للاستيراد الافتتاحي وتصحيح استثنائي.
    //   · الفاعل المخزني — لأن قيد المستند يزيد/ينقص الرصيد ذرّيًّا، ومن
    //     يُنجز قائمة السحب قد يكون أمين مخزن لا مديرًا. الحقيقة الملحقة تبقى
    //     في `stock_moves` غير القابل للتعديل؛ والرصيد هنا ذاكرةٌ مُسرَّعة.
    // لا حذف — الرصيد الصفري يُكتب لا يُمحى (نفاد مخزن حقيقة).
    match /balances/{balId} {
      allow read: if signedIn();
      // الفاعل المخزنيّ (القيد الذرّي) والمديران (الاستيراد). حارسٌ يمنع كتابة
      // كميّةٍ سالبة أو غير رقميّة مباشرةً. ⚠️ التحقّق الكامل (الرصيد = مجموع
      // stock_moves) يستحيل في القواعد (لا تجميع) ويحتاج مسارًا موثوقًا
      // (Cloud Function على Blaze) — موثّق في خطة التطوير، البند ٢.
      allow write: if (isStockActor() || isVanSalesWriter())
                   && (!('qty' in request.resource.data)
                       || (request.resource.data.qty is number
                           && request.resource.data.qty >= 0));
      allow delete: if false;
    }

    // ── دفتر حركات المخزون (الحقيقة الملحقة) ─────────────────────
    // كل حركة تقول: أيّ صنف، من أين إلى أين، بأيّ كمية، بأيّ مستند، ومن قيّدها.
    // إضافة فقط — لا تعديل ولا حذف أبدًا (نفس نمط `scans` و`audit`). القيد
    // بمعرّف حتميّ `docId__lineIndex`، فالكتابة الثانية تحلّ محلّ الأولى ولا
    // تُضاعف؛ ومنع التعديل يمنع العبث بتاريخٍ صار مرجعًا.
    match /stock_moves/{moveId} {
      allow read: if signedIn();
      allow create: if (isStockActor() || isVanSalesWriter())
                    && request.resource.data.postedByUid == request.auth.uid;
      // السماح بالكتابة على نفس المعرّف الحتمي (إعادة محاولة القيد الذرّي)
      // شرط بقاء الهوية والمستند والكمية كما هي — لا تحوير لحركةٍ قُيّدت.
      allow update: if (isStockActor() || isVanSalesWriter())
                    && request.resource.data.docId == resource.data.docId
                    && request.resource.data.lineIndex == resource.data.lineIndex
                    && request.resource.data.qty == resource.data.qty
                    && request.resource.data.sku == resource.data.sku
                    && request.resource.data.barcode == resource.data.barcode
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to;
      allow delete: if false;
    }

    // سجلّات الوارد والصادر: إضافة للفاعل المخزنيّ فقط — لا محو للتاريخ.
    // (كان أي مصادَق يُنشئ قيودًا — حُصر بالمحور ٤.)
    match /Inbound_Log/{docId} {
      allow read: if signedIn();
      allow create: if isStockActor();
      allow update, delete: if false; // ملحق-فقط: لا محو للتاريخ (الكود لا يُحدّثها/يحذفها).
    }

    match /Outbound_Log/{docId} {
      allow read: if signedIn();
      allow create: if isStockActor();
      allow update, delete: if false; // ملحق-فقط: لا محو للتاريخ (الكود لا يُحدّثها/يحذفها).
    }

    // ── جرد المركبات (سجلّ الأسطول الحيّ — إدارة الحركة) ─────────────────
    // القراءة لأي مصادَق (المخازن والموارد البشرية تطالعان السجلّ)، والكتابة
    // لدور «الحركة» والمديرَين. لا حذف لمركبة ولا لفحص ولا لمحضر — نمط
    // `operations` نفسه: التصحيح بقيد جديد لا بمحو التاريخ.
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if isFleetWriter();
      allow delete: if false;

      // نماذج الفحص الكاملة (تاريخ المركبة).
      match /inspections/{inspId} {
        allow read: if signedIn();
        allow create, update: if isFleetWriter();
        allow delete: if false;
      }
      // طلبات الصيانة (مفتوحة → منجزة).
      match /maintenance/{reqId} {
        allow read: if signedIn();
        allow create, update: if isFleetWriter();
        allow delete: if false;
      }
      // سجلّ تغيير الزيت.
      match /oil_changes/{entryId} {
        allow read: if signedIn();
        allow create, update: if isFleetWriter();
        allow delete: if false;
      }
      // محاضر الحوادث.
      match /accidents/{caseId} {
        allow read: if signedIn();
        allow create, update: if isFleetWriter();
        allow delete: if false;
      }
      // بروتوكول الاستلام والتسليم اليومي (سلاسل الإمداد م-٢): نموذج
      // الوردية شرط إصدار تصريح البوابة — معرّفه حتمي (تاريخ__وردية).
      match /handovers/{handId} {
        allow read: if signedIn();
        allow create, update: if isFleetWriter();
        allow delete: if false;
      }
    }

    // ── الرحلات اللوجستية (Dispatch-to-POD — سلاسل الإمداد م-٢) ─────────
    // القراءة لأي مصادَق، والكتابة للحركة والمديرَين. لا حذف لرحلة:
    // الخاطئة تُلغى قبل تصريح البوابة وتبقى أثرًا. الرقم الرسمي TRIP-…
    // يُكتب مرة واحدة (من null إلى قيمة) كنمط المستندات.
    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if isFleetWriter()
                    && request.resource.data.state == 'preparing'
                    && request.resource.data.number == null;
      allow update: if isFleetWriter()
                    && (resource.data.number == null
                        || request.resource.data.number == resource.data.number);
      allow delete: if false;

      // قيود الوقود: إضافة فقط باسم فاعلها — لا تعديل ولا حذف (نمط scans).
      match /fuel/{entryId} {
        allow read: if signedIn();
        allow create: if isFleetWriter()
                      && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
      // سجل تدقيق الانتقالات: إضافة فقط.
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if isFleetWriter()
                      && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── الصيانة: الأصول وأوامر الشغل (سلاسل الإمداد م-٣) ────────────────
    match /assets/{assetId} {
      allow read: if signedIn();
      allow create, update: if isFleetWriter();
      allow delete: if false; // الأصل المنتهي يُكهَّن (status) لا يُمحى.
    }

    match /work_orders/{woId} {
      allow read: if signedIn();
      allow create: if isFleetWriter()
                    && request.resource.data.state == 'draft'
                    && request.resource.data.number == null;
      allow update: if isFleetWriter()
                    && (resource.data.number == null
                        || request.resource.data.number == resource.data.number);
      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if isFleetWriter()
                      && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── العُهد العينية (سلاسل الإمداد ٥-١) ───────────────────────────────
    // بيانات ذات أثر مالي على الرواتب (خصومات) ⇒ الكتابة للمديرَين فقط،
    // والقراءة لأي مصادَق (الموظف يرى عهدته). لا حذف لسند أبدًا.
    match /custodies/{custodyId} {
      allow read: if signedIn();
      allow create: if isManager()
                    && request.resource.data.state == 'active';
      allow update: if isManager()
                    && request.resource.data.number == resource.data.number;
      allow delete: if false;
    }

    // ── طلبات التوظيف من الإدارات (منفصلة عن `candidates` الحسّاسة) ──────
    // أي إدارة تكتب طلبها فقط (مسمّى وظيفي + بطاقة تعريفية)، وتقرأ طلباتها
    // هي دون سواها — لا تختلط ببيانات مرشحين حقيقيين ولا تراها إدارة أخرى.
    // المدير العام ومدير المستودع يراجعان كل الطلبات. لا حذف — نمط
    // `operations` نفسه: إنشاء حرّ، تحديث للمديرَين، حذف ممنوع دائمًا.
    match /hiring_requests/{reqId} {
      allow read: if isManager()
                  || (signedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.status == 'submitted';
      allow update: if isManager();
      allow delete: if false;

      // السيرة الاختيارية: يقرؤها صاحب الطلب أو المدير، ويكتبها صاحب الطلب
      // نفسه (مطابقةً لملكيّة البطاقة الأم). لا حذف — نمط candidates/files.
      match /files/{fileId} {
        allow read: if isManager()
                    || (signedIn()
                        && get(/databases/$(database)/documents/hiring_requests/$(reqId)).data.createdByUid == request.auth.uid);
        allow create, update: if signedIn()
                    && get(/databases/$(database)/documents/hiring_requests/$(reqId)).data.createdByUid == request.auth.uid;
        allow delete: if false;
      }
    }

    // ── الهيكل التنظيمي (المصدر الواحد للحقيقة) ──────────────────
    // وثيقة تنظيمية تُعرض على سبع إدارات وتُعتمد من الإدارة العامة ⇒
    // يقرؤها كل مصادَق (الموظّف يرى موقعه)، ويكتبها المديران وحدهما.
    // اللقطات في `versions` **لا تُعدَّل ولا تُحذف أبدًا** — بلا ذلك تصير
    // مقارنة «قبل/بعد» في التقرير النهائي ادّعاءً لا دليلًا.
    match /org_structure/{docId} {
      allow read: if signedIn();
      allow create, update: if isManager();
      allow delete: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow create: if isManager();
        allow update, delete: if false;
      }
    }

    // ── الاجتماعات التحضيرية مع الإدارات السبع ───────────────────
    // محاضر رسمية مرقّمة تُرفع خلاصتها للإدارة العامة ⇒ الكتابة للمديرَين،
    // والقراءة لكل مصادَق. لا حذف: المحضر الصادر أثر تنظيمي لا يُمحى.
    // الرقم الرسمي (MOM/LTR) **لا يُغيَّر بعد حجزه** — وإلّا فقد الترقيم
    // معناه وصار وسمًا قابلًا لإعادة الكتابة.
    match /preparatory_meetings/{meetingId} {
      allow read: if signedIn();
      allow create: if isManager();
      allow update: if isManager()
                    && (!('number' in resource.data)
                        || request.resource.data.number == resource.data.number)
                    && (!('letterNumber' in resource.data)
                        || request.resource.data.letterNumber == resource.data.letterNumber);
      allow delete: if false;
    }

    // ── مصفوفة الصلاحيات (شاشة الصلاحيات والأدوار — المحور ٢-ب) ──
    // طبقة الشاشات: القراءة لكل مصادَق (يحتاجها حارس الواجهة والقائمة)،
    // والكتابة للمدير العام وحده، مع سجلّ نسخ ملحق-فقط. تذكير: هذه
    // المصفوفة تضبط فتح الشاشات؛ حماية البيانات تبقى بقواعد المجموعات أعلاه.
    match /access_control/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow create: if isAdmin();
        allow update, delete: if false; // سجلّ لا يُمحى ولا يُعدَّل
      }
    }

    // ── المهام المُسنَدة (إرسال مهمّة لمستخدم + توثيق ومتابعة) ────────────
    // نموذج «المديران يُسنِدان للجميع»: المدير يُنشئ مهمّةً ويُسنِدها لمستخدمٍ
    // فعليّ، والمُسنَد إليه ينفّذ ويردّ. القراءة للمدير أو المُنشئ أو المُسنَد
    // إليه فقط — لا يرى الموظّف مهامّ غيره. لا حذف: الإلغاء حالةٌ (canceled)
    // لا محو، والتوثيق في `events` ملحق-فقط. أسماء الحالات تُطابق taskShape.js.
    match /tasks/{taskId} {
      function amCreator() {
        return signedIn() && resource.data.createdByUid == request.auth.uid;
      }
      function amAssignee() {
        return signedIn() && resource.data.assigneeUid == request.auth.uid;
      }
      // الأصل والتاريخ ثابتان بعد الإنشاء — لا تزوير مُنشئٍ ولا لحظة إنشاء.
      function originKept() {
        return request.resource.data.createdByUid == resource.data.createdByUid
               && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isManager() || amCreator() || amAssignee();

      // الإنشاء للمدير فقط، باسمه، بحالة «مُسندة»، ولمُسنَدٍ إليه غير فارغ.
      allow create: if isManager()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.status == 'assigned'
                    && request.resource.data.assigneeUid is string
                    && request.resource.data.assigneeUid.size() > 0;

      // تحديثان لا ثالث لهما:
      //  (أ) المدير: تحكّم كامل (حالة · إعادة إسناد · إلغاء) مع ثبات الأصل.
      //  (ب) المُسنَد إليه: ينفّذ فقط — لا يمسّ إلا حقول التنفيذ المعدودة، فلا
      //      يُعيد إسناد نفسه ولا يعدّل العنوان/الأولويّة/الاستحقاق.
      allow update: if originKept() && (
                      isManager()
                      || (amAssignee()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                               'status', 'acknowledgedAt', 'startedAt', 'doneAt',
                               'checklist', 'updatedAt'
                             ]))
                    );

      allow delete: if false;

      // سجلّ التوثيق: إضافة فقط باسم فاعلها — لا تعديل ولا حذف (نمط audit/scans).
      // الكاتب مديرٌ أو طرفٌ في المهمّة (مُنشئ أو مُسنَد إليه) لا أيّ مصادَق.
      match /events/{eventId} {
        function taskDoc() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        allow read: if isManager()
                    || (signedIn() && (taskDoc().createdByUid == request.auth.uid
                                       || taskDoc().assigneeUid == request.auth.uid));
        allow create: if request.resource.data.byUid == request.auth.uid
                      && (isManager()
                          || taskDoc().createdByUid == request.auth.uid
                          || taskDoc().assigneeUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ── الأرشيف الدوريّ: التقارير ومحاضر الاجتماعات (رفعٌ حيّ) ──────────
    // المصدر الأوّل المعتمد للتقارير الدورية — يرفعه المديران في أيّ وقت.
    // القراءة لكلّ مصادَق (الوثائق مرجعٌ تنظيميّ)، والكتابة للمديرَين. لا حذف
    // (أرشفة لا محو — الأثر التنظيميّ يبقى). والرقم الإشاريّ `refNumber` **لا
    // يتغيّر بعد كتابته**: يُسمح بضبطه مرّةً وهو فارغ ثمّ يثبت (كنمط الرقم في
    // المستندات) — وإلّا فقد الترقيم معناه. حمولة الملفّ base64 داخل الوثيقة،
    // وحجمها محكومٌ في الواجهة (< 900KB) وسقف مستند Firestore حارسٌ أخير.
    match /archive_documents/{docId} {
      allow read: if signedIn();
      allow create: if isManager();
      allow update: if isManager()
                    && (request.resource.data.refNumber == resource.data.refNumber
                        || resource.data.refNumber == '');
      allow delete: if false;
    }

    // عرض المراجعة التنفيذية للمدير العام — شروح العرض ومواقف القرارات
    // وجدول المتابعة تُحرَّر من الشاشة وتُزامَن لكل الأجهزة. القراءة لكل
    // مصادَق، والكتابة للمديرَين، ولا حذف (محضر الاجتماع أثر يبقى).
    match /gm_review/{docId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }

    // تسكين الأشخاص في المناصب — سجلٌّ ملحق-فقط (لا حذف). الشاغل الحاليّ لوظيفةٍ
    // = أحدث سجلٍّ نشط. الإنشاء والإنهاء للمديرَين؛ ولا يتغيّر منصبُ السجلّ ولا
    // مرشّحه ولا تاريخ بدئه بعد الكتابة (ثبات الأثر) — يُسمح فقط بضبط active/endedAt.
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create: if isManager() && request.resource.data.active == true;
      allow update: if isManager()
                    && request.resource.data.jobId == resource.data.jobId
                    && request.resource.data.candidateId == resource.data.candidateId
                    && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if false;
    }

    // فرق عمالة الشحن/التفريغ — يديرها مشرف المناولة والمديران. لا حذف
    // (تُؤرشَف بـ active:false — الأثر يبقى).
    match /crews/{crewId} {
      allow read:          if signedIn();
      allow create, update: if isLaborWriter();
      allow delete:        if false;
    }

    // مهام المناولة — سجلٌّ زمنيٌّ ملحق-فقط (لا حذف). البدء/الإيقاف/الإنهاء
    // يختم الأوقات على الخادم (serverTimestamp). الأحداث مجموعةٌ فرعيّة ملحق-فقط.
    match /labor_tasks/{taskId} {
      allow read:          if signedIn();
      allow create, update: if isLaborWriter();
      allow delete:        if false;
      match /events/{eventId} {
        allow read:   if signedIn();
        allow create: if isLaborWriter() && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // المستهدفات — يضعها المشرف والمديران، ويقرؤها الجميع (المندوب يحتاج أن
    // يرى ما كُلِّف به). **لا حقل إنجازٍ فيها**: الإنجاز يُشتقّ من المستندات
    // المنجَزة والزيارات لحظة القراءة، فلا يستطيع أحدٌ تحسين رقمه بتعديل صفّ.
    match /targets/{targetId} {
      allow read: if signedIn();
      allow create, update: if isManager() || myRole() == 'sales_supervisor';
      allow delete: if false;
    }

    // ═══ سياسة التكامل (م٧-أ) — `integration_policy/current` ═══
    // اتّجاه كلّ نوعٍ مع النظام المرتبط. القراءة للجميع لأنّ **الجسر يسألها قبل
    // كلّ دفع**، وحجبُها يعني جسرًا يعمل بلا سياسة. والكتابة للأدمن وحده:
    // من يملك قلب اتّجاه التكامل يملك تغيير مصدر الحقيقة في الشركة كلّها.
    match /integration_policy/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ═══ المواقع التنظيميّة (م٦-أ) — `org_locations` ═══
    // القطاع والبراند والفرع ومركز التكلفة. القراءة للجميع: من يكتب مركز تكلفةٍ
    // في طلبٍ يحتاج قائمتها. والكتابة للمديرَين — الهيكل قرارٌ إداريّ لا تشغيليّ.
    // **لا حذف:** موقعٌ حُمِّلت عليه تكلفةٌ تاريخيّة يُعطَّل ولا يُمحى، وإلّا
    // تحوّلت تكلفةٌ حقيقيّة إلى «غير مربوط» في تقارير الأمس.
    match /org_locations/{code} {
      allow read: if signedIn();
      allow create, update: if isManager();
      allow delete: if false;
    }

    // ═══ دفتر الذمم (م٤-ج) — `partner_ledger` ═══
    // **ملحق فقط ومقدَّس** كـ`stock_moves`: يُكتب ولا يُعدَّل ولا يُحذف. والتصحيح
    // قيدٌ مضادّ لا محوٌ للقديم — فدفترٌ يُمحى منه سطرٌ ليس دفترًا بل مسوّدة.
    //
    // الكتابة لمن يُنجز مستندًا ذا أثرٍ ماليّ (فاعل مخزنيّ أو مندوب) أو للمالي
    // والخزينة (التصفير الموثّق). والقراءة لكلّ مصادَق: من يبيع لعميلٍ يجب أن
    // يعرف رصيده قبل أن يبيع — وهو شرط حدّ الائتمان في م٤-د.
    match /partner_ledger/{entryId} {
      allow read: if signedIn();
      allow create: if isStockActor() || isVanSalesWriter()
                    || myRole() in ['finance_manager', 'treasury'];
      allow update, delete: if false;
    }

    // ═══ حساب المندوب النقديّ (CC-302) — `rep_cash_moves` ═══
    // نظير `partner_ledger` حرفًا بحرف: التحصيل يزيد جيب المندوب والإيداع
    // في التسوية يُفرغه، والرصيد الباقي بعد الإقفال عجزٌ يُسأل عنه لا سهوٌ
    // يُنسى. ملحقٌ فقط — والتصحيح قيدٌ مضادّ لا محو.
    match /rep_cash_moves/{moveId} {
      allow read: if signedIn();
      allow create: if isStockActor() || isVanSalesWriter()
                    || myRole() in ['finance_manager', 'treasury'];
      allow update, delete: if false;
    }

    // ═══ قوائم الأسعار (م٣-ج) — `price_lists` ═══
    // القراءة للجميع: المندوب يحتاج السعر ليبيع، ومن يُمنع من سعرٍ يدويّ يجب
    // أن يرى السعر الذي كان عليه أن يبيع به.
    // والكتابة للمشرف والمديرَين — من يُقيَّد بالسعر لا يضعه.
    // **لا حذف:** القائمة تُعطَّل بـ`active:false` فيبقى أثر ما بيع بها؛ وفاتورةٌ
    // بيعت بسعر قائمةٍ محذوفة تصير رقمًا بلا مرجع.
    match /price_lists/{listId} {
      allow read: if signedIn();
      allow create, update: if isManager() || myRole() == 'sales_supervisor';
      allow delete: if false;
    }

    // ═══ سياسات التشغيل (م١-ج) — `settings/current` ═══
    // القرارات ٤–٧ من الخطة المعتمدة: الصنف الداخليّ في البيع · السعر اليدويّ ·
    // حدّ الائتمان · مدى التأريخ للماضي. **إعداداتٌ لا شيفرة** (المبدأ ٨).
    //
    // القراءة للجميع لأنّ **كلّ حارسٍ يقرؤها**: من يُمنع من البيع يجب أن يعرف
    // بأيّ قاعدةٍ مُنع، وحجبُها يعني حارسًا يعمل بلا سببٍ ظاهر للموظّف.
    //
    // والكتابة للأدمن وحده: سياسةٌ يعدّلها من تُقيّده ليست سياسة. ومدير المستودع
    // مستثنًى عمدًا — هو نفسه `overrideRole` في قرارين، فلو كتبها لوسّع صلاحيته
    // بنفسه. لا حذف: تُعدَّل ولا تُمحى، فغيابها يعيد الافتراضات صامتًا.
    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // سياسات الحماية وحقّ الإرجاع — مستندٌ واحد يقرؤه الجميع (المندوب يحتاجه
    // ليعرف ما يجوز إيداعه وما يُقبل استرداده) ويكتبه المشرف والمديران وحدهم.
    // **المندوب لا يكتبها**: سياسةٌ يعدّلها من يُحتجّ بها عليه ليست سياسة.
    match /protection_policies/{docId} {
      allow read: if signedIn();
      allow write: if isManager() || myRole() == 'sales_supervisor';
    }

    // العروض الترويجيّة — يعرّفها المشرف والمديران، ويقرؤها الجميع (المندوب
    // يحتاجها ليطبّقها محرّكُه لحظة إدخال الطلب). **المندوب لا يكتبها**: عرضٌ
    // يعرّفه من يمنحه ليس عرضًا بل بابًا للتسريب.
    //
    // 🔒 `usage` (استهلاك الميزانيّة) يكتبه المندوب أيضًا — بـincrement بعد
    //    اعتماد الفاتورة — لكن **حقولَه وحدها**، فلا يمدّد سقفًا ولا يُبدّل شرطًا.
    match /promotions/{promoId} {
      allow read: if signedIn();
      allow create: if isManager() || myRole() == 'sales_supervisor';
      allow update: if isManager() || myRole() == 'sales_supervisor'
                    || (isVanSalesWriter()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['usage', 'updatedAt']));
      allow delete: if false;
    }

    // خطط الزيارات الدائمة (PJP) — يضعها المشرف والمديران، ويقرؤها المندوب
    // ليحمّل يومه. **المندوب لا يكتبها**: خطّةٌ يعدّلها من ينفّذها ليست خطّة،
    // بل تبريرٌ لاحقٌ لما فعل. لا حذف — تُعطَّل بـactive:false فيبقى أثرها.
    match /journey_plans/{planId} {
      allow read:           if signedIn();
      allow create, update: if isManager() || myRole() == 'sales_supervisor';
      allow delete:         if false;
    }

    // الزيارات الميدانيّة — واقعةٌ بمكانٍ وزمان. المعرّف حتميّ
    // (‹يوم›__‹مندوب›__‹عميل›) فلا تُسجَّل زيارتان للمتجر نفسه في اليوم نفسه.
    //
    // 🔒 المندوب يكتب زياراته وحدها (`repUid == uid`) — وإلّا سجّل زيارةً باسم
    //    زميلٍ فاختلّت تغطيته وأداؤه. والمشرف والمديران يكتبون كلّ الزيارات
    //    لأنّهم يراجعون ويصحّحون. ولا حذف: زيارةٌ لم تقع تُوسَم `skipped`
    //    بسببٍ مكتوب — ومحوُها يجعل تقرير التغطية جميلًا وكاذبًا.
    match /visits/{visitId} {
      allow read: if signedIn();
      allow create, update: if isManager() || myRole() == 'sales_supervisor'
                            || (myRole() == 'sales_rep' && isActive()
                                && request.resource.data.repUid == request.auth.uid);
      allow delete: if false;

      // سجلّ أحداث الزيارة — ملحق-فقط، والفاعل يُوثَّق بهويّته لا باسمٍ يُكتب.
      match /events/{eventId} {
        allow read:   if signedIn();
        allow create: if signedIn() && isActive()
                      && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // جسر المزامنة مع أودو — المرآة الدائمة. الحالة الحاليّة لكلّ عنصرٍ مصدر
    // (PO_<docId> / ITEM_<sku>): يقرؤها كلّ مصادَقٍ عليه، ويكتبها المديران فقط.
    match /odoo_sync/{syncId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }

    // ── المرآة المالية (SAP-16) — أودو مصدر الحقيقة، والبوابة تقرأ منه ────────
    //
    // خمس مجموعاتٍ تُملأ **بالسحب وحده**. الاتّجاه مختومٌ في الكود
    // (`directionGuard`)، وهذه القواعد تحرس الجانب الآخر: لا حذف أبدًا —
    // السجلّ الذي يختفي من أودو يُوسم `missingInOdoo` ولا يُمحى، فالأثر يبقى.
    //
    // ولماذا يكتبها المتصفّح أصلًا؟ لأنّ خطّة Spark بلا وظائف سحابيّة، فلا سحب
    // على الخادم. ولذلك الكتابة محصورةٌ بالمديرَين، والحقيقة تبقى في أودو:
    // أيّ عبثٍ بالمرآة يصحّحه السحب التالي، ولا يُبنى عليه قرارٌ محاسبيّ.
    match /odoo_accounts/{accountId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }
    match /odoo_moves/{moveId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }
    match /odoo_move_lines/{lineId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }
    match /odoo_payments/{paymentId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }

    // حالة السحب لكلّ نطاق: آخر سحبٍ وعدده وخطؤه. تُقرأ لتُعرض «آخر سحب»،
    // فمرآةٌ لا تُعلن قِدَمها تكذب بصمت.
    match /odoo_pull_state/{scopeId} {
      allow read:           if signedIn();
      allow create, update: if isManager();
      allow delete:         if false;
    }

    // سجلّ أحداث المزامنة — ملحق-فقط (لا تعديل/حذف): يغذّي الجرس وخلاصة النشاط.
    match /odoo_sync_events/{eventId} {
      allow read:   if signedIn();
      allow create: if isManager() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── الافتراضي: امنع كل ما لم يُذكر صراحةً ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
