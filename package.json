{
  "name": "warehouse-system",
  "version": "1.0.0",
  "description": "Warehouse Management System for Brandzo (Astro + React + Tailwind + Firebase).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "where": "node scripts/where.mjs",
    "identity": "node scripts/identity.mjs",
    "identity:apply": "node scripts/identity.mjs --apply",
    "sync": "node scripts/sync-sibling.mjs",
    "arch": "node scripts/build-arch.mjs",
    "org": "node scripts/build-org.mjs",
    "prebuild": "node scripts/build-arch.mjs && node scripts/build-org.mjs && node scripts/build-usage-guide.mjs",
    "guide": "node scripts/build-usage-guide.mjs",
    "test": "node --test \"src/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.mjs\"",
    "audit": "node scripts/audit-portal.mjs",
    "plan": "npm run where && npm run plan:phase-one && npm run plan:client && npm run plan:sap && npm run plan:locations && npm run plan:exec && npm run plan:fnb && npm run plan:capture && npm run plan:lpn && npm run plan:gate && npm run plan:visits",
    "plan:phase-one": "node scripts/plan-check.mjs",
    "plan:client": "node scripts/plan-check.mjs --plan docs/plan/client-completion.json --resume docs/plan/استئناف-نسخة-العميل.md",
    "plan:sap": "node scripts/plan-check.mjs --plan docs/plan/sap-alignment.json --resume docs/plan/استئناف-المواءمة.md",
    "plan:locations": "node scripts/plan-check.mjs --plan docs/plan/warehouse-locations.json --resume docs/plan/استئناف-التخزين-الموجّه.md",
    "plan:exec": "node scripts/plan-check.mjs --plan docs/plan/warehouse-execution.json --resume docs/plan/استئناف-التنفيذ-الميداني.md",
    "plan:fnb": "node scripts/plan-check.mjs --plan docs/plan/fnb-sector.json --resume docs/plan/استئناف-قطاع-الأغذية.md",
    "plan:capture": "node scripts/plan-check.mjs --plan docs/plan/capture-layer.json --resume docs/plan/استئناف-طبقة-الالتقاط.md",
    "plan:lpn": "node scripts/plan-check.mjs --plan docs/plan/lpn-layer.json --resume docs/plan/استئناف-طبقة-الطبالي.md",
    "plan:gate": "node scripts/plan-check.mjs --plan docs/plan/gate-control.json --resume docs/plan/استئناف-بوابة-الأمن.md",
    "plan:visits": "node scripts/plan-check.mjs --plan docs/plan/portal-visits.json --resume docs/plan/استئناف-سجل-الزيارات.md",
    "timefields": "node scripts/build-time-fields-doc.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albarshi996/warehouse-system.git"
  },
  "keywords": [
    "astro",
    "react",
    "tailwindcss",
    "firebase",
    "warehouse",
    "wms",
    "erp"
  ],
  "author": "Mohammed AlBarshi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/albarshi996/warehouse-system/issues"
  },
  "homepage": "https://github.com/albarshi996/warehouse-system#readme",
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "astro": "^6.3.1",
    "firebase": "^12.12.1",
    "html2pdf.js": "^0.14.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^24.43.0"
  }
}
